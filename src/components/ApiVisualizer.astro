---
import { API_ENDPOINTS } from '../data/supen-data';
---

<div class="bg-white border border-slate-200/90 rounded-3xl p-6 sm:p-8 shadow-sm">
  <!-- Encabezado del Observatorio Visual -->
  <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 mb-6 pb-6 border-b border-slate-100">
    <div>
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-50 border border-blue-200 text-[#0A2540] text-xs font-bold mb-2">
        <span class="w-2 h-2 rounded-full bg-blue-600 animate-pulse"></span>
        <span>Observatorio Cuantitativo de la API Pública SUPEN</span>
        <span>•</span>
        <span class="font-mono">8 Endpoints Oficiales</span>
      </div>
      <h2 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight">
        Análisis Gráfico y Comportamiento de la API
      </h2>
      <p class="text-xs sm:text-sm text-slate-600 mt-1 max-w-2xl leading-relaxed">
        Visualizaciones dinámicas, comparativas de desempeño, curvas multi-horizonte, balances de movilidad bilateral, matrices de portafolio y pirámides demográficas del sistema previsional costarricense. Entre 3 y 5 visualizaciones por apartado.
      </p>
    </div>

    <!-- Badge de Estado y Botón Rápido a Comentarios -->
    <div class="flex flex-wrap items-center gap-2 text-xs self-start lg:self-auto">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-xl bg-slate-50 border border-slate-200 font-mono text-[11px] text-slate-700">
        <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
        <span>Endpoint:</span>
        <strong id="active-ep-badge" class="text-[#0A2540] font-bold">/rendimiento</strong>
      </div>

      <button
        id="btn-goto-comments"
        type="button"
        class="px-3 py-1.5 rounded-xl bg-amber-50 hover:bg-amber-100 border border-amber-200 text-amber-900 font-bold text-xs transition-colors flex items-center gap-1.5 shadow-xs"
        title="Abrir comentarios técnicos y análisis de este endpoint"
      >
        <span>📝</span>
        <span>Ver Comentarios de este Endpoint</span>
      </button>
    </div>
  </div>

  <!-- Barra de Selección de Endpoints de la API -->
  <div class="mb-6">
    <div class="flex items-center justify-between mb-2">
      <span class="text-xs font-bold text-slate-500 uppercase tracking-wider">Selecciona un apartado de la API:</span>
      <span class="text-[11px] text-slate-500 hidden sm:inline">Haz clic para cambiar de apartado</span>
    </div>
    <div class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-8 gap-2" id="endpoint-buttons-container">
      {API_ENDPOINTS.map((ep, idx) => (
        <button
          type="button"
          class={`ep-selector-btn px-2.5 py-2.5 rounded-xl border text-xs font-semibold text-left transition-all flex flex-col justify-between gap-1 group ${
            idx === 0
              ? 'bg-[#0A2540] border-[#0A2540] text-white shadow-sm ring-2 ring-blue-500/20'
              : 'bg-slate-50 border-slate-200 text-slate-700 hover:bg-slate-100 hover:border-slate-300'
          }`}
          data-endpoint-idx={idx}
        >
          <div class="flex items-center justify-between w-full">
            <span class="font-mono text-[11px] font-bold group-hover:underline truncate">{ep.endpoint}</span>
            <span class="text-[9px] px-1 py-0.2 rounded font-mono font-bold bg-white/20 text-current">GET</span>
          </div>
          <span class="text-[10px] font-sans font-medium line-clamp-1 opacity-90">{ep.nombre.split(' ')[0]}</span>
        </button>
      ))}
    </div>
  </div>

  <!-- Tarjeta Principal del Gráfico Interactivo -->
  <div class="bg-slate-50 border border-slate-200 rounded-3xl p-4 sm:p-6 space-y-5">
    <!-- Barra Superior de Controles y Metadatos del Endpoint Activo -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-4 border-b border-slate-200">
      <div>
        <div class="flex items-center gap-2">
          <span class="px-2 py-0.5 rounded-md bg-emerald-100 text-emerald-900 border border-emerald-300 font-mono font-bold text-xs">GET</span>
          <h3 id="chart-endpoint-title" class="text-lg font-black text-slate-900 font-mono tracking-tight">
            /rendimiento
          </h3>
          <span class="text-slate-400">•</span>
          <span id="chart-endpoint-name" class="text-xs sm:text-sm font-bold text-slate-700">
            Rentabilidades Oficiales (Valor Cuota)
          </span>
        </div>
        <p id="chart-endpoint-desc" class="text-xs text-slate-500 mt-1 max-w-2xl leading-relaxed">
          Comparativa de rentabilidad real vs. nominal entre las 6 operadoras (OPCs) autorizadas.
        </p>
      </div>

      <!-- Controles Dinámicos Específicos del Gráfico (Sub-vistas) -->
      <div id="chart-dynamic-controls" class="flex flex-wrap items-center gap-1.5">
        <!-- Rellenado dinámicamente por JavaScript con los botones de 3 a 5 gráficos -->
      </div>
    </div>

    <!-- Contenedor del Gráfico SVG con Posicionamiento Relativo para Tooltip -->
    <div class="relative bg-white border border-slate-200/90 rounded-2xl p-4 sm:p-6 shadow-xs overflow-hidden">
      <!-- Tooltip Flotante de Alta Precisión Fiduciaria -->
      <div
        id="chart-tooltip"
        class="absolute pointer-events-none opacity-0 transition-opacity duration-150 z-30 bg-[#061526]/95 backdrop-blur-md border border-slate-700 text-white p-3 rounded-xl shadow-xl text-xs max-w-xs"
        style="top: 20px; left: 20px;"
      >
        <div id="tooltip-title" class="font-bold text-white text-[13px] border-b border-slate-700 pb-1 mb-1.5 flex items-center justify-between gap-2">
          <span>Detalle</span>
        </div>
        <div id="tooltip-body" class="space-y-1 text-[11px] text-slate-300"></div>
      </div>

      <!-- Lienzo SVG Interactivo -->
      <div class="w-full overflow-x-auto">
        <svg
          id="main-chart-svg"
          viewBox="0 0 860 380"
          class="w-full h-auto min-w-[650px] select-none"
          preserveAspectRatio="xMidYMid meet"
          role="img"
          aria-label="Gráfico interactivo de la API de SUPEN"
        >
          <!-- Contenido generado por JavaScript -->
        </svg>
      </div>

      <!-- Leyenda Dinámica al Pie del Gráfico -->
      <div id="chart-legend" class="flex flex-wrap items-center justify-center gap-4 pt-4 mt-2 border-t border-slate-100 text-xs text-slate-600">
        <!-- Rellenado dinámicamente -->
      </div>
    </div>

    <!-- Tarjetas de Métricas Clave / KPIs del Apartado -->
    <div id="chart-kpis-grid" class="grid grid-cols-2 sm:grid-cols-4 gap-3">
      <!-- Rellenado dinámicamente -->
    </div>

    <!-- Resumen Metodológico y Cita Oficial -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-[11px] text-slate-500 pt-3 border-t border-slate-200">
      <div class="flex items-center gap-2">
        <svg class="w-4 h-4 text-slate-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span id="chart-methodology-note">
          Tasa geométrica anualizada neta de comisiones descontando variación del Índice de Precios al Consumidor (IPC).
        </span>
      </div>
      <div class="font-mono text-slate-600 font-medium shrink-0">
        <span>Fuente: SUPEN / Estadísticas API Oficial</span>
      </div>
    </div>

    <!-- Sección Desplegable de Datos Tabulares Accesibles (WCAG) -->
    <details class="group bg-white border border-slate-200/80 rounded-2xl p-4 text-xs">
      <summary class="cursor-pointer font-bold text-slate-700 hover:text-[#0A2540] flex items-center justify-between select-none">
        <span class="flex items-center gap-2">
          <span>📋</span>
          <span>Ver Tabla de Datos Estructurada (Accesibilidad y Lectores de Pantalla)</span>
        </span>
        <span class="text-slate-400 group-open:rotate-180 transition-transform">▼</span>
      </summary>
      <div class="mt-4 overflow-x-auto" id="chart-accessible-table-container">
        <!-- Rellenado dinámicamente -->
      </div>
    </details>
  </div>
</div>

<script>
  import {
    API_ENDPOINTS,
    RENTABILIDADES,
    HISTORICO_COMISIONES,
    PORTAFOLIO_MACRO,
    TITULOS_ISIN_DESTACADOS,
    MOVILIDAD_RESUMEN,
    DEMOGRAFIA_AFILIADOS,
    BENEFICIOS_RETIROS,
    OPERADORAS,
    KPI_SISTEMA
  } from '../data/supen-data';
  import {
    formatColones,
    formatDolares,
    formatNumero
  } from '../utils/formatters';

  let currentEndpointIdx = 0;

  // Estado interactivo con 3 a 5 vistas por apartado
  const state = {
    rendimiento: { horizonte: '12m', modo: 'comparativo' }, // 5: comparativo, lineas, spread, cuota, ranking
    comision: { vista: 'linea' },                           // 4: linea, simulacion, feedrag, costo
    portafolio: { vista: 'macro', unidad: 'crc' },          // 4: macro, moneda, instrumento, plazos
    portafolioISIN: { vista: 'tenencia', isinIdx: 0 },      // 4: tenencia, topEmisiones, cupones, participacion
    lt: { modo: 'divergente', metrica: 'colones' },         // 4: divergente, flujo, saldoMedio, rotacion
    afiliado: { vista: 'piramide' },                        // 4: piramide, formalidad, brecha, cuotaMercado
    beneficio: { vista: 'modalidades', metrica: 'beneficiarios' }, // 4: modalidades, dualidad, pensionMedia, evolucion
    cuenta: { vista: 'balance' }                            // 4: balance, evolucionNAV, composicion, aumOpcs
  };

  // Elementos DOM
  const svg = document.getElementById('main-chart-svg') as unknown as SVGSVGElement;
  const tooltip = document.getElementById('chart-tooltip') as HTMLElement;
  const tooltipTitle = document.getElementById('tooltip-title') as HTMLElement;
  const tooltipBody = document.getElementById('tooltip-body') as HTMLElement;
  const activeEpBadge = document.getElementById('active-ep-badge') as HTMLElement;
  const epTitle = document.getElementById('chart-endpoint-title') as HTMLElement;
  const epName = document.getElementById('chart-endpoint-name') as HTMLElement;
  const epDesc = document.getElementById('chart-endpoint-desc') as HTMLElement;
  const controlsContainer = document.getElementById('chart-dynamic-controls') as HTMLElement;
  const legendContainer = document.getElementById('chart-legend') as HTMLElement;
  const kpisGrid = document.getElementById('chart-kpis-grid') as HTMLElement;
  const methodologyNote = document.getElementById('chart-methodology-note') as HTMLElement;
  const tableContainer = document.getElementById('chart-accessible-table-container') as HTMLElement;
  const epButtons = document.querySelectorAll('.ep-selector-btn') as NodeListOf<HTMLButtonElement>;
  const btnGotoComments = document.getElementById('btn-goto-comments') as HTMLButtonElement;

  function showTooltip(evt: MouseEvent, titleText: string, rows: { label: string; value: string; color?: string }[]) {
    tooltipTitle.innerHTML = `<span>${titleText}</span>`;
    tooltipBody.innerHTML = rows.map(r => `
      <div class="flex items-center justify-between gap-3">
        <span class="flex items-center gap-1.5 text-slate-300">
          ${r.color ? `<span class="w-2 h-2 rounded-full inline-block" style="background-color: ${r.color}"></span>` : ''}
          ${r.label}
        </span>
        <strong class="font-mono text-white tabular-nums">${r.value}</strong>
      </div>
    `).join('');

    const rect = svg.getBoundingClientRect();
    const x = evt.clientX - rect.left + 15;
    const y = evt.clientY - rect.top - 10;

    tooltip.style.left = `${Math.min(Math.max(10, x), rect.width - 240)}px`;
    tooltip.style.top = `${Math.min(Math.max(10, y), rect.height - 120)}px`;
    tooltip.classList.remove('opacity-0');
    tooltip.classList.add('opacity-100');
  }

  function hideTooltip() {
    tooltip.classList.remove('opacity-100');
    tooltip.classList.add('opacity-0');
  }

  function getOpColor(opId: string): string {
    const op = OPERADORAS.find(o => o.id === opId || o.nombre === opId || o.nombreCorto === opId);
    return op ? op.colorHex : '#0284c7';
  }

  function getOpNombreCorto(opId: string): string {
    const op = OPERADORAS.find(o => o.id === opId || o.nombre === opId || o.nombreCorto === opId);
    return op ? op.nombreCorto : opId;
  }

  // ==========================================
  // RENDERER 0: /rendimiento (5 Gráficos)
  // 1. Barras Real vs Nominal
  // 2. Curvas Multi-Horizonte (12m a 10a)
  // 3. Spread de Inflación (IPC vs Tasa Real)
  // 4. Crecimiento Acumulado de Inversión 10 Años
  // 5. Dispersión Retorno vs Consistencia
  // ==========================================
  function renderRendimiento() {
    const { horizonte, modo } = state.rendimiento;

    controlsContainer.innerHTML = `
      <div class="inline-flex rounded-lg border border-slate-200 bg-white p-0.5 text-xs">
        <button type="button" class="ctrl-btn px-2 py-1 rounded-md font-bold transition-colors ${modo === 'comparativo' ? 'bg-[#0A2540] text-white' : 'text-slate-600'}" data-ctrl="modo" data-val="comparativo">Barras Real/Nominal</button>
        <button type="button" class="ctrl-btn px-2 py-1 rounded-md font-bold transition-colors ${modo === 'lineas' ? 'bg-[#0A2540] text-white' : 'text-slate-600'}" data-ctrl="modo" data-val="lineas">Curvas Horizontes</button>
        <button type="button" class="ctrl-btn px-2 py-1 rounded-md font-bold transition-colors ${modo === 'spread' ? 'bg-[#0A2540] text-white' : 'text-slate-600'}" data-ctrl="modo" data-val="spread">Spread Inflación</button>
        <button type="button" class="ctrl-btn px-2 py-1 rounded-md font-bold transition-colors ${modo === 'cuota' ? 'bg-[#0A2540] text-white' : 'text-slate-600'}" data-ctrl="modo" data-val="cuota">Crecimiento 10a</button>
        <button type="button" class="ctrl-btn px-2 py-1 rounded-md font-bold transition-colors ${modo === 'ranking' ? 'bg-[#0A2540] text-white' : 'text-slate-600'}" data-ctrl="modo" data-val="ranking">Consistencia 10a</button>
      </div>
      ${modo === 'comparativo' ? `
        <div class="inline-flex rounded-lg border border-slate-200 bg-white p-0.5 text-xs">
          ${['12m', '36m', '60m', '10a'].map(h => `
            <button type="button" class="ctrl-btn px-2 py-1 rounded-md font-bold transition-colors ${horizonte === h ? 'bg-blue-600 text-white' : 'text-slate-600'}" data-ctrl="horizonte" data-val="${h}">
              ${h === '10a' ? '10 Años' : h.toUpperCase()}
            </button>
          `).join('')}
        </div>
      ` : ''}
    `;

    const paddingX = 80;
    const paddingY = 40;
    const width = 860;
    const height = 380;
    const chartWidth = width - paddingX * 2;
    const chartHeight = height - paddingY * 2 - 20;

    let svgInner = '';

    if (modo === 'lineas') {
      methodologyNote.textContent = 'Trayectoria temporal de rentabilidad real anualizada a lo largo de los horizontes 12 meses, 36 meses, 60 meses y 10 años para las 6 operadoras.';
      const horizontes = ['12m', '36m', '60m', '10a'];
      const maxVal = 7.5;
      const minVal = 2.0;

      for (let v = 2.0; v <= 7.0; v += 1.0) {
        const y = height - paddingY - ((v - minVal) / (maxVal - minVal)) * chartHeight;
        svgInner += `
          <line x1="${paddingX}" y1="${y}" x2="${width - paddingX}" y2="${y}" stroke="#e2e8f0" stroke-width="1" stroke-dasharray="3,3" />
          <text x="${paddingX - 12}" y="${y + 4}" font-size="11" font-weight="600" fill="#64748b" text-anchor="end">${v.toFixed(1)}%</text>
        `;
      }

      horizontes.forEach((h, hIdx) => {
        const x = paddingX + (hIdx / (horizontes.length - 1)) * chartWidth;
        svgInner += `
          <line x1="${x}" y1="${paddingY}" x2="${x}" y2="${height - paddingY}" stroke="#e2e8f0" stroke-width="1" />
          <text x="${x}" y="${height - paddingY + 22}" font-size="11" font-weight="700" fill="#334155" text-anchor="middle">${h === '10a' ? '10 Años' : h.toUpperCase()}</text>
        `;
      });

      RENTABILIDADES.forEach((opc) => {
        const color = getOpColor(opc.operadoraId);
        const vals = [opc.rentabilidadReal12m, opc.rentabilidadReal36m, opc.rentabilidadReal60m, opc.rentabilidadReal10a];
        const points = vals.map((v, i) => {
          const x = paddingX + (i / (horizontes.length - 1)) * chartWidth;
          const y = height - paddingY - ((v - minVal) / (maxVal - minVal)) * chartHeight;
          return { x, y, val: v, h: horizontes[i] };
        });

        let pathD = `M ${points[0].x} ${points[0].y}`;
        for (let i = 1; i < points.length; i++) pathD += ` L ${points[i].x} ${points[i].y}`;

        svgInner += `<path d="${pathD}" fill="none" stroke="${color}" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" opacity="0.9" />`;

        points.forEach(p => {
          svgInner += `
            <circle
              class="chart-elem cursor-pointer transition-transform hover:scale-125"
              cx="${p.x}"
              cy="${p.y}"
              r="5"
              fill="${color}"
              stroke="#ffffff"
              stroke-width="2"
              data-tooltip-title="${opc.nombre} (${p.h})"
              data-tooltip-rows='[{"label":"Tasa Real","value":"${p.val.toFixed(2)}%","color":"${color}"},{"label":"Horizonte","value":"${p.h}"}]'
            />
          `;
        });
      });

      legendContainer.innerHTML = RENTABILIDADES.map(o => `
        <div class="flex items-center gap-1.5">
          <span class="w-3 h-3 rounded-full" style="background-color: ${getOpColor(o.operadoraId)}"></span>
          <span class="font-medium text-[11px]">${getOpNombreCorto(o.operadoraId)}</span>
        </div>
      `).join('');

    } else if (modo === 'spread') {
      methodologyNote.textContent = 'Spread inflacionario: Tasa Real neta descontando IPC (inflación promedio del periodo descontada por fórmula de Fisher).';
      const maxVal = 10;
      for (let v = 0; v <= 10; v += 2) {
        const y = height - paddingY - (v / maxVal) * chartHeight;
        svgInner += `
          <line x1="${paddingX}" y1="${y}" x2="${width - paddingX}" y2="${y}" stroke="#e2e8f0" stroke-width="1" stroke-dasharray="3,3" />
          <text x="${paddingX - 12}" y="${y + 4}" font-size="11" font-weight="600" fill="#64748b" text-anchor="end">${v}%</text>
        `;
      }

      const barGroupWidth = chartWidth / RENTABILIDADES.length;
      RENTABILIDADES.forEach((d, i) => {
        const groupX = paddingX + i * barGroupWidth;
        const opColor = getOpColor(d.operadoraId);
        const opNameShort = getOpNombreCorto(d.operadoraId);
        const barW = Math.min(42, barGroupWidth * 0.55);

        const hReal = (d.rentabilidadReal12m / maxVal) * chartHeight;
        const yReal = height - paddingY - hReal;
        const ipcEfecto = d.rentabilidadNominal12m - d.rentabilidadReal12m;
        const hIpc = (ipcEfecto / maxVal) * chartHeight;
        const yIpc = yReal - hIpc;

        svgInner += `
          <rect
            class="chart-elem cursor-pointer transition-all hover:opacity-85"
            x="${groupX + (barGroupWidth - barW)/2}"
            y="${yIpc}"
            width="${barW}"
            height="${hIpc}"
            fill="#cbd5e1"
            rx="3"
            data-tooltip-title="${d.nombre}"
            data-tooltip-rows='[{"label":"Efecto Inflación (IPC)","value":"-${ipcEfecto.toFixed(2)}%","color":"#94a3b8"},{"label":"Tasa Nominal Total","value":"${d.rentabilidadNominal12m.toFixed(2)}%"}]'
          />
          <rect
            class="chart-elem cursor-pointer transition-all hover:opacity-85"
            x="${groupX + (barGroupWidth - barW)/2}"
            y="${yReal}"
            width="${barW}"
            height="${hReal}"
            fill="${opColor}"
            rx="3"
            data-tooltip-title="${d.nombre}"
            data-tooltip-rows='[{"label":"Tasa Real","value":"+${d.rentabilidadReal12m.toFixed(2)}%","color":"${opColor}"}]'
          />
          <text x="${groupX + barGroupWidth/2}" y="${yIpc - 6}" font-size="10" font-weight="800" fill="#1e293b" text-anchor="middle">${d.rentabilidadNominal12m.toFixed(1)}%</text>
          <text x="${groupX + barGroupWidth/2}" y="${height - paddingY + 20}" font-size="11" font-weight="700" fill="#1e293b" text-anchor="middle">${opNameShort}</text>
        `;
      });

      legendContainer.innerHTML = `
        <div class="flex items-center gap-1.5"><span class="w-3.5 h-3.5 rounded bg-emerald-600 inline-block"></span><span class="font-medium">Rentabilidad Real Efectiva</span></div>
        <div class="flex items-center gap-1.5"><span class="w-3.5 h-3.5 rounded bg-slate-300 inline-block"></span><span class="font-medium">Efecto Inflación (IPC) Descontado</span></div>
      `;

    } else if (modo === 'cuota') {
      // Gráfico 4: Crecimiento compuesto a 10 años (Base ₡100.000)
      methodologyNote.textContent = 'Proyección de capital acumulado tras 10 años para un depósito único de ₡100.000 invertido a la tasa real 10a de cada operadora: C = ₡100k × (1 + r)^10.';
      const maxVal = 170000;
      const minVal = 90000;

      for (let v = 100000; v <= 160000; v += 20000) {
        const y = height - paddingY - ((v - minVal) / (maxVal - minVal)) * chartHeight;
        svgInner += `
          <line x1="${paddingX}" y1="${y}" x2="${width - paddingX}" y2="${y}" stroke="#e2e8f0" stroke-width="1" stroke-dasharray="3,3" />
          <text x="${paddingX - 12}" y="${y + 4}" font-size="11" font-weight="600" fill="#64748b" text-anchor="end">₡ ${(v / 1000).toFixed(0)}k</text>
        `;
      }

      const barGroupW = chartWidth / RENTABILIDADES.length;
      RENTABILIDADES.forEach((d, i) => {
        const groupX = paddingX + i * barGroupW;
        const opColor = getOpColor(d.operadoraId);
        const opNameShort = getOpNombreCorto(d.operadoraId);
        const barW = Math.min(42, barGroupW * 0.55);

        const r = d.rentabilidadReal10a / 100;
        const saldoFinal = Math.round(100000 * Math.pow(1 + r, 10));
        const ganancia = saldoFinal - 100000;

        const h = ((saldoFinal - minVal) / (maxVal - minVal)) * chartHeight;
        const y = height - paddingY - h;

        svgInner += `
          <rect
            class="chart-elem cursor-pointer transition-all hover:opacity-85"
            x="${groupX + (barGroupW - barW)/2}"
            y="${y}"
            width="${barW}"
            height="${h}"
            fill="${opColor}"
            rx="5"
            data-tooltip-title="${d.nombre} (10 Años)"
            data-tooltip-rows='[{"label":"Capital Final","value":"₡ ${formatNumero(saldoFinal)}","color":"${opColor}"},{"label":"Ganancia Real","value":"+₡ ${formatNumero(ganancia)}"},{"label":"Tasa 10a","value":"${d.rentabilidadReal10a.toFixed(2)}%"}]'
          />
