      legendContainer.innerHTML = `<div class="flex items-center gap-2"><span class="w-3.5 h-3.5 rounded bg-sky-600 inline-block"></span><span>Las 5 principales emisiones concentran más de ₡4.8 Billones de custodia</span></div>`;

    } else if (vista === 'cupones') {
      methodologyNote.textContent = 'Comparativa de tasas cupón y vencimientos: Los bonos locales en colones ofrecen cupones entre 7.4% y 9.2%, mientras que títulos en dólares rinden entre 4.8% y 7.1%.';
      const instrumentosCupon = [
        { isin: 'Bono BCCR 2028', plazoAños: 4, cuponPct: 7.45, moneda: 'CRC', color: '#f59e0b' },
        { isin: 'Hacienda 2030', plazoAños: 6, cuponPct: 8.20, moneda: 'CRC', color: '#0284c7' },
        { isin: 'Hacienda 2032', plazoAños: 8, cuponPct: 8.75, moneda: 'CRC', color: '#0369a1' },
        { isin: 'Hacienda 2040', plazoAños: 16, cuponPct: 9.25, moneda: 'CRC', color: '#0c4a6e' },
        { isin: 'Eurobono USD 2031', plazoAños: 7, cuponPct: 6.12, moneda: 'USD', color: '#10b981' },
        { isin: 'Eurobono USD 2044', plazoAños: 20, cuponPct: 7.15, moneda: 'USD', color: '#059669' }
      ];

      for (let v = 4; v <= 10; v += 2) {
        const y = height - paddingY - ((v - 4) / 6) * chartHeight;
        svgInner += `
          <line x1="${paddingX}" y1="${y}" x2="${width - paddingX}" y2="${y}" stroke="#e2e8f0" stroke-width="1" stroke-dasharray="3,3" />
          <text x="${paddingX - 15}" y="${y + 4}" font-size="11" font-weight="600" fill="#64748b" text-anchor="end">${v}%</text>
        `;
      }

      const barGroupW = chartWidth / instrumentosCupon.length;
      instrumentosCupon.forEach((c, idx) => {
        const groupX = paddingX + idx * barGroupW;
        const barW = Math.min(45, barGroupW * 0.6);
        const h = ((c.cuponPct - 4) / 6) * chartHeight;
        const y = height - paddingY - h;

        svgInner += `
          <rect
            class="chart-elem cursor-pointer transition-all hover:opacity-85"
            x="${groupX + (barGroupW - barW)/2}"
            y="${y}"
            width="${barW}"
            height="${h}"
            fill="${c.color}"
            rx="5"
            data-tooltip-title="${c.isin}"
            data-tooltip-rows='[{"label":"Tasa Cupón","value":"${c.cuponPct.toFixed(2)}%","color":"${c.color}"},{"label":"Maduración","value":"A ${c.plazoAños} años"},{"label":"Moneda","value":"${c.moneda}"}]'
          />
          <text x="${groupX + barGroupW/2}" y="${y - 8}" font-size="11" font-weight="800" fill="${c.color}" text-anchor="middle">${c.cuponPct.toFixed(2)}%</text>
          <text x="${groupX + barGroupW/2}" y="${height - paddingY + 20}" font-size="10" font-weight="700" fill="#1e293b" text-anchor="middle">${c.isin.split(' ')[0]}</text>
          <text x="${groupX + barGroupW/2}" y="${height - paddingY + 34}" font-size="9" font-weight="500" fill="#64748b" text-anchor="middle">${c.isin.split(' ').slice(1).join(' ')}</text>
        `;
      });

      legendContainer.innerHTML = `
        <div class="flex items-center gap-1.5"><span class="w-3.5 h-3.5 rounded bg-sky-700 inline-block"></span><span class="font-medium">Emisiones Locales en Colones (7.45% - 9.25%)</span></div>
        <div class="flex items-center gap-1.5"><span class="w-3.5 h-3.5 rounded bg-emerald-600 inline-block"></span><span class="font-medium">Eurobonos en USD (6.12% - 7.15%)</span></div>
      `;

    } else if (vista === 'participacion') {
      methodologyNote.textContent = 'Porcentaje del saldo total emitido que se encuentra en custodia del régimen ROP para emisiones soberanas del Ministerio de Hacienda.';
      const cuotas = [
        { emision: 'Hacienda 2032 CRC', pctRop: 43.5, saldoTotal: '₡3.33 B', color: '#0284c7' },
        { emision: 'Hacienda 2040 CRC', pctRop: 39.8, saldoTotal: '₡2.96 B', color: '#0369a1' },
        { emision: 'Hacienda 2030 CRC', pctRop: 36.2, saldoTotal: '₡2.10 B', color: '#0284c7' },
        { emision: 'Bono BCCR 2028 CRC', pctRop: 28.5, saldoTotal: '₡2.28 B', color: '#f59e0b' },
        { emision: 'Eurobono 2031 USD', pctRop: 16.4, saldoTotal: '$1.50 B', color: '#10b981' }
      ];

      for (let v = 0; v <= 50; v += 10) {
        const y = height - paddingY - (v / 50) * chartHeight;
        svgInner += `
          <line x1="${paddingX}" y1="${y}" x2="${width - paddingX}" y2="${y}" stroke="#e2e8f0" stroke-width="1" stroke-dasharray="3,3" />
          <text x="${paddingX - 15}" y="${y + 4}" font-size="11" font-weight="600" fill="#64748b" text-anchor="end">${v}%</text>
        `;
      }

      const barGroupW = chartWidth / cuotas.length;
      cuotas.forEach((c, idx) => {
        const groupX = paddingX + idx * barGroupW;
        const barW = Math.min(50, barGroupW * 0.6);
        const h = (c.pctRop / 50) * chartHeight;
        const y = height - paddingY - h;

        svgInner += `
          <rect
            class="chart-elem cursor-pointer transition-all hover:opacity-85"
            x="${groupX + (barGroupW - barW)/2}"
            y="${y}"
            width="${barW}"
            height="${h}"
            fill="${c.color}"
            rx="5"
            data-tooltip-title="${c.emision}"
            data-tooltip-rows='[{"label":"Participación ROP","value":"${c.pctRop.toFixed(1)}%","color":"${c.color}"},{"label":"Saldo Total Emitido","value":"${c.saldoTotal}"}]'
          />
          <text x="${groupX + barGroupW/2}" y="${y - 8}" font-size="11" font-weight="800" fill="${c.color}" text-anchor="middle">${c.pctRop.toFixed(1)}%</text>
          <text x="${groupX + barGroupW/2}" y="${height - paddingY + 20}" font-size="11" font-weight="700" fill="#1e293b" text-anchor="middle">${c.emision.split(' ')[0]}</text>
          <text x="${groupX + barGroupW/2}" y="${height - paddingY + 34}" font-size="9" font-weight="500" fill="#64748b" text-anchor="middle">${c.emision.split(' ').slice(1, 3).join(' ')}</text>
        `;
      });

      legendContainer.innerHTML = `<div class="flex items-center gap-2"><span class="w-3.5 h-3.5 rounded bg-sky-700 inline-block"></span><span>El ROP es el mayor tenedor de deuda soberana de Costa Rica (>40% en emisiones clave)</span></div>`;

    } else {
      // Tenencia por Operadora del Título Activo
      methodologyNote.textContent = `Título: ${titulo.descripcion} (${titulo.isin}) · Emisor: ${titulo.emisor} · Tasa: ${titulo.tasaInteres}`;
      const opcKeys = Object.keys(titulo.tenenciasOpcs);
      const opcValues = Object.values(titulo.tenenciasOpcs);
      const maxVal = Math.max(...opcValues) * 1.15;

      for (let i = 0; i <= 4; i++) {
        const v = (maxVal / 4) * i;
        const y = height - paddingY - (i / 4) * chartHeight;
        svgInner += `
          <line x1="${paddingX}" y1="${y}" x2="${width - paddingX}" y2="${y}" stroke="#e2e8f0" stroke-width="1" stroke-dasharray="3,3" />
          <text x="${paddingX - 15}" y="${y + 4}" font-size="11" font-weight="600" fill="#64748b" text-anchor="end">₡ ${(v / 1_000_000_000).toFixed(0)} B</text>
        `;
      }

      const barGroupW = chartWidth / opcKeys.length;
      opcKeys.forEach((key, idx) => {
        const monto = titulo.tenenciasOpcs[key];
        const opColor = getOpColor(key);
        const opNameShort = getOpNombreCorto(key);
        const barW = Math.min(48, barGroupW * 0.65);
        const h = (monto / maxVal) * chartHeight;
        const y = height - paddingY - h;

        svgInner += `
          <rect
            class="chart-elem cursor-pointer transition-all duration-300 hover:opacity-85"
            x="${paddingX + idx * barGroupW + (barGroupW - barW)/2}"
            y="${y}"
            width="${barW}"
            height="${h}"
            fill="${opColor}"
            rx="5"
            data-tooltip-title="${opNameShort}"
            data-tooltip-rows='[{"label":"Tenencia Título","value":"${formatColones(monto, true)}","color":"${opColor}"},{"label":"Cuota en este título","value":"${((monto / titulo.montoTotalCRC) * 100).toFixed(1)}%"}]'
          />
          <text x="${paddingX + idx * barGroupW + barGroupW/2}" y="${y - 8}" font-size="10" font-weight="800" fill="${opColor}" text-anchor="middle">₡ ${(monto / 1_000_000_000).toFixed(1)}B</text>
          <text x="${paddingX + idx * barGroupW + barGroupW/2}" y="${height - paddingY + 20}" font-size="11" font-weight="700" fill="#1e293b" text-anchor="middle">${opNameShort}</text>
        `;
      });

      legendContainer.innerHTML = `
        <div class="flex items-center gap-2">
          <span class="font-bold text-slate-800">ISIN:</span>
          <code class="px-2 py-0.5 rounded bg-slate-100 font-mono text-blue-900 font-bold">${titulo.isin}</code>
        </div>
        <div><span>Sector: <strong>${titulo.sector}</strong></span></div>
        <div><span>Vencimiento: <strong>${titulo.vencimiento}</strong></span></div>
        <div><span>Monto Total Custodiado: <strong>${formatColones(titulo.montoTotalCRC, true)}</strong></span></div>
      `;
    }

    svg.innerHTML = svgInner;

    kpisGrid.innerHTML = `
      <div class="bg-white border border-slate-200 p-3.5 rounded-2xl shadow-xs">
        <span class="text-[10px] font-bold text-slate-500 uppercase tracking-wider block">Código ISIN</span>
        <strong class="text-xs sm:text-sm font-black text-blue-900 font-mono">${titulo.isin}</strong>
        <span class="text-[11px] text-slate-500 block truncate">${titulo.emisor}</span>
      </div>
      <div class="bg-white border border-slate-200 p-3.5 rounded-2xl shadow-xs">
        <span class="text-[10px] font-bold text-slate-500 uppercase tracking-wider block">Monto Total Custodiado</span>
        <strong class="text-base sm:text-lg font-black text-[#0A2540]">${formatColones(titulo.montoTotalCRC, true)}</strong>
        <span class="text-[11px] text-slate-500 block">${formatDolares(titulo.montoTotalUSD, true)}</span>
      </div>
      <div class="bg-white border border-slate-200 p-3.5 rounded-2xl shadow-xs">
        <span class="text-[10px] font-bold text-slate-500 uppercase tracking-wider block">Instrumento</span>
        <strong class="text-xs sm:text-sm font-black text-slate-800">${titulo.tipoInstrumento}</strong>
        <span class="text-[11px] text-slate-500 block">${titulo.tasaInteres}</span>
      </div>
      <div class="bg-white border border-slate-200 p-3.5 rounded-2xl shadow-xs">
        <span class="text-[10px] font-bold text-slate-500 uppercase tracking-wider block">Moneda / Vencimiento</span>
        <strong class="text-base sm:text-lg font-black text-emerald-800">${titulo.moneda}</strong>
        <span class="text-[11px] text-slate-500 block">${titulo.vencimiento}</span>
      </div>
    `;

    const opcKeys = Object.keys(titulo.tenenciasOpcs);
    tableContainer.innerHTML = `
      <table class="w-full text-left font-mono text-[11px]">
        <thead>
          <tr class="border-b border-slate-200 text-slate-600 font-sans font-bold">
            <th class="py-2 px-3">Operadora (OPC)</th>
            <th class="py-2 px-3">Tenencia en Colones</th>
            <th class="py-2 px-3">% de Participación en el Título</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          ${opcKeys.map(k => `
            <tr>
              <td class="py-2 px-3 font-sans font-bold text-slate-900">${getOpNombreCorto(k)}</td>
              <td class="py-2 px-3 text-[#0A2540] font-bold">${formatColones(titulo.tenenciasOpcs[k], true)}</td>
              <td class="py-2 px-3 text-emerald-800 font-bold">${((titulo.tenenciasOpcs[k] / titulo.montoTotalCRC) * 100).toFixed(2)}%</td>
            </tr>
          `).join('')}
        </tbody>
      </table>
    `;
  }

  // ==========================================
  // RENDERER 4: /LT (4 Gráficos)
  // 1. Saldo Neto Divergente
  // 2. Flujo Bruto (Entradas vs Salidas)
  // 3. Saldo Promedio por Afiliado Trasladado
  // 4. Tasa de Rotación Neta (Churn Relativo)
  // ==========================================
  function renderLT() {
    const { modo, metrica } = state.lt;

    controlsContainer.innerHTML = `
      <div class="inline-flex rounded-lg border border-slate-200 bg-white p-0.5 text-xs">
        <button type="button" class="ctrl-btn px-2.5 py-1 rounded-md font-bold transition-colors ${modo === 'divergente' ? 'bg-[#0A2540] text-white' : 'text-slate-600'}" data-ctrl="ltModo" data-val="divergente">Saldo Neto Divergente</button>
        <button type="button" class="ctrl-btn px-2.5 py-1 rounded-md font-bold transition-colors ${modo === 'flujo' ? 'bg-[#0A2540] text-white' : 'text-slate-600'}" data-ctrl="ltModo" data-val="flujo">Flujo Bruto (In/Out)</button>
        <button type="button" class="ctrl-btn px-2.5 py-1 rounded-md font-bold transition-colors ${modo === 'saldoMedio' ? 'bg-[#0A2540] text-white' : 'text-slate-600'}" data-ctrl="ltModo" data-val="saldoMedio">Saldo Promedio Cuenta</button>
        <button type="button" class="ctrl-btn px-2.5 py-1 rounded-md font-bold transition-colors ${modo === 'rotacion' ? 'bg-[#0A2540] text-white' : 'text-slate-600'}" data-ctrl="ltModo" data-val="rotacion">Tasa de Movilidad (%)</button>
      </div>
      ${modo === 'divergente' || modo === 'flujo' ? `
        <div class="inline-flex rounded-lg border border-slate-200 bg-white p-0.5 text-xs">
          <button type="button" class="ctrl-btn px-2 py-1 rounded-md font-bold transition-colors ${metrica === 'colones' ? 'bg-blue-600 text-white' : 'text-slate-600'}" data-ctrl="ltMetrica" data-val="colones">Colones (₡)</button>
          <button type="button" class="ctrl-btn px-2 py-1 rounded-md font-bold transition-colors ${metrica === 'personas' ? 'bg-blue-600 text-white' : 'text-slate-600'}" data-ctrl="ltMetrica" data-val="personas">Personas</button>
        </div>
      ` : ''}
    `;

    const paddingX = 120;
    const paddingY = 40;
    const width = 860;
    const height = 380;
    const chartWidth = width - paddingX * 2;
    const chartHeight = height - paddingY * 2 - 20;

    let svgInner = '';

    if (modo === 'flujo') {
      methodologyNote.textContent = 'Rotación bruta de traslados: Comparativa de volumen total recibido (Entradas) frente al volumen cedido (Salidas) para cada operadora.';
      const maxVal = metrica === 'colones' ? 30000000000 : 8000;
      for (let i = 0; i <= 4; i++) {
        const v = (maxVal / 4) * i;
        const y = height - paddingY - (i / 4) * chartHeight;
        const lbl = metrica === 'colones' ? `₡ ${(v / 1_000_000_000).toFixed(0)} B` : `${formatNumero(v)}`;
        svgInner += `
          <line x1="${paddingX - 20}" y1="${y}" x2="${width - paddingX}" y2="${y}" stroke="#e2e8f0" stroke-width="1" stroke-dasharray="3,3" />
          <text x="${paddingX - 26}" y="${y + 4}" font-size="11" font-weight="600" fill="#64748b" text-anchor="end">${lbl}</text>
        `;
      }

      const barGroupW = chartWidth / MOVILIDAD_RESUMEN.length;
      MOVILIDAD_RESUMEN.forEach((m, idx) => {
        const groupX = paddingX - 10 + idx * barGroupW;
        const barW = Math.min(26, barGroupW * 0.38);

        const vIn = metrica === 'colones' ? m.entradasMontoCRC : m.entradasPersonas;
        const vOut = metrica === 'colones' ? m.salidasMontoCRC : m.salidasPersonas;

        const hIn = (vIn / maxVal) * chartHeight;
        const yIn = height - paddingY - hIn;
        const hOut = (vOut / maxVal) * chartHeight;
        const yOut = height - paddingY - hOut;

        svgInner += `
          <rect
            class="chart-elem cursor-pointer transition-all hover:opacity-85"
            x="${groupX + barGroupW/2 - barW - 2}"
            y="${yIn}"
            width="${barW}"
            height="${hIn}"
            fill="#10b981"
            rx="4"
            data-tooltip-title="${m.nombre} (Entradas)"
            data-tooltip-rows='[{"label":"Entradas","value":"${metrica === 'colones' ? formatColones(m.entradasMontoCRC, true) : formatNumero(m.entradasPersonas)}","color":"#10b981"}]'
          />
          <rect
            class="chart-elem cursor-pointer transition-all hover:opacity-85"
            x="${groupX + barGroupW/2 + 2}"
            y="${yOut}"
            width="${barW}"
            height="${hOut}"
            fill="#f43f5e"
            rx="4"
            data-tooltip-title="${m.nombre} (Salidas)"
            data-tooltip-rows='[{"label":"Salidas","value":"${metrica === 'colones' ? formatColones(m.salidasMontoCRC, true) : formatNumero(m.salidasPersonas)}","color":"#f43f5e"}]'
          />
          <text x="${groupX + barGroupW/2 - barW/2 - 2}" y="${yIn - 6}" font-size="9" font-weight="700" fill="#047857" text-anchor="middle">
            ${metrica === 'colones' ? `₡${(vIn/1e9).toFixed(1)}B` : formatNumero(vIn)}
          </text>
          <text x="${groupX + barGroupW/2 + barW/2 + 2}" y="${yOut - 6}" font-size="9" font-weight="700" fill="#e11d48" text-anchor="middle">
            ${metrica === 'colones' ? `₡${(vOut/1e9).toFixed(1)}B` : formatNumero(vOut)}
          </text>
          <text x="${groupX + barGroupW/2}" y="${height - paddingY + 20}" font-size="11" font-weight="700" fill="#1e293b" text-anchor="middle">
            ${getOpNombreCorto(m.operadoraId)}
          </text>
        `;
      });

      legendContainer.innerHTML = `
        <div class="flex items-center gap-2"><span class="w-3.5 h-3.5 rounded bg-emerald-500 inline-block"></span><span class="font-medium">Entradas Brutas (Capital o Afiliados Ganados)</span></div>
        <div class="flex items-center gap-2"><span class="w-3.5 h-3.5 rounded bg-rose-500 inline-block"></span><span class="font-medium">Salidas Brutas (Capital o Afiliados Cedidos)</span></div>
      `;

    } else if (modo === 'saldoMedio') {
      methodologyNote.textContent = 'Saldo promedio por afiliado trasladado: Revela el perfil socioeconómico de la cartera atraída. Las operadoras privadas suelen captar cuentas de mayor patrimonio promedio.';
      const saldosMedios = [
        { opc: 'BAC', saldoMedio: 16800000, color: '#dc2626' },
        { opc: 'Vida Plena', saldoMedio: 14500000, color: '#d97706' },
        { opc: 'BN Vital', saldoMedio: 10200000, color: '#16a34a' },
        { opc: 'BCR', saldoMedio: 9800000, color: '#2563eb' },
        { opc: 'Popular', saldoMedio: 8900000, color: '#0284c7' },
        { opc: 'CCSS', saldoMedio: 7900000, color: '#0d9488' }
      ];

      const maxVal = 20000000;
      for (let v = 0; v <= 20000000; v += 5000000) {
        const y = height - paddingY - (v / maxVal) * chartHeight;
        svgInner += `
          <line x1="${paddingX - 20}" y1="${y}" x2="${width - paddingX}" y2="${y}" stroke="#e2e8f0" stroke-width="1" stroke-dasharray="3,3" />
          <text x="${paddingX - 26}" y="${y + 4}" font-size="11" font-weight="600" fill="#64748b" text-anchor="end">₡ ${(v / 1_000_000).toFixed(0)} M</text>
        `;
      }

      const barGroupW = chartWidth / saldosMedios.length;
      saldosMedios.forEach((s, idx) => {
        const groupX = paddingX - 10 + idx * barGroupW;
        const barW = Math.min(48, barGroupW * 0.6);
        const h = (s.saldoMedio / maxVal) * chartHeight;
        const y = height - paddingY - h;

        svgInner += `
          <rect
            class="chart-elem cursor-pointer transition-all hover:opacity-85"
            x="${groupX + (barGroupW - barW)/2}"
            y="${y}"
            width="${barW}"
            height="${h}"
            fill="${s.color}"
            rx="5"
            data-tooltip-title="${s.opc} (Saldo Medio)"
            data-tooltip-rows='[{"label":"Saldo Promedio Cuenta","value":"${formatColones(s.saldoMedio, true)}","color":"${s.color}"},{"label":"Perfil","value":"Masa salarial captada"}]'
          />
          <text x="${groupX + barGroupW/2}" y="${y - 8}" font-size="11" font-weight="800" fill="${s.color}" text-anchor="middle">₡ ${(s.saldoMedio / 1_000_000).toFixed(1)}M</text>
          <text x="${groupX + barGroupW/2}" y="${height - paddingY + 20}" font-size="11" font-weight="700" fill="#1e293b" text-anchor="middle">${s.opc}</text>
        `;
      });

      legendContainer.innerHTML = `<div class="flex items-center gap-2"><span class="w-3.5 h-3.5 rounded bg-rose-600 inline-block"></span><span>BAC y Vida Plena captan las cuentas de mayor saldo acumulado promedio</span></div>`;

    } else if (modo === 'rotacion') {
      methodologyNote.textContent = 'Tasa de movilidad neta (% de variación de la base de afiliados derivado de solicitudes de libre transferencia en el mes).';
      const rotaciones = [
        { opc: 'BAC', tasa: 0.85, positivo: true, color: '#10b981' },
        { opc: 'Vida Plena', tasa: 0.32, positivo: true, color: '#10b981' },
        { opc: 'CCSS', tasa: 0.12, positivo: true, color: '#10b981' },
        { opc: 'BCR', tasa: -0.18, positivo: false, color: '#f43f5e' },
        { opc: 'BN Vital', tasa: -0.42, positivo: false, color: '#f43f5e' },
        { opc: 'Popular', tasa: -0.65, positivo: false, color: '#f43f5e' }
      ];

      const zeroY = height / 2;
      svgInner += `<line x1="${paddingX - 20}" y1="${zeroY}" x2="${width - paddingX}" y2="${zeroY}" stroke="#64748b" stroke-width="1.5" />`;

      const barGroupW = chartWidth / rotaciones.length;
      rotaciones.forEach((r, idx) => {
        const groupX = paddingX - 10 + idx * barGroupW;
        const barW = Math.min(46, barGroupW * 0.58);
        const h = (Math.abs(r.tasa) / 1.0) * (chartHeight / 2);
        const y = r.positivo ? zeroY - h : zeroY;

        svgInner += `
          <rect
            class="chart-elem cursor-pointer transition-all hover:opacity-85"
            x="${groupX + (barGroupW - barW)/2}"
            y="${y}"
            width="${barW}"
            height="${h}"
            fill="${r.color}"
            rx="4"
            data-tooltip-title="${r.opc} (Tasa Rotación)"
            data-tooltip-rows='[{"label":"Tasa Neta","value":"${r.positivo ? '+' : ''}${r.tasa.toFixed(2)}%","color":"${r.color}"}]'
          />
          <text x="${groupX + barGroupW/2}" y="${r.positivo ? y - 8 : y + h + 15}" font-size="11" font-weight="800" fill="${r.color}" text-anchor="middle">
            ${r.positivo ? '+' : ''}${r.tasa.toFixed(2)}%
          </text>
          <text x="${groupX + barGroupW/2}" y="${height - paddingY + 20}" font-size="11" font-weight="700" fill="#1e293b" text-anchor="middle">${r.opc}</text>
        `;
      });

      legendContainer.innerHTML = `
        <div class="flex items-center gap-1.5"><span class="w-3.5 h-3.5 rounded bg-emerald-500 inline-block"></span><span class="font-medium">Ganancia Neta Relativa</span></div>
        <div class="flex items-center gap-1.5"><span class="w-3.5 h-3.5 rounded bg-rose-500 inline-block"></span><span class="font-medium">Pérdida Neta Relativa</span></div>
      `;

    } else {
      // Divergente
      methodologyNote.textContent = 'Saldo neto mensual de Libre Transferencia (traslados entre operadoras): Las entidades a la derecha presentan saldo neto positivo (captación neta), mientras que a la izquierda sufren fuga neta.';
      const zeroX = paddingX + chartWidth / 2;
      svgInner += `
        <line x1="${zeroX}" y1="${paddingY - 10}" x2="${zeroX}" y2="${height - paddingY + 10}" stroke="#94a3b8" stroke-width="2" />
        <text x="${zeroX}" y="${paddingY - 16}" font-size="11" font-weight="700" fill="#64748b" text-anchor="middle">Equilibrio Cero</text>
      `;

      const maxVal = metrica === 'colones' ? 25000000000 : 6000;
      const barH = 34;
      const gap = 16;
      const startY = 40;

      MOVILIDAD_RESUMEN.forEach((d, idx) => {
        const y = startY + idx * (barH + gap);
        const val = metrica === 'colones' ? d.saldoNetoMontoCRC : d.saldoNetoPersonas;
        const isPositive = val >= 0;
        const barLen = (Math.abs(val) / maxVal) * (chartWidth / 2);
        const barX = isPositive ? zeroX : zeroX - barLen;
        const color = isPositive ? '#10b981' : '#f43f5e';
        const labelText = metrica === 'colones' ? formatColones(val, true) : `${formatNumero(val)} pers.`;

        svgInner += `
          <text x="${paddingX - 15}" y="${y + barH/2 + 4}" font-size="11" font-weight="700" fill="#1e293b" text-anchor="end">
            ${getOpNombreCorto(d.operadoraId)}
          </text>
          <rect
            class="chart-elem cursor-pointer transition-all duration-300 hover:opacity-85"
            x="${barX}"
            y="${y}"
            width="${barLen}"
            height="${barH}"
            fill="${color}"
            rx="4"
            data-tooltip-title="${d.nombre}"
            data-tooltip-rows='[{"label":"Saldo Neto","value":"${labelText}","color":"${color}"},{"label":"Entradas","value":"${metrica === 'colones' ? formatColones(d.entradasMontoCRC, true) : formatNumero(d.entradasPersonas)}"},{"label":"Salidas","value":"${metrica === 'colones' ? formatColones(d.salidasMontoCRC, true) : formatNumero(d.salidasPersonas)}"}]'
          />
          <text
            x="${isPositive ? barX + barLen + 8 : barX - 8}"
            y="${y + barH/2 + 4}"
            font-size="11"
            font-weight="800"
            fill="${color}"
            text-anchor="${isPositive ? 'start' : 'end'}"
          >
            ${isPositive ? '+' : ''}${labelText}
          </text>
        `;
      });

      legendContainer.innerHTML = `
        <div class="flex items-center gap-2"><span class="w-3.5 h-3.5 rounded bg-emerald-500 inline-block"></span><span class="font-medium">Saldo Positivo (Mayor captación de afiliados y capital)</span></div>
        <div class="flex items-center gap-2"><span class="w-3.5 h-3.5 rounded bg-rose-500 inline-block"></span><span class="font-medium">Saldo Negativo (Fuga neta de afiliados)</span></div>
      `;
    }

    svg.innerHTML = svgInner;

    const maxGanador = MOVILIDAD_RESUMEN.find(d => d.saldoNetoPersonas > 2000) || MOVILIDAD_RESUMEN[0];
    const maxPerdedor = MOVILIDAD_RESUMEN.find(d => d.saldoNetoPersonas < -2000) || MOVILIDAD_RESUMEN[MOVILIDAD_RESUMEN.length - 1];
    kpisGrid.innerHTML = `
      <div class="bg-white border border-slate-200 p-3.5 rounded-2xl shadow-xs">
        <span class="text-[10px] font-bold text-slate-500 uppercase tracking-wider block">Mayor Captador Neto</span>
        <strong class="text-base sm:text-lg font-black text-emerald-700">${maxGanador.nombre}</strong>
        <span class="text-[11px] text-slate-500 block">+${formatColones(maxGanador.saldoNetoMontoCRC, true)}</span>
      </div>
      <div class="bg-white border border-slate-200 p-3.5 rounded-2xl shadow-xs">
        <span class="text-[10px] font-bold text-slate-500 uppercase tracking-wider block">Mayor Salida Neta</span>
        <strong class="text-base sm:text-lg font-black text-rose-700">${maxPerdedor.nombre}</strong>
        <span class="text-[11px] text-slate-500 block">${formatColones(maxPerdedor.saldoNetoMontoCRC, true)}</span>
      </div>
      <div class="bg-white border border-slate-200 p-3.5 rounded-2xl shadow-xs">
        <span class="text-[10px] font-bold text-slate-500 uppercase tracking-wider block">Volumen Trasladado</span>
        <strong class="text-base sm:text-lg font-black text-[#0A2540]">₡ 61.9 Mil M</strong>
        <span class="text-[11px] text-slate-500 block">Flujo mensual total</span>
      </div>
      <div class="bg-white border border-slate-200 p-3.5 rounded-2xl shadow-xs">
        <span class="text-[10px] font-bold text-slate-500 uppercase tracking-wider block">Regla de Permanencia</span>
        <strong class="text-base sm:text-lg font-black text-blue-900">6 Meses</strong>
        <span class="text-[11px] text-slate-500 block">Derecho legal gratuito</span>
      </div>
    `;

    tableContainer.innerHTML = `
      <table class="w-full text-left font-mono text-[11px]">
        <thead>
          <tr class="border-b border-slate-200 text-slate-600 font-sans font-bold">
            <th class="py-2 px-3">Operadora (OPC)</th>
            <th class="py-2 px-3">Entradas (Personas)</th>
            <th class="py-2 px-3">Salidas (Personas)</th>
            <th class="py-2 px-3">Saldo Neto Personas</th>
            <th class="py-2 px-3">Saldo Neto en Colones</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          ${MOVILIDAD_RESUMEN.map(d => `
            <tr>
              <td class="py-2 px-3 font-sans font-bold text-slate-900">${d.nombre}</td>
              <td class="py-2 px-3">${formatNumero(d.entradasPersonas)}</td>
              <td class="py-2 px-3">${formatNumero(d.salidasPersonas)}</td>
              <td class="py-2 px-3 font-bold ${d.saldoNetoPersonas >= 0 ? 'text-emerald-700' : 'text-rose-700'}">${d.saldoNetoPersonas >= 0 ? '+' : ''}${formatNumero(d.saldoNetoPersonas)}</td>
              <td class="py-2 px-3 font-bold ${d.saldoNetoMontoCRC >= 0 ? 'text-emerald-700' : 'text-rose-700'}">${d.saldoNetoMontoCRC >= 0 ? '+' : ''}${formatColones(d.saldoNetoMontoCRC, true)}</td>
            </tr>
          `).join('')}
        </tbody>
      </table>
    `;
  }

  // ==========================================
  // RENDERER 5: /Afiliado (4 Gráficos)
  // 1. Pirámide Demográfica Laboral (Hombres vs Mujeres)
  // 2. Brecha de Formalidad (Afiliados vs Cotizantes SICERE)
  // 3. Brecha Salarial de Género
  // 4. Cuota de Mercado de Afiliados por Operadora
  // ==========================================
  function renderAfiliado() {
    const { vista } = state.afiliado;

    controlsContainer.innerHTML = `
      <div class="inline-flex rounded-lg border border-slate-200 bg-white p-0.5 text-xs">
        <button type="button" class="ctrl-btn px-2.5 py-1 rounded-md font-bold transition-colors ${vista === 'piramide' ? 'bg-[#0A2540] text-white' : 'text-slate-600'}" data-ctrl="afiliadoVista" data-val="piramide">Pirámide Hombres/Mujeres</button>
        <button type="button" class="ctrl-btn px-2.5 py-1 rounded-md font-bold transition-colors ${vista === 'formalidad' ? 'bg-[#0A2540] text-white' : 'text-slate-600'}" data-ctrl="afiliadoVista" data-val="formalidad">Densidad Cotización</button>
        <button type="button" class="ctrl-btn px-2.5 py-1 rounded-md font-bold transition-colors ${vista === 'brecha' ? 'bg-[#0A2540] text-white' : 'text-slate-600'}" data-ctrl="afiliadoVista" data-val="brecha">Brecha Salarial Género</button>
        <button type="button" class="ctrl-btn px-2.5 py-1 rounded-md font-bold transition-colors ${vista === 'cuotaMercado' ? 'bg-[#0A2540] text-white' : 'text-slate-600'}" data-ctrl="afiliadoVista" data-val="cuotaMercado">Cuota Mercado OPCs</button>
      </div>
    `;

    const paddingX = 90;
    const paddingY = 40;
    const width = 860;
    const height = 380;
    const chartWidth = width - paddingX * 2;
    const chartHeight = height - paddingY * 2 - 20;

    let svgInner = '';

    if (vista === 'formalidad') {
      methodologyNote.textContent = 'Brecha de formalidad laboral: Comparativa entre afiliados registrados en el fondo y cotizantes efectivos reportados en la planilla SICERE del mes en curso.';
      const maxVal = 1300000;
      for (let i = 0; i <= 4; i++) {
        const v = (maxVal / 4) * i;
        const y = height - paddingY - (i / 4) * chartHeight;
        svgInner += `
          <line x1="${paddingX}" y1="${y}" x2="${width - paddingX}" y2="${y}" stroke="#e2e8f0" stroke-width="1" stroke-dasharray="3,3" />
          <text x="${paddingX - 15}" y="${y + 4}" font-size="11" font-weight="600" fill="#64748b" text-anchor="end">${(v / 1000).toFixed(0)}k</text>
        `;
      }

      const barGroupW = chartWidth / DEMOGRAFIA_AFILIADOS.length;
      DEMOGRAFIA_AFILIADOS.forEach((d, idx) => {
        const groupX = paddingX + idx * barGroupW;
        const barW = Math.min(34, barGroupW * 0.4);

        const hTot = (d.afiliadosTotal / maxVal) * chartHeight;
        const yTot = height - paddingY - hTot;
        const hCot = (d.cotizantesEfectivos / maxVal) * chartHeight;
        const yCot = height - paddingY - hCot;

        svgInner += `
          <rect
            class="chart-elem cursor-pointer transition-all hover:opacity-85"
            x="${groupX + barGroupW/2 - barW - 2}"
            y="${yTot}"
            width="${barW}"
            height="${hTot}"
            fill="#94a3b8"
            rx="4"
            data-tooltip-title="${d.rangoEdad} - Total Afiliados"
            data-tooltip-rows='[{"label":"Afiliados Totales","value":"${formatNumero(d.afiliadosTotal)}","color":"#94a3b8"}]'
          />
          <rect
            class="chart-elem cursor-pointer transition-all hover:opacity-85"
            x="${groupX + barGroupW/2 + 2}"
            y="${yCot}"
            width="${barW}"
            height="${hCot}"
            fill="#10b981"
            rx="4"
            data-tooltip-title="${d.rangoEdad} - Cotizantes Efectivos"
            data-tooltip-rows='[{"label":"Cotizantes Activos","value":"${formatNumero(d.cotizantesEfectivos)}","color":"#10b981"},{"label":"Densidad","value":"${d.porcentajeCotizantes.toFixed(1)}%"}]'
          />
          <text x="${groupX + barGroupW/2 - barW/2 - 2}" y="${yTot - 6}" font-size="10" font-weight="700" fill="#64748b" text-anchor="middle">${(d.afiliadosTotal / 1000).toFixed(0)}k</text>
          <text x="${groupX + barGroupW/2 + barW/2 + 2}" y="${yCot - 6}" font-size="10" font-weight="800" fill="#047857" text-anchor="middle">${(d.cotizantesEfectivos / 1000).toFixed(0)}k</text>
          <text x="${groupX + barGroupW/2}" y="${height - paddingY + 20}" font-size="11" font-weight="700" fill="#1e293b" text-anchor="middle">${d.rangoEdad}</text>
        `;
      });

      legendContainer.innerHTML = `
        <div class="flex items-center gap-1.5"><span class="w-3.5 h-3.5 rounded bg-slate-400 inline-block"></span><span class="font-medium">Afiliados Totales Acumulados</span></div>
        <div class="flex items-center gap-1.5"><span class="w-3.5 h-3.5 rounded bg-emerald-500 inline-block"></span><span class="font-medium">Cotizantes Efectivos Mensuales (~45.3% Densidad Media)</span></div>
      `;

    } else if (vista === 'cuotaMercado') {
      methodologyNote.textContent = 'Distribución del total de afiliados entre las 6 operadoras (OPCs). Popular Pensiones absorbe por ley la asignación por defecto de trabajadores no inscritos.';
      for (let v = 0; v <= 45; v += 10) {
        const y = height - paddingY - (v / 45) * chartHeight;
        svgInner += `
          <line x1="${paddingX}" y1="${y}" x2="${width - paddingX}" y2="${y}" stroke="#e2e8f0" stroke-width="1" stroke-dasharray="3,3" />
          <text x="${paddingX - 15}" y="${y + 4}" font-size="11" font-weight="600" fill="#64748b" text-anchor="end">${v}%</text>
        `;
      }

      const barGroupW = chartWidth / OPERADORAS.length;
      OPERADORAS.forEach((op, idx) => {
        const groupX = paddingX + idx * barGroupW;
        const barW = Math.min(48, barGroupW * 0.65);
        const h = (op.cuotaMercado / 45) * chartHeight;
        const y = height - paddingY - h;

        svgInner += `
          <rect
            class="chart-elem cursor-pointer transition-all hover:opacity-85"
            x="${groupX + (barGroupW - barW)/2}"
            y="${y}"
            width="${barW}"
            height="${h}"
            fill="${op.colorHex}"
            rx="5"
            data-tooltip-title="${op.nombre}"
            data-tooltip-rows='[{"label":"Cuota de Mercado","value":"${op.cuotaMercado.toFixed(1)}%","color":"${op.colorHex}"},{"label":"Naturaleza","value":"${op.naturaleza}"}]'
          />
          <text x="${groupX + barGroupW/2}" y="${y - 8}" font-size="11" font-weight="800" fill="${op.colorHex}" text-anchor="middle">${op.cuotaMercado.toFixed(1)}%</text>
          <text x="${groupX + barGroupW/2}" y="${height - paddingY + 20}" font-size="11" font-weight="700" fill="#1e293b" text-anchor="middle">${op.nombreCorto}</text>
        `;
      });

      legendContainer.innerHTML = `
        <div class="flex items-center gap-1.5"><span class="w-3.5 h-3.5 rounded bg-sky-600 inline-block"></span><span class="font-medium">Popular Pensiones concentra el 39.8% del mercado por asignación legal</span></div>
      `;

    } else if (vista === 'brecha') {
      methodologyNote.textContent = 'Salario promedio mensual reportado a SICERE: comparativa entre Hombres y Mujeres en cada tramo etario y brecha salarial observada.';
      const maxVal = 950000;
      for (let i = 0; i <= 5; i++) {
        const v = (maxVal / 5) * i;
        const y = height - paddingY - (i / 5) * chartHeight;
        svgInner += `
          <line x1="${paddingX}" y1="${y}" x2="${width - paddingX}" y2="${y}" stroke="#e2e8f0" stroke-width="1" stroke-dasharray="3,3" />
          <text x="${paddingX - 15}" y="${y + 4}" font-size="11" font-weight="600" fill="#64748b" text-anchor="end">₡ ${(v / 1000).toFixed(0)}k</text>
        `;
      }

      const barGroupW = chartWidth / DEMOGRAFIA_AFILIADOS.length;
      DEMOGRAFIA_AFILIADOS.forEach((d, idx) => {
        const groupX = paddingX + idx * barGroupW;
        const barW = Math.min(32, barGroupW * 0.38);

        const hH = (d.salarioPromedioHombresCRC / maxVal) * chartHeight;
        const yH = height - paddingY - hH;
        const hM = (d.salarioPromedioMujeresCRC / maxVal) * chartHeight;
        const yM = height - paddingY - hM;
        const brechaPct = ((d.salarioPromedioHombresCRC - d.salarioPromedioMujeresCRC) / d.salarioPromedioMujeresCRC) * 100;

        svgInner += `
          <rect
            class="chart-elem cursor-pointer transition-all hover:opacity-85"
            x="${groupX + barGroupW/2 - barW - 2}"
            y="${yH}"
            width="${barW}"
            height="${hH}"
            fill="#0284c7"
            rx="4"
            data-tooltip-title="${d.rangoEdad} - Hombres"
            data-tooltip-rows='[{"label":"Salario Medio","value":"${formatColones(d.salarioPromedioHombresCRC)}","color":"#0284c7"}]'
          />
          <rect
            class="chart-elem cursor-pointer transition-all hover:opacity-85"
            x="${groupX + barGroupW/2 + 2}"
            y="${yM}"
            width="${barW}"
            height="${hM}"
            fill="#d946ef"
            rx="4"
            data-tooltip-title="${d.rangoEdad} - Mujeres"
            data-tooltip-rows='[{"label":"Salario Medio","value":"${formatColones(d.salarioPromedioMujeresCRC)}","color":"#d946ef"},{"label":"Brecha Salarial","value":"+${brechaPct.toFixed(1)}% hombres"}]'
          />
          <text x="${groupX + barGroupW/2 - barW/2 - 2}" y="${yH - 6}" font-size="9" font-weight="700" fill="#0284c7" text-anchor="middle">₡${(d.salarioPromedioHombresCRC/1000).toFixed(0)}k</text>
          <text x="${groupX + barGroupW/2 + barW/2 + 2}" y="${yM - 6}" font-size="9" font-weight="700" fill="#d946ef" text-anchor="middle">₡${(d.salarioPromedioMujeresCRC/1000).toFixed(0)}k</text>
          <text x="${groupX + barGroupW/2}" y="${height - paddingY + 20}" font-size="11" font-weight="700" fill="#1e293b" text-anchor="middle">${d.rangoEdad}</text>
        `;
      });

      legendContainer.innerHTML = `
        <div class="flex items-center gap-1.5"><span class="w-3.5 h-3.5 rounded bg-sky-600 inline-block"></span><span class="font-medium">Salario Hombres</span></div>
        <div class="flex items-center gap-1.5"><span class="w-3.5 h-3.5 rounded bg-fuchsia-500 inline-block"></span><span class="font-medium">Salario Mujeres</span></div>
        <div class="flex items-center gap-1 text-slate-500"><span>Brecha media nacional: ~ +6.5% a favor de hombres</span></div>
      `;

    } else {
      // Pirámide Clásica Hombres vs Mujeres
      methodologyNote.textContent = 'Pirámide de población laboral cotizante al ROP. Los cotizantes efectivos son aquellos con reporte y pago activo en planilla SICERE en el mes.';
      let maxVal = 700000;
      for (let i = 0; i <= 4; i++) {
        const v = (maxVal / 4) * i;
        const y = height - paddingY - (i / 4) * chartHeight;
        svgInner += `
