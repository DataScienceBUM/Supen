      methodologyNote.textContent = 'Activos Administrados (AUM) en billones de colones costarricenses por cada OPC autorizada.';
      const aums = [6.31, 2.88, 2.46, 1.78, 1.70, 0.34];
      const labels = OPERADORAS.map(o => o.nombreCorto);

      chartInstance = new Chart(canvas, {
        type: 'bar',
        data: {
          labels,
          datasets: [{
            label: 'AUM (₡ Billones)',
            data: aums,
            backgroundColor: OPERADORAS.map(o => o.colorHex),
            borderRadius: 5
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          scales: {
            y: { ticks: { callback: (val) => `₡ ${Number(val).toFixed(1)}B`, font: { weight: 'bold' } } }
          },
          plugins: { legend: { display: false } }
        }
      });

    } else {
      // Balance Contable
      methodologyNote.textContent = 'Balance contable consolidado del Sistema Nacional de Pensiones según catálogo oficial SUPEN.';
      const labels = ['Activo Total Administrado', 'Pasivo Operativo', 'Patrimonio de los Fondos'];

      chartInstance = new Chart(canvas, {
        type: 'bar',
        data: {
          labels,
          datasets: [{
            label: 'Monto Contable (₡)',
            data: [28314043393736, 114285900000, 28199757493736],
            backgroundColor: ['#0284c7', '#f43f5e', '#10b981'],
            borderRadius: 5
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          scales: {
            y: { ticks: { callback: (val) => `₡ ${(Number(val)/1e12).toFixed(1)}B`, font: { weight: 'bold' } } }
          },
          plugins: { legend: { display: false } }
        }
      });
    }

    kpisGrid.innerHTML = `
      <div class="bg-white border border-slate-200 p-3.5 rounded-2xl shadow-xs">
        <span class="text-[10px] font-bold text-slate-500 uppercase tracking-wider block">Activos Totales Sistema</span>
        <strong class="text-base sm:text-lg font-black text-[#0A2540]">₡ 28.31 B</strong>
        <span class="text-[11px] text-slate-500 block">USD $63.417 Millones</span>
      </div>
      <div class="bg-white border border-slate-200 p-3.5 rounded-2xl shadow-xs">
        <span class="text-[10px] font-bold text-slate-500 uppercase tracking-wider block">Patrimonio ROP</span>
        <strong class="text-base sm:text-lg font-black text-emerald-700">₡ 15.47 B</strong>
        <span class="text-[11px] text-slate-500 block">54.6% del total nacional</span>
      </div>
      <div class="bg-white border border-slate-200 p-3.5 rounded-2xl shadow-xs">
        <span class="text-[10px] font-bold text-slate-500 uppercase tracking-wider block">Tipo de Cambio BCCR</span>
        <strong class="text-base sm:text-lg font-black text-blue-600">₡ 446.47</strong>
        <span class="text-[11px] text-slate-500 block">Cierre oficial del mes</span>
      </div>
      <div class="bg-white border border-slate-200 p-3.5 rounded-2xl shadow-xs">
        <span class="text-[10px] font-bold text-slate-500 uppercase tracking-wider block">Peso sobre PIB</span>
        <strong class="text-base sm:text-lg font-black text-slate-900">32.8%</strong>
        <span class="text-[11px] text-slate-500 block">Profundidad financiera</span>
      </div>
    `;

    tableContainer.innerHTML = `
      <table class="w-full text-left font-mono text-[11px]">
        <thead>
          <tr class="border-b border-slate-200 text-slate-600 font-sans font-bold">
            <th class="py-2 px-3">Cuenta Contable</th>
            <th class="py-2 px-3">Monto CRC</th>
            <th class="py-2 px-3">Monto USD</th>
            <th class="py-2 px-3">% Sistema</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <tr class="hover:bg-slate-50">
            <td class="py-1.5 px-3 font-bold text-slate-900">Activo Total Administrado</td>
            <td class="py-1.5 px-3 font-bold text-blue-700">₡ 28.314.043.393.736</td>
            <td class="py-1.5 px-3 text-emerald-700">$ 63.417.572.051</td>
            <td class="py-1.5 px-3 font-bold text-slate-800">100.0%</td>
          </tr>
          <tr class="hover:bg-slate-50">
            <td class="py-1.5 px-3 font-bold text-slate-900">Fondo ROP (Régimen Obligatorio)</td>
            <td class="py-1.5 px-3 font-bold text-emerald-700">₡ 15.472.154.859.965</td>
            <td class="py-1.5 px-3 text-emerald-700">$ 34.654.410.957</td>
            <td class="py-1.5 px-3 font-bold text-slate-800">54.6%</td>
          </tr>
          <tr class="hover:bg-slate-50">
            <td class="py-1.5 px-3 font-bold text-slate-900">Pasivo Operativo Contable</td>
            <td class="py-1.5 px-3 font-bold text-rose-700">₡ 114.285.900.000</td>
            <td class="py-1.5 px-3 text-rose-700">$ 255.976.437</td>
            <td class="py-1.5 px-3 font-bold text-slate-800">0.4%</td>
          </tr>
        </tbody>
      </table>
    `;
  }

  // ==========================================
  // SWITCHER PRINCIPAL DE ENDPOINTS
  // ==========================================
  function switchEndpoint(idx: number) {
    currentEndpointIdx = idx;
    const ep = API_ENDPOINTS[idx];

    epButtons.forEach((btn, i) => {
      if (i === idx) {
        btn.className = 'ep-selector-btn px-2.5 py-2.5 rounded-xl border text-xs font-semibold text-left transition-all flex flex-col justify-between gap-1 group bg-[#0A2540] border-[#0A2540] text-white shadow-sm ring-2 ring-blue-500/20';
      } else {
        btn.className = 'ep-selector-btn px-2.5 py-2.5 rounded-xl border text-xs font-semibold text-left transition-all flex flex-col justify-between gap-1 group bg-slate-50 border-slate-200 text-slate-700 hover:bg-slate-100 hover:border-slate-300';
      }
    });

    if (activeEpBadge) activeEpBadge.textContent = ep.endpoint;
    if (epTitle) epTitle.textContent = ep.endpoint;
    if (epName) epName.textContent = ep.nombre;
    if (epDesc) epDesc.textContent = ep.descripcion;

    switch (ep.endpoint) {
      case '/rendimiento':
        renderRendimiento();
        break;
      case '/comision':
        renderComision();
        break;
      case '/portafolio':
        renderPortafolio();
        break;
      case '/portafolioISIN':
        renderPortafolioISIN();
        break;
      case '/LT':
        renderLT();
        break;
      case '/Afiliado':
        renderAfiliado();
        break;
      case '/Beneficio':
        renderBeneficio();
        break;
      case '/Cuenta':
        renderCuenta();
        break;
      default:
        renderRendimiento();
    }
  }

  // Delegación de eventos para controles dinámicos de sub-vistas
  controlsContainer.addEventListener('click', (e) => {
    const target = (e.target as HTMLElement).closest('.ctrl-btn') as HTMLButtonElement;
    if (!target) return;

    const ctrl = target.getAttribute('data-ctrl');
    const val = target.getAttribute('data-val');
    if (!ctrl || !val) return;

    const ep = API_ENDPOINTS[currentEndpointIdx];
    if (ep.endpoint === '/rendimiento') {
      if (ctrl === 'horizonte') state.rendimiento.horizonte = val;
      if (ctrl === 'modo') state.rendimiento.modo = val;
      renderRendimiento();
    } else if (ep.endpoint === '/comision') {
      if (ctrl === 'vista') state.comision.vista = val;
      renderComision();
    } else if (ep.endpoint === '/portafolio') {
      if (ctrl === 'portafolioVista') state.portafolio.vista = val;
      if (ctrl === 'unidad') state.portafolio.unidad = val;
      renderPortafolio();
    } else if (ep.endpoint === '/portafolioISIN') {
      if (ctrl === 'isinIdx') state.portafolioISIN.isinIdx = parseInt(val);
      renderPortafolioISIN();
    } else if (ep.endpoint === '/LT') {
      if (ctrl === 'ltModo') state.lt.modo = val;
      if (ctrl === 'ltMetrica') state.lt.metrica = val;
      renderLT();
    } else if (ep.endpoint === '/Afiliado') {
      if (ctrl === 'afiliadoVista') state.afiliado.vista = val;
      renderAfiliado();
    } else if (ep.endpoint === '/Beneficio') {
      if (ctrl === 'beneficioVista') state.beneficio.vista = val;
      renderBeneficio();
    } else if (ep.endpoint === '/Cuenta') {
      if (ctrl === 'cuentaVista') state.cuenta.vista = val;
      renderCuenta();
    }
  });

  // Delegación de clics en el selector temporal (Días, Meses, Años)
  const temporalSelector = document.getElementById('temporal-granularity-selector');
  if (temporalSelector) {
    temporalSelector.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('.temporal-btn') as HTMLButtonElement;
      if (!btn) return;
      const g = btn.getAttribute('data-temporal') as 'dias' | 'meses' | 'anios';
      if (!g) return;

      const ep = API_ENDPOINTS[currentEndpointIdx];
      if (ep.endpoint === '/rendimiento') {
        state.rendimiento.modo = g;
        renderRendimiento();
      } else {
        updateTemporalBadge(g);
      }
    });
  }

  // Clics en la barra de endpoints
  epButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      const idx = parseInt(btn.getAttribute('data-endpoint-idx') || '0');
      switchEndpoint(idx);
    });
  });

  // Salto a comentarios
  if (btnGotoComments) {
    btnGotoComments.addEventListener('click', () => {
      const btnViewComments = document.getElementById('btn-view-comments') as HTMLButtonElement;
      if (btnViewComments) {
        btnViewComments.click();
        const commentBtns = document.querySelectorAll('.comment-ep-btn') as NodeListOf<HTMLButtonElement>;
        if (commentBtns[currentEndpointIdx]) {
          commentBtns[currentEndpointIdx].click();
        }
      }
    });
  }

  // Inicializar en 0 (/rendimiento)
  switchEndpoint(0);
</script>
