  // ==========================================
  // RENDERER 7: /Cuenta (4 Gráficos)
  // 1. Balance General (Catálogo SUPEN)
  // 2. Evolución Histórica del Activo Neto Total (2010-24)
  // 3. Desglose Estructural del Activo
  // 4. Activos Administrados (AUM) por Operadora
  // ==========================================
  function renderCuenta() {
    const { vista } = state.cuenta;

    controlsContainer.innerHTML = `
      <div class="inline-flex rounded-lg border border-slate-200 bg-white p-0.5 text-xs">
        <button type="button" class="ctrl-btn px-2.5 py-1 rounded-md font-bold transition-colors ${vista === 'balance' ? 'bg-[#0A2540] text-white' : 'text-slate-600'}" data-ctrl="cuentaVista" data-val="balance">Catálogo Contable</button>
        <button type="button" class="ctrl-btn px-2.5 py-1 rounded-md font-bold transition-colors ${vista === 'evolucionNAV' ? 'bg-[#0A2540] text-white' : 'text-slate-600'}" data-ctrl="cuentaVista" data-val="evolucionNAV">Crecimiento Fondo (2010-24)</button>
        <button type="button" class="ctrl-btn px-2.5 py-1 rounded-md font-bold transition-colors ${vista === 'composicion' ? 'bg-[#0A2540] text-white' : 'text-slate-600'}" data-ctrl="cuentaVista" data-val="composicion">Estructura del Activo</button>
        <button type="button" class="ctrl-btn px-2.5 py-1 rounded-md font-bold transition-colors ${vista === 'aumOpcs' ? 'bg-[#0A2540] text-white' : 'text-slate-600'}" data-ctrl="cuentaVista" data-val="aumOpcs">AUM por Operadora</button>
      </div>
    `;

    const paddingX = 140;
    const paddingY = 40;
    const width = 860;
    const height = 380;
    const chartWidth = width - paddingX * 2;
    const chartHeight = height - paddingY * 2 - 20;

    let svgInner = '';

    if (vista === 'evolucionNAV') {
      methodologyNote.textContent = 'Crecimiento histórico del Activo Neto Total del Sistema Nacional de Pensiones (SNP): De ₡5.2 Billones en 2010 a más de ₡27.45 Billones en 2024.';
      const navHist = [
        { año: 2010, navCRC: 5200000000000 },
        { año: 2014, navCRC: 10800000000000 },
        { año: 2018, navCRC: 17900000000000 },
        { año: 2021, navCRC: 23500000000000 },
        { año: 2024, navCRC: 27450890000000 }
      ];

      const maxVal = 30000000000000;
      for (let v = 0; v <= 30000000000000; v += 6000000000000) {
        const y = height - paddingY - (v / maxVal) * chartHeight;
        svgInner += `
          <line x1="${paddingX - 40}" y1="${y}" x2="${width - paddingX + 40}" y2="${y}" stroke="#e2e8f0" stroke-width="1" stroke-dasharray="3,3" />
          <text x="${paddingX - 48}" y="${y + 4}" font-size="11" font-weight="600" fill="#64748b" text-anchor="end">₡ ${(v / 1e12).toFixed(0)} B</text>
        `;
      }

      const points = navHist.map((n, idx) => {
        const x = paddingX - 20 + (idx / (navHist.length - 1)) * (chartWidth + 40);
        const y = height - paddingY - (n.navCRC / maxVal) * chartHeight;
        return { ...n, x, y };
      });

      let pathD = `M ${points[0].x} ${points[0].y}`;
      let areaD = `M ${points[0].x} ${height - paddingY} L ${points[0].x} ${points[0].y}`;
      for (let i = 1; i < points.length; i++) {
        pathD += ` L ${points[i].x} ${points[i].y}`;
        areaD += ` L ${points[i].x} ${points[i].y}`;
      }
      areaD += ` L ${points[points.length - 1].x} ${height - paddingY} Z`;

      svgInner += `
        <defs>
          <linearGradient id="navGrad" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#0A2540" stop-opacity="0.25" />
            <stop offset="100%" stop-color="#0A2540" stop-opacity="0.0" />
          </linearGradient>
        </defs>
        <path d="${areaD}" fill="url(#navGrad)" />
        <path d="${pathD}" fill="none" stroke="#0A2540" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" />
      `;

      points.forEach(p => {
        svgInner += `
          <line x1="${p.x}" y1="${p.y}" x2="${p.x}" y2="${height - paddingY}" stroke="#cbd5e1" stroke-width="1" stroke-dasharray="2,2" />
          <circle
            class="chart-elem cursor-pointer transition-transform hover:scale-125"
            cx="${p.x}"
            cy="${p.y}"
            r="6"
            fill="#0284c7"
            stroke="#ffffff"
            stroke-width="2.5"
            data-tooltip-title="Año ${p.año}"
            data-tooltip-rows='[{"label":"Activo Neto SNP","value":"${formatColones(p.navCRC, true)}","color":"#0A2540"}]'
          />
          <text x="${p.x}" y="${p.y - 12}" font-size="11" font-weight="800" fill="#0A2540" text-anchor="middle">₡ ${(p.navCRC / 1e12).toFixed(1)}B</text>
          <text x="${p.x}" y="${height - paddingY + 20}" font-size="11" font-weight="700" fill="#475569" text-anchor="middle">${p.año}</text>
        `;
      });

      legendContainer.innerHTML = `<div class="flex items-center gap-2"><span class="w-3.5 h-3.5 rounded bg-[#0A2540] inline-block"></span><span>Multiplicación patrimonial x5.2 en 14 años de maduración previsional</span></div>`;

    } else if (vista === 'composicion') {
      methodologyNote.textContent = 'Estructura patrimonial del Activo Total: El 95.38% se mantiene invertido en títulos bursátiles generando rendimientos diarios.';
      const activos = [
        { cuenta: 'Títulos Valores de Inversión', pct: 95.38, montoCRC: 26180500000000, color: '#0A2540' },
        { cuenta: 'Disponibilidades y Efectivo', pct: 2.75, montoCRC: 754900000000, color: '#0284c7' },
        { cuenta: 'Intereses y Dividendos por Cobrar', pct: 1.32, montoCRC: 362350000000, color: '#10b981' },
        { cuenta: 'Otros Activos y Depósitos Garantía', pct: 0.55, montoCRC: 153140000000, color: '#f59e0b' }
      ];

      const barH = 34;
      const gap = 20;
      const startY = 45;

      svgInner += `<line x1="${paddingX + 180}" y1="${startY - 10}" x2="${paddingX + 180}" y2="${startY + activos.length * (barH + gap)}" stroke="#94a3b8" stroke-width="1.5" />`;

      activos.forEach((a, idx) => {
        const y = startY + idx * (barH + gap);
        const maxBarW = chartWidth - 140;
        const barW = (a.pct / 100) * maxBarW;

        svgInner += `
          <text x="${paddingX + 170}" y="${y + barH/2 + 4}" font-size="11" font-weight="700" fill="#1e293b" text-anchor="end">${a.cuenta}</text>
          <rect
            class="chart-elem cursor-pointer transition-all hover:opacity-85"
            x="${paddingX + 180}"
            y="${y}"
            width="${barW}"
            height="${barH}"
            fill="${a.color}"
            rx="4"
            data-tooltip-title="${a.cuenta}"
            data-tooltip-rows='[{"label":"Porcentaje","value":"${a.pct.toFixed(2)}%","color":"${a.color}"},{"label":"Monto","value":"${formatColones(a.montoCRC, true)}"}]'
          />
          <text x="${paddingX + 190 + barW}" y="${y + barH/2 + 4}" font-size="11" font-weight="800" fill="${a.color}">${a.pct.toFixed(1)}% (${formatColones(a.montoCRC, true)})</text>
        `;
      });

      legendContainer.innerHTML = `<div class="flex items-center gap-2"><span class="w-3.5 h-3.5 rounded bg-[#0A2540] inline-block"></span><span>Cero ociosidad de recursos: Más del 95% generando rendimientos fiduciarios</span></div>`;

    } else if (vista === 'aumOpcs') {
      methodologyNote.textContent = 'Activos bajo administración (AUM) por operadora en colones y participación en el fondo consolidado.';
      const opcAUM = [
        { opc: 'Popular', aumCRC: 10920000000000, pct: 39.8, color: '#0284c7' },
        { opc: 'BN Vital', aumCRC: 5180000000000, pct: 18.9, color: '#16a34a' },
        { opc: 'BCR', aumCRC: 4200000000000, pct: 15.3, color: '#2563eb' },
        { opc: 'BAC', aumCRC: 3620000000000, pct: 13.2, color: '#dc2626' },
        { opc: 'CCSS', aumCRC: 2030000000000, pct: 7.4, color: '#0d9488' },
        { opc: 'Vida Plena', aumCRC: 1480000000000, pct: 5.4, color: '#d97706' }
      ];

      const maxVal = 12000000000000;
      for (let v = 0; v <= 12000000000000; v += 3000000000000) {
        const y = height - paddingY - (v / maxVal) * chartHeight;
        svgInner += `
          <line x1="${paddingX - 40}" y1="${y}" x2="${width - paddingX + 40}" y2="${y}" stroke="#e2e8f0" stroke-width="1" stroke-dasharray="3,3" />
          <text x="${paddingX - 48}" y="${y + 4}" font-size="11" font-weight="600" fill="#64748b" text-anchor="end">₡ ${(v / 1e12).toFixed(0)} B</text>
        `;
      }

      const barGroupW = (chartWidth + 40) / opcAUM.length;
      opcAUM.forEach((op, idx) => {
        const groupX = paddingX - 30 + idx * barGroupW;
        const barW = Math.min(48, barGroupW * 0.62);
        const h = (op.aumCRC / maxVal) * chartHeight;
        const y = height - paddingY - h;

        svgInner += `
          <rect
            class="chart-elem cursor-pointer transition-all hover:opacity-85"
            x="${groupX + (barGroupW - barW)/2}"
            y="${y}"
            width="${barW}"
            height="${h}"
            fill="${op.color}"
            rx="5"
            data-tooltip-title="${op.opc}"
            data-tooltip-rows='[{"label":"Activos Administrados","value":"${formatColones(op.aumCRC, true)}","color":"${op.color}"},{"label":"Participación AUM","value":"${op.pct.toFixed(1)}%"}]'
          />
          <text x="${groupX + barGroupW/2}" y="${y - 8}" font-size="11" font-weight="800" fill="${op.color}" text-anchor="middle">₡ ${(op.aumCRC / 1e12).toFixed(1)}B</text>
          <text x="${groupX + barGroupW/2}" y="${height - paddingY + 20}" font-size="11" font-weight="700" fill="#1e293b" text-anchor="middle">${op.opc}</text>
        `;
      });

      legendContainer.innerHTML = `<div class="flex items-center gap-2"><span class="w-3.5 h-3.5 rounded bg-sky-600 inline-block"></span><span>Popular Pensiones custodia casi ₡11 Billones (~40% del AUM de todo el país)</span></div>`;

    } else {
      // Balance Contable General
      methodologyNote.textContent = 'Cuentas contables estandarizadas del catálogo SUPEN. El Activo Neto representa el saldo acumulado en custodia fiduciaria para los afiliados.';
      const cuentas = [
        { codigo: '0110000000000', nombre: 'Activo Neto del Fondo', montoCRC: 27450890000000, color: '#0A2540' },
        { codigo: '0212000000000', nombre: 'Inversiones en Instrumentos', montoCRC: 26180500000000, color: '#0284c7' },
        { codigo: '0230000000000', nombre: 'Patrimonio de Fondos', montoCRC: 27120300000000, color: '#10b981' },
        { codigo: '0220000000000', nombre: 'Pasivos Totales', montoCRC: 330590000000, color: '#f43f5e' }
      ];

      const maxVal = 30000000000000;
      const barH = 36;
      const gap = 24;
      const startY = 50;

      cuentas.forEach((c, idx) => {
        const y = startY + idx * (barH + gap);
        const barLen = (c.montoCRC / maxVal) * chartWidth;

        svgInner += `
          <text x="${paddingX - 15}" y="${y + barH/2 + 4}" font-size="11" font-weight="700" fill="#1e293b" text-anchor="end">${c.nombre}</text>
          <rect
            class="chart-elem cursor-pointer transition-all duration-300 hover:opacity-85"
            x="${paddingX}"
            y="${y}"
            width="${barLen}"
            height="${barH}"
            fill="${c.color}"
            rx="5"
            data-tooltip-title="${c.nombre}"
            data-tooltip-rows='[{"label":"Código Cuenta","value":"${c.codigo}","color":"${c.color}"},{"label":"Saldo Contable","value":"${formatColones(c.montoCRC, true)}"}]'
          />
          <text x="${paddingX + barLen + 10}" y="${y + barH/2 + 4}" font-size="11" font-weight="800" fill="${c.color}">${formatColones(c.montoCRC, true)}</text>
        `;
      });

      legendContainer.innerHTML = cuentas.map(c => `
        <div class="flex items-center gap-1.5">
          <span class="w-3 h-3 rounded" style="background-color: ${c.color}"></span>
          <span class="font-medium font-mono text-[11px]">${c.codigo} (${c.nombre.split(' ')[0]})</span>
        </div>
      `).join('');
    }

    svg.innerHTML = svgInner;

    kpisGrid.innerHTML = `
      <div class="bg-white border border-slate-200 p-3.5 rounded-2xl shadow-xs">
        <span class="text-[10px] font-bold text-slate-500 uppercase tracking-wider block">Activo Neto Consolidado</span>
        <strong class="text-base sm:text-lg font-black text-[#0A2540]">₡ 27.45 Billones</strong>
        <span class="text-[11px] text-slate-500 block">Cuenta 0110000000000</span>
      </div>
      <div class="bg-white border border-slate-200 p-3.5 rounded-2xl shadow-xs">
        <span class="text-[10px] font-bold text-slate-500 uppercase tracking-wider block">Inversiones Bursátiles</span>
        <strong class="text-base sm:text-lg font-black text-sky-800">95.4%</strong>
        <span class="text-[11px] text-slate-500 block">En títulos valores</span>
      </div>
      <div class="bg-white border border-slate-200 p-3.5 rounded-2xl shadow-xs">
        <span class="text-[10px] font-bold text-slate-500 uppercase tracking-wider block">Pasivos del Sistema</span>
        <strong class="text-base sm:text-lg font-black text-rose-700">&lt; 1.3%</strong>
        <span class="text-[11px] text-slate-500 block">Apalancamiento casi nulo</span>
      </div>
      <div class="bg-white border border-slate-200 p-3.5 rounded-2xl shadow-xs">
        <span class="text-[10px] font-bold text-slate-500 uppercase tracking-wider block">Frecuencia Contable</span>
        <strong class="text-base sm:text-lg font-black text-slate-800">Mensual</strong>
        <span class="text-[11px] text-slate-500 block">Último día hábil</span>
      </div>
    `;

    const cuentas = [
      { codigo: '0110000000000', nombre: 'Activo Neto del Fondo', montoCRC: 27450890000000 },
      { codigo: '0212000000000', nombre: 'Inversiones en Instrumentos', montoCRC: 26180500000000 },
      { codigo: '0230000000000', nombre: 'Patrimonio de Fondos', montoCRC: 27120300000000 },
      { codigo: '0220000000000', nombre: 'Pasivos Totales', montoCRC: 330590000000 }
    ];
    tableContainer.innerHTML = `
      <table class="w-full text-left font-mono text-[11px]">
        <thead>
          <tr class="border-b border-slate-200 text-slate-600 font-sans font-bold">
            <th class="py-2 px-3">Código Cuenta</th>
            <th class="py-2 px-3">Denominación Oficial</th>
            <th class="py-2 px-3">Monto en Colones</th>
            <th class="py-2 px-3">Monto en Dólares</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          ${cuentas.map(c => `
            <tr>
              <td class="py-2 px-3 font-bold text-[#0A2540]">${c.codigo}</td>
              <td class="py-2 px-3 font-sans font-medium text-slate-900">${c.nombre}</td>
              <td class="py-2 px-3 text-[#0A2540] font-bold">${formatColones(c.montoCRC, true)}</td>
              <td class="py-2 px-3 text-slate-700">${formatDolares(c.montoCRC / KPI_SISTEMA.tipoCambioBccr, true)}</td>
            </tr>
          `).join('')}
        </tbody>
      </table>
    `;
  }

  // ==========================================
  // DISPATCHER PRINCIPAL
  // ==========================================
  function switchEndpoint(idx: number) {
    currentEndpointIdx = idx;
    const ep = API_ENDPOINTS[idx];

    epButtons.forEach((btn, i) => {
      if (i === idx) {
        btn.className = 'ep-selector-btn px-2.5 py-2.5 rounded-xl border text-xs font-semibold text-left transition-all flex flex-col justify-between gap-1 group bg-[#0A2540] border-[#0A2540] text-white shadow-sm ring-2 ring-blue-500/20';
      } else {
        btn.className = 'ep-selector-btn px-2.5 py-2.5 rounded-xl border text-xs font-semibold text-left transition-all flex flex-col justify-between gap-1 group bg-slate-50 border-slate-200 text-slate-700 hover:bg-slate-100 hover:border-slate-300';
      }
    });

    activeEpBadge.textContent = ep.endpoint;
    epTitle.textContent = ep.endpoint;
    epName.textContent = ep.nombre;
    epDesc.textContent = ep.descripcion;

    hideTooltip();

    switch (ep.endpoint) {
      case '/rendimiento':
        renderRendimiento();
        break;
      case '/comision':
        renderComision();
        break;
      case '/portafolio':
        renderPortafolio();
        break;
      case '/portafolioISIN':
        renderPortafolioISIN();
        break;
      case '/LT':
        renderLT();
        break;
      case '/Afiliado':
        renderAfiliado();
        break;
      case '/Beneficio':
        renderBeneficio();
        break;
      case '/Cuenta':
        renderCuenta();
        break;
      default:
        renderRendimiento();
    }

    attachSvgTooltipListeners();
  }

  function attachSvgTooltipListeners() {
    const elements = svg.querySelectorAll('.chart-elem');
    elements.forEach(el => {
      el.addEventListener('mouseenter', (e) => {
        const title = el.getAttribute('data-tooltip-title') || 'Detalle';
        const rowsStr = el.getAttribute('data-tooltip-rows') || '[]';
        try {
          const rows = JSON.parse(rowsStr);
          showTooltip(e as MouseEvent, title, rows);
        } catch {
          // ignore
        }
      });
      el.addEventListener('mousemove', (e) => {
        const title = el.getAttribute('data-tooltip-title') || 'Detalle';
        const rowsStr = el.getAttribute('data-tooltip-rows') || '[]';
        try {
          const rows = JSON.parse(rowsStr);
          showTooltip(e as MouseEvent, title, rows);
        } catch {
          // ignore
        }
      });
      el.addEventListener('mouseleave', () => {
        hideTooltip();
      });
    });
  }

  // Delegación de eventos para controles dinámicos
  controlsContainer.addEventListener('click', (e) => {
    const target = (e.target as HTMLElement).closest('.ctrl-btn') as HTMLButtonElement;
    if (!target) return;

    const ctrl = target.getAttribute('data-ctrl');
    const val = target.getAttribute('data-val');
    if (!ctrl || !val) return;

    const ep = API_ENDPOINTS[currentEndpointIdx];
    if (ep.endpoint === '/rendimiento') {
      if (ctrl === 'horizonte') state.rendimiento.horizonte = val;
      if (ctrl === 'modo') state.rendimiento.modo = val;
      renderRendimiento();
    } else if (ep.endpoint === '/comision') {
      if (ctrl === 'vista') state.comision.vista = val;
      renderComision();
    } else if (ep.endpoint === '/portafolio') {
      if (ctrl === 'portafolioVista') state.portafolio.vista = val;
      if (ctrl === 'unidad') state.portafolio.unidad = val;
      renderPortafolio();
    } else if (ep.endpoint === '/portafolioISIN') {
      if (ctrl === 'isinVista') state.portafolioISIN.vista = val;
      if (ctrl === 'isinIdx') state.portafolioISIN.isinIdx = parseInt(val);
      renderPortafolioISIN();
    } else if (ep.endpoint === '/LT') {
      if (ctrl === 'ltModo') state.lt.modo = val;
      if (ctrl === 'ltMetrica') state.lt.metrica = val;
      renderLT();
    } else if (ep.endpoint === '/Afiliado') {
      if (ctrl === 'afiliadoVista') state.afiliado.vista = val;
      renderAfiliado();
    } else if (ep.endpoint === '/Beneficio') {
      if (ctrl === 'beneficioVista') state.beneficio.vista = val;
      renderBeneficio();
    } else if (ep.endpoint === '/Cuenta') {
      if (ctrl === 'cuentaVista') state.cuenta.vista = val;
      renderCuenta();
    }

    attachSvgTooltipListeners();
  });

  epButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      const idx = parseInt(btn.getAttribute('data-endpoint-idx') || '0');
      switchEndpoint(idx);
    });
  });

  // Salto al apartado de comentarios con el endpoint actual
  if (btnGotoComments) {
    btnGotoComments.addEventListener('click', () => {
      const btnViewComments = document.getElementById('btn-view-comments') as HTMLButtonElement;
      if (btnViewComments) {
        btnViewComments.click();
        const commentBtns = document.querySelectorAll('.comment-ep-btn') as NodeListOf<HTMLButtonElement>;
        if (commentBtns[currentEndpointIdx]) {
          commentBtns[currentEndpointIdx].click();
        }
      }
    });
  }

  // Inicializar en 0 (/rendimiento)
  switchEndpoint(0);
</script>
