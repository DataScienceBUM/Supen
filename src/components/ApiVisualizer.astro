      legendContainer.innerHTML = `<div class="flex items-center gap-2"><span class="w-3.5 h-3.5 rounded bg-emerald-500 inline-block"></span><span>El tope actual de 0.35% preserva +15.9% de patrimonio adicional para el jubilado</span></div>`;

    } else if (vista === 'costo') {
      // Gráfico 4: Costo en colones por cada ₡10M de saldo
      methodologyNote.textContent = 'Costo anual cobrado en colones por la operadora por cada ₡10.000.000 de saldo acumulado, mostrando el ahorro monetario directo tras la reducción regulatoria.';
      const costos = [
        { año: '2005 (1.10%)', costoCRC: 110000, color: '#dc2626' },
        { año: '2010 (0.85%)', costoCRC: 85000, color: '#f97316' },
        { año: '2014 (0.70%)', costoCRC: 70000, color: '#eab308' },
        { año: '2018 (0.50%)', costoCRC: 50000, color: '#3b82f6' },
        { año: 'Hoy (0.35%)', costoCRC: 35000, color: '#10b981' }
      ];

      const maxVal = 120000;
      for (let v = 0; v <= 120000; v += 30000) {
        const y = height - paddingY - (v / maxVal) * chartHeight;
        svgInner += `
          <line x1="${paddingX}" y1="${y}" x2="${width - paddingX}" y2="${y}" stroke="#e2e8f0" stroke-width="1" stroke-dasharray="3,3" />
          <text x="${paddingX - 15}" y="${y + 4}" font-size="11" font-weight="600" fill="#64748b" text-anchor="end">₡ ${(v / 1000).toFixed(0)}k</text>
        `;
      }

      const barGroupW = chartWidth / costos.length;
      costos.forEach((c, idx) => {
        const groupX = paddingX + idx * barGroupW;
        const barW = Math.min(50, barGroupW * 0.55);
        const h = (c.costoCRC / maxVal) * chartHeight;
        const y = height - paddingY - h;

        svgInner += `
          <rect
            class="chart-elem cursor-pointer transition-all hover:opacity-85"
            x="${groupX + (barGroupW - barW)/2}"
