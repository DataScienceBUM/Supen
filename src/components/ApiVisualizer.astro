  // ==========================================
  // RENDERER 1: /comision (4 Gráficos)
  // 1. Línea Histórica del Tope Legal (2005-2020)
  // 2. Simulación de Saldo Acumulado a 40 Años
  // 3. Impacto Porcentual (Fee Drag)
  // 4. Costo Anual en Colones por cada ₡10M de Saldo
  // ==========================================
  function renderComision() {
    const { vista } = state.comision;

    controlsContainer.innerHTML = `
      <div class="inline-flex rounded-lg border border-slate-200 bg-white p-0.5 text-xs">
        <button type="button" class="ctrl-btn px-2.5 py-1 rounded-md font-bold transition-colors ${vista === 'linea' ? 'bg-[#0A2540] text-white' : 'text-slate-600'}" data-ctrl="vista" data-val="linea">Línea Histórica</button>
        <button type="button" class="ctrl-btn px-2.5 py-1 rounded-md font-bold transition-colors ${vista === 'simulacion' ? 'bg-[#0A2540] text-white' : 'text-slate-600'}" data-ctrl="vista" data-val="simulacion">Simulación 40 Años</button>
        <button type="button" class="ctrl-btn px-2.5 py-1 rounded-md font-bold transition-colors ${vista === 'feedrag' ? 'bg-[#0A2540] text-white' : 'text-slate-600'}" data-ctrl="vista" data-val="feedrag">Impacto Fee Drag</button>
        <button type="button" class="ctrl-btn px-2.5 py-1 rounded-md font-bold transition-colors ${vista === 'costo' ? 'bg-[#0A2540] text-white' : 'text-slate-600'}" data-ctrl="vista" data-val="costo">Costo por ₡10M</button>
      </div>
    `;

    const paddingX = 90;
    const paddingY = 40;
    const width = 860;
    const height = 380;
    const chartWidth = width - paddingX * 2;
    const chartHeight = height - paddingY * 2 - 20;

    let svgInner = '';

    if (vista === 'simulacion') {
      methodologyNote.textContent = 'Simulación actuarial de capital acumulado para un salario de ₡750.000 mensual (aporte ROP 4.25% = ₡31.875/mes con rendimiento real del 4.0%). Comparativa: tope 0.35% actual vs 1.10% histórico.';
      const horizontes = [
        { años: 10, saldo035: 4850000, saldo110: 4520000 },
        { años: 20, saldo035: 13200000, saldo110: 11600000 },
        { años: 30, saldo035: 27100000, saldo110: 22400000 },
        { años: 40, saldo035: 48200000, saldo110: 36500000 }
      ];

      const maxVal = 55000000;
      for (let i = 0; i <= 5; i++) {
        const v = (maxVal / 5) * i;
        const y = height - paddingY - (v / maxVal) * chartHeight;
        svgInner += `
          <line x1="${paddingX}" y1="${y}" x2="${width - paddingX}" y2="${y}" stroke="#e2e8f0" stroke-width="1" stroke-dasharray="3,3" />
          <text x="${paddingX - 15}" y="${y + 4}" font-size="11" font-weight="600" fill="#64748b" text-anchor="end">₡ ${(v / 1_000_000).toFixed(0)} M</text>
        `;
      }

      const barGroupW = chartWidth / horizontes.length;
      horizontes.forEach((h, idx) => {
        const groupX = paddingX + idx * barGroupW;
        const barW = Math.min(38, barGroupW * 0.35);

        const h035 = (h.saldo035 / maxVal) * chartHeight;
        const y035 = height - paddingY - h035;
        const h110 = (h.saldo110 / maxVal) * chartHeight;
        const y110 = height - paddingY - h110;
        const diferencia = h.saldo035 - h.saldo110;

        svgInner += `
          <rect
            class="chart-elem cursor-pointer transition-all hover:opacity-85"
            x="${groupX + barGroupW/2 - barW - 3}"
            y="${y110}"
            width="${barW}"
            height="${h110}"
            fill="#f43f5e"
            rx="4"
            data-tooltip-title="${h.años} Años de Carrera (Tope 1.10%)"
            data-tooltip-rows='[{"label":"Saldo Acumulado","value":"${formatColones(h.saldo110, true)}","color":"#f43f5e"},{"label":"Tope Histórico","value":"1.10% anual"}]'
          />
          <rect
            class="chart-elem cursor-pointer transition-all hover:opacity-85"
            x="${groupX + barGroupW/2 + 3}"
            y="${y035}"
            width="${barW}"
            height="${h035}"
            fill="#10b981"
            rx="4"
            data-tooltip-title="${h.años} Años de Carrera (Tope 0.35%)"
            data-tooltip-rows='[{"label":"Saldo Acumulado","value":"${formatColones(h.saldo035, true)}","color":"#10b981"},{"label":"Patrimonio Extra","value":"+${formatColones(diferencia, true)}"}]'
          />
          <text x="${groupX + barGroupW/2 - barW/2 - 3}" y="${y110 - 6}" font-size="10" font-weight="700" fill="#e11d48" text-anchor="middle">₡ ${(h.saldo110 / 1_000_000).toFixed(1)}M</text>
          <text x="${groupX + barGroupW/2 + barW/2 + 3}" y="${y035 - 6}" font-size="11" font-weight="800" fill="#047857" text-anchor="middle">₡ ${(h.saldo035 / 1_000_000).toFixed(1)}M</text>
          <text x="${groupX + barGroupW/2}" y="${height - paddingY + 20}" font-size="11" font-weight="700" fill="#1e293b" text-anchor="middle">${h.años} Años de Aporte</text>
        `;
      });

      legendContainer.innerHTML = `
        <div class="flex items-center gap-1.5"><span class="w-3.5 h-3.5 rounded bg-emerald-500 inline-block"></span><span class="font-medium">Tope Actual 0.35% (Preserva mayor capital)</span></div>
        <div class="flex items-center gap-1.5"><span class="w-3.5 h-3.5 rounded bg-rose-500 inline-block"></span><span class="font-medium">Tope Histórico 1.10% (Alto Fee Drag)</span></div>
        <div class="flex items-center gap-1 text-emerald-700 font-bold"><span>Diferencia a 40 años: +₡11.7 Millones</span></div>
      `;

    } else if (vista === 'feedrag') {
      methodologyNote.textContent = 'Efecto multiplicador del Fee Drag en el saldo final a 35 años: el tope de 0.35% preserva un 92.5% del fondo frente al 76.6% del esquema original.';
      const feeScenarios = [
        { label: 'Esquema Inicial (1.10%)', fee: 1.10, perdidaSaldo: 23.4, saldoFinal: 76.6, color: '#dc2626' },
        { label: 'Reforma 2009 (0.85%)', fee: 0.85, perdidaSaldo: 18.5, saldoFinal: 81.5, color: '#f97316' },
        { label: 'Reforma 2013 (0.70%)', fee: 0.70, perdidaSaldo: 15.6, saldoFinal: 84.4, color: '#eab308' },
        { label: 'Reforma 2017 (0.50%)', fee: 0.50, perdidaSaldo: 11.2, saldoFinal: 88.8, color: '#3b82f6' },
        { label: 'Tope Actual (0.35%)', fee: 0.35, perdidaSaldo: 7.5, saldoFinal: 92.5, color: '#10b981' }
      ];

      const barH = 34;
      const gap = 24;
      const startY = 40;

      svgInner += `<line x1="${paddingX + 160}" y1="${startY - 10}" x2="${paddingX + 160}" y2="${startY + feeScenarios.length * (barH + gap)}" stroke="#94a3b8" stroke-width="1.5" />`;

      feeScenarios.forEach((s, idx) => {
        const y = startY + idx * (barH + gap);
