        </thead>
        <tbody class="divide-y divide-slate-100">
          ${RENTABILIDADES.map(d => `
            <tr>
              <td class="py-2 px-3 font-sans font-bold text-slate-900">${d.nombre}</td>
              <td class="py-2 px-3 text-emerald-800 font-bold">${d.rentabilidadReal12m.toFixed(2)}%</td>
