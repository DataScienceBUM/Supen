          <text x="${groupX + barGroupW/2}" y="${y - 8}" font-size="11" font-weight="800" fill="${color}" text-anchor="middle">₡ ${(b.pensionPromedioMensualCRC / 1000).toFixed(0)}k</text>
          <text x="${groupX + barGroupW/2}" y="${height - paddingY + 20}" font-size="11" font-weight="700" fill="#1e293b" text-anchor="middle">${b.modalidad.split(' ')[0]}</text>
          <text x="${groupX + barGroupW/2}" y="${height - paddingY + 34}" font-size="9" font-weight="500" fill="#64748b" text-anchor="middle">${b.modalidad.split(' ').slice(1).join(' ')}</text>
        `;
      });

      legendContainer.innerHTML = `<div class="flex items-center gap-2"><span class="w-3.5 h-3.5 rounded bg-sky-600 inline-block"></span><span>Renta Permanente lidera con ₡210.000 promedio mensual al preservar el capital principal</span></div>`;

    } else if (vista === 'evolucion') {
      methodologyNote.textContent = 'Curva de maduración del régimen obligatorio de pensiones: Crecimiento exponencial del número de jubilados conforme las cohortes completan cotizaciones (crecimiento +360% en 8 años).';
      const evolucion = [
        { año: 2016, pensionados: 18500 },
        { año: 2018, pensionados: 32100 },
        { año: 2020, pensionados: 51400 },
        { año: 2022, pensionados: 68900 },
        { año: 2024, pensionados: 85000 }
      ];

      const maxVal = 100000;
      for (let v = 0; v <= 100000; v += 25000) {
        const y = height - paddingY - (v / maxVal) * chartHeight;
        svgInner += `
          <line x1="${paddingX}" y1="${y}" x2="${width - paddingX}" y2="${y}" stroke="#e2e8f0" stroke-width="1" stroke-dasharray="3,3" />
          <text x="${paddingX - 15}" y="${y + 4}" font-size="11" font-weight="600" fill="#64748b" text-anchor="end">${(v / 1000).toFixed(0)}k</text>
        `;
      }

      const points = evolucion.map((e, idx) => {
        const x = paddingX + (idx / (evolucion.length - 1)) * chartWidth;
        const y = height - paddingY - (e.pensionados / maxVal) * chartHeight;
        return { ...e, x, y };
      });

      let pathD = `M ${points[0].x} ${points[0].y}`;
      let areaD = `M ${points[0].x} ${height - paddingY} L ${points[0].x} ${points[0].y}`;
      for (let i = 1; i < points.length; i++) {
        pathD += ` L ${points[i].x} ${points[i].y}`;
