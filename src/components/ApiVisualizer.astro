            <th class="py-2 px-3">Modalidad</th>
            <th class="py-2 px-3">Beneficiarios</th>
            <th class="py-2 px-3">% Total</th>
            <th class="py-2 px-3">Monto Total (₡)</th>
            <th class="py-2 px-3">Pensión Media (₡)</th>
