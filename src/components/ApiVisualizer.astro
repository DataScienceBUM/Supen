---
import { API_ENDPOINTS } from '../data/supen-data';
---

<div class="bg-white border border-slate-200/90 rounded-3xl p-6 sm:p-8 shadow-sm">
  <!-- Encabezado del Observatorio Visual -->
  <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 mb-6 pb-6 border-b border-slate-100">
    <div>
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-50 border border-blue-200 text-[#0A2540] text-xs font-bold mb-2">
        <span class="w-2 h-2 rounded-full bg-blue-600 animate-pulse"></span>
        <span>Observatorio Cuantitativo de la API Pública SUPEN</span>
        <span>•</span>
        <span class="font-mono">8 Endpoints Oficiales</span>
      </div>
      <h2 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight">
        Análisis Gráfico y Comportamiento de la API
      </h2>
      <p class="text-xs sm:text-sm text-slate-600 mt-1 max-w-2xl leading-relaxed">
        Visualizaciones dinámicas, comparativas de desempeño, curvas multi-horizonte, balances de movilidad bilateral, matrices de portafolio y pirámides demográficas del sistema previsional costarricense generadas con Chart.js.
      </p>
    </div>

    <!-- Badge de Estado y Botón Rápido a Comentarios -->
    <div class="flex flex-wrap items-center gap-2 text-xs self-start lg:self-auto">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-xl bg-slate-50 border border-slate-200 font-mono text-[11px] text-slate-700">
        <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
        <span>Endpoint:</span>
        <strong id="active-ep-badge" class="text-[#0A2540] font-bold">/rendimiento</strong>
      </div>

      <button
        id="btn-goto-comments"
        type="button"
        class="px-3 py-1.5 rounded-xl bg-amber-50 hover:bg-amber-100 border border-amber-200 text-amber-900 font-bold text-xs transition-colors flex items-center gap-1.5 shadow-xs"
        title="Abrir comentarios técnicos y análisis de este endpoint"
      >
        <span>📝</span>
        <span>Ver Comentarios de este Endpoint</span>
      </button>
    </div>
  </div>

  <!-- Barra de Selección de Endpoints de la API -->
  <div class="mb-6">
    <div class="flex items-center justify-between mb-2">
      <span class="text-xs font-bold text-slate-500 uppercase tracking-wider">Selecciona un apartado de la API:</span>
      <span class="text-[11px] text-slate-500 hidden sm:inline">Haz clic para cambiar de apartado</span>
    </div>
    <div class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-8 gap-2" id="endpoint-buttons-container">
      {API_ENDPOINTS.map((ep, idx) => (
        <button
          type="button"
          class={`ep-selector-btn px-2.5 py-2.5 rounded-xl border text-xs font-semibold text-left transition-all flex flex-col justify-between gap-1 group ${
            idx === 0
              ? 'bg-[#0A2540] border-[#0A2540] text-white shadow-sm ring-2 ring-blue-500/20'
              : 'bg-slate-50 border-slate-200 text-slate-700 hover:bg-slate-100 hover:border-slate-300'
          }`}
          data-endpoint-idx={idx}
        >
          <div class="flex items-center justify-between w-full">
            <span class="font-mono text-[11px] font-bold group-hover:underline truncate">{ep.endpoint}</span>
            <span class="text-[9px] px-1 py-0.2 rounded font-mono font-bold bg-white/20 text-current">GET</span>
          </div>
          <span class="text-[10px] font-sans font-medium line-clamp-1 opacity-90">{ep.nombre.split(' ')[0]}</span>
        </button>
      ))}
    </div>
  </div>

  <!-- Tarjeta Principal del Gráfico Interactivo -->
  <div class="bg-slate-50 border border-slate-200 rounded-3xl p-4 sm:p-6 space-y-5">
    <!-- Barra Superior de Controles y Metadatos del Endpoint Activo -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-4 border-b border-slate-200">
      <div>
        <div class="flex items-center gap-2">
          <span class="px-2 py-0.5 rounded-md bg-emerald-100 text-emerald-900 border border-emerald-300 font-mono font-bold text-xs">GET</span>
          <h3 id="chart-endpoint-title" class="text-lg font-black text-slate-900 font-mono tracking-tight">
            /rendimiento
          </h3>
          <span class="text-slate-400">•</span>
          <span id="chart-endpoint-name" class="text-xs sm:text-sm font-bold text-slate-700">
            Rentabilidades Oficiales (Valor Cuota)
          </span>
        </div>
        <p id="chart-endpoint-desc" class="text-xs text-slate-500 mt-1 max-w-2xl leading-relaxed">
          Comparativa de rentabilidad real vs. nominal entre las 6 operadoras (OPCs) autorizadas.
        </p>
      </div>

      <!-- Controles Dinámicos Específicos del Gráfico (Sub-vistas) -->
      <div id="chart-dynamic-controls" class="flex flex-wrap items-center gap-1.5">
        <!-- Rellenado dinámicamente por JavaScript -->
      </div>
    </div>

    <!-- Selector de Nivel de Detalle Temporal (Días, Meses, Años) -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 p-3 bg-white border border-slate-200/90 rounded-2xl shadow-xs">
      <div class="flex items-center gap-2">
        <span class="text-xs font-bold text-slate-800 flex items-center gap-1.5">
          <span class="w-2 h-2 rounded-full bg-blue-600"></span>
          <span>Nivel de Detalle Temporal:</span>
        </span>
        <span id="temporal-active-badge" class="text-[11px] font-mono px-2.5 py-0.5 rounded-full bg-blue-50 text-[#0A2540] border border-blue-200 font-bold">
          Meses (12 Meses)
        </span>
      </div>

      <div class="inline-flex rounded-xl border border-slate-200 bg-slate-50 p-1 text-xs" id="temporal-granularity-selector">
        <button
          type="button"
          class="temporal-btn px-3 py-1.5 rounded-lg font-bold transition-all flex items-center gap-1.5 text-slate-600 hover:text-slate-900"
          data-temporal="dias"
          title="Ver serie diaria de 31 días (Valor Cuota diario de cada operadora)"
        >
          <span>📅</span>
          <span>Días (31D)</span>
        </button>
        <button
          type="button"
          class="temporal-btn px-3 py-1.5 rounded-lg font-bold transition-all flex items-center gap-1.5 bg-[#0A2540] text-white shadow-xs"
          data-temporal="meses"
          title="Ver serie mensual de 12 meses (Rendimiento mes a mes)"
        >
          <span>📆</span>
          <span>Meses (12M)</span>
        </button>
        <button
          type="button"
          class="temporal-btn px-3 py-1.5 rounded-lg font-bold transition-all flex items-center gap-1.5 text-slate-600 hover:text-slate-900"
          data-temporal="anios"
          title="Ver serie histórica anual a 10 años (2015-2024)"
        >
          <span>🗓️</span>
          <span>Años (10A)</span>
        </button>
      </div>
    </div>

    <!-- Contenedor del Gráfico con Chart.js -->
    <div class="relative bg-white border border-slate-200/90 rounded-2xl p-4 sm:p-6 shadow-xs overflow-hidden">
      <div class="relative w-full h-[380px] sm:h-[440px]">
        <canvas id="api-chart-canvas"></canvas>
      </div>
      <div id="chart-legend" class="flex flex-wrap items-center justify-center gap-4 pt-3 mt-1 border-t border-slate-100 text-xs text-slate-600">
        <!-- Rellenado dinámicamente si es necesario -->
      </div>
    </div>

    <!-- Tarjetas de Métricas Clave / KPIs del Apartado -->
    <div id="chart-kpis-grid" class="grid grid-cols-2 sm:grid-cols-4 gap-3">
      <!-- Rellenado dinámicamente -->
    </div>

    <!-- Resumen Metodológico y Cita Oficial -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-[11px] text-slate-500 pt-3 border-t border-slate-200">
      <div class="flex items-center gap-2">
        <svg class="w-4 h-4 text-slate-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span id="chart-methodology-note">
          Tasa geométrica anualizada neta de comisiones descontando variación del Índice de Precios al Consumidor (IPC).
        </span>
      </div>
      <div class="font-mono text-slate-600 font-medium shrink-0">
        <span>Fuente: SUPEN / Estadísticas API Oficial</span>
      </div>
    </div>

    <!-- Sección Desplegable de Datos Tabulares Accesibles (WCAG) -->
    <details class="group bg-white border border-slate-200/80 rounded-2xl p-4 text-xs">
      <summary class="cursor-pointer font-bold text-slate-700 hover:text-[#0A2540] flex items-center justify-between select-none">
        <span class="flex items-center gap-2">
          <span>📋</span>
          <span>Ver Tabla de Datos Estructurada (Accesibilidad y Lectores de Pantalla)</span>
        </span>
        <span class="text-slate-400 group-open:rotate-180 transition-transform">▼</span>
      </summary>
      <div class="mt-4 overflow-x-auto" id="chart-accessible-table-container">
        <!-- Rellenado dinámicamente -->
      </div>
    </details>
  </div>
</div>

<script>
  import Chart from 'chart.js/auto';
  import {
    API_ENDPOINTS,
    RENTABILIDADES,
    HISTORICO_COMISIONES,
    PORTAFOLIO_MACRO,
    TITULOS_ISIN_DESTACADOS,
    MOVILIDAD_RESUMEN,
    DEMOGRAFIA_AFILIADOS,
    BENEFICIOS_RETIROS,
    OPERADORAS,
    SERIE_DIARIA_VALOR_CUOTA,
    SERIE_MENSUAL_RENTABILIDAD,
    SERIE_ANUAL_HISTORICA
  } from '../data/supen-data';
  import {
    formatColones,
    formatDolares,
    formatNumero
  } from '../utils/formatters';

  let currentEndpointIdx = 0;
  let chartInstance: Chart | null = null;

  // Estado interactivo con sub-vistas por apartado
  const state = {
    temporal: { granularidad: 'meses' as 'dias' | 'meses' | 'anios' },
    rendimiento: { horizonte: '12m', modo: 'meses' },
    comision: { vista: 'linea' },
    portafolio: { vista: 'macro', unidad: 'crc' },
    portafolioISIN: { vista: 'tenencia', isinIdx: 0 },
    lt: { modo: 'divergente', metrica: 'colones' },
    afiliado: { vista: 'piramide' },
    beneficio: { vista: 'modalidades', metrica: 'beneficiarios' },
    cuenta: { vista: 'balance' }
  };

  // Elementos DOM
  const canvas = document.getElementById('api-chart-canvas') as HTMLCanvasElement;
  const activeEpBadge = document.getElementById('active-ep-badge') as HTMLElement;
  const epTitle = document.getElementById('chart-endpoint-title') as HTMLElement;
  const epName = document.getElementById('chart-endpoint-name') as HTMLElement;
  const epDesc = document.getElementById('chart-endpoint-desc') as HTMLElement;
  const controlsContainer = document.getElementById('chart-dynamic-controls') as HTMLElement;
  const legendContainer = document.getElementById('chart-legend') as HTMLElement;
  const kpisGrid = document.getElementById('chart-kpis-grid') as HTMLElement;
  const methodologyNote = document.getElementById('chart-methodology-note') as HTMLElement;
  const tableContainer = document.getElementById('chart-accessible-table-container') as HTMLElement;
  const epButtons = document.querySelectorAll('.ep-selector-btn') as NodeListOf<HTMLButtonElement>;
  const btnGotoComments = document.getElementById('btn-goto-comments') as HTMLButtonElement;
  const temporalButtons = document.querySelectorAll('.temporal-btn') as NodeListOf<HTMLButtonElement>;
  const temporalActiveBadge = document.getElementById('temporal-active-badge') as HTMLElement;

  function updateTemporalBadge(granularity: 'dias' | 'meses' | 'anios') {
    state.temporal.granularidad = granularity;
    if (temporalActiveBadge) {
      if (granularity === 'dias') {
        temporalActiveBadge.textContent = 'Días (Diario - 31 Días)';
        temporalActiveBadge.className = 'text-[11px] font-mono px-2.5 py-0.5 rounded-full bg-emerald-50 text-emerald-900 border border-emerald-300 font-bold';
      } else if (granularity === 'meses') {
        temporalActiveBadge.textContent = 'Meses (Mensual - 12 Meses)';
        temporalActiveBadge.className = 'text-[11px] font-mono px-2.5 py-0.5 rounded-full bg-blue-50 text-[#0A2540] border border-blue-200 font-bold';
      } else {
        temporalActiveBadge.textContent = 'Años (Plurianual - 10 Años)';
        temporalActiveBadge.className = 'text-[11px] font-mono px-2.5 py-0.5 rounded-full bg-purple-50 text-purple-900 border border-purple-200 font-bold';
      }
    }

    temporalButtons.forEach(btn => {
      const g = btn.getAttribute('data-temporal');
      if (g === granularity) {
        btn.className = 'temporal-btn px-3 py-1.5 rounded-lg font-bold transition-all flex items-center gap-1.5 bg-[#0A2540] text-white shadow-xs';
      } else {
        btn.className = 'temporal-btn px-3 py-1.5 rounded-lg font-bold transition-all flex items-center gap-1.5 text-slate-600 hover:text-slate-900';
      }
    });
  }

  function getOpColor(opId: string): string {
    const op = OPERADORAS.find(o => o.id === opId || o.nombre === opId || o.nombreCorto === opId);
    return op ? op.colorHex : '#0284c7';
  }

  function getOpNombreCorto(opId: string): string {
    const op = OPERADORAS.find(o => o.id === opId || o.nombre === opId || o.nombreCorto === opId);
    return op ? op.nombreCorto : opId;
  }

  function resetChart() {
    if (chartInstance) {
      chartInstance.destroy();
      chartInstance = null;
    }
    legendContainer.innerHTML = '';
  }

  // ==========================================
  // RENDERER 0: /rendimiento (8 Sub-vistas)
  // ==========================================
  function renderRendimiento() {
    resetChart();
    const { horizonte, modo } = state.rendimiento;

    controlsContainer.innerHTML = `
      <div class="inline-flex rounded-lg border border-slate-200 bg-white p-0.5 text-xs">
        <button type="button" class="ctrl-btn px-2 py-1 rounded-md font-bold transition-colors ${modo === 'dias' ? 'bg-[#0A2540] text-white' : 'text-slate-600'}" data-ctrl="modo" data-val="dias">📅 Días (31D)</button>
        <button type="button" class="ctrl-btn px-2 py-1 rounded-md font-bold transition-colors ${modo === 'meses' ? 'bg-[#0A2540] text-white' : 'text-slate-600'}" data-ctrl="modo" data-val="meses">📆 Meses (12M)</button>
        <button type="button" class="ctrl-btn px-2 py-1 rounded-md font-bold transition-colors ${modo === 'anios' ? 'bg-[#0A2540] text-white' : 'text-slate-600'}" data-ctrl="modo" data-val="anios">🗓️ Años (10A)</button>
        <button type="button" class="ctrl-btn px-2 py-1 rounded-md font-bold transition-colors ${modo === 'comparativo' ? 'bg-[#0A2540] text-white' : 'text-slate-600'}" data-ctrl="modo" data-val="comparativo">Barras Horizontes</button>
        <button type="button" class="ctrl-btn px-2 py-1 rounded-md font-bold transition-colors ${modo === 'lineas' ? 'bg-[#0A2540] text-white' : 'text-slate-600'}" data-ctrl="modo" data-val="lineas">Curvas Horizontes</button>
        <button type="button" class="ctrl-btn px-2 py-1 rounded-md font-bold transition-colors ${modo === 'spread' ? 'bg-[#0A2540] text-white' : 'text-slate-600'}" data-ctrl="modo" data-val="spread">Spread IPC</button>
        <button type="button" class="ctrl-btn px-2 py-1 rounded-md font-bold transition-colors ${modo === 'cuota' ? 'bg-[#0A2540] text-white' : 'text-slate-600'}" data-ctrl="modo" data-val="cuota">Crecimiento ₡100k</button>
        <button type="button" class="ctrl-btn px-2 py-1 rounded-md font-bold transition-colors ${modo === 'ranking' ? 'bg-[#0A2540] text-white' : 'text-slate-600'}" data-ctrl="modo" data-val="ranking">Consistencia</button>
      </div>
      ${modo === 'comparativo' ? `
        <div class="inline-flex rounded-lg border border-slate-200 bg-white p-0.5 text-xs">
          ${['12m', '36m', '60m', '10a'].map(h => `
            <button type="button" class="ctrl-btn px-2 py-1 rounded-md font-bold transition-colors ${horizonte === h ? 'bg-blue-600 text-white' : 'text-slate-600'}" data-ctrl="horizonte" data-val="${h}">
              ${h === '10a' ? '10 Años' : h.toUpperCase()}
            </button>
          `).join('')}
        </div>
      ` : ''}
    `;

    if (modo === 'dias') {
      updateTemporalBadge('dias');
      methodologyNote.textContent = 'Metodología oficial SUPEN: El Valor Cuota se calcula diariamente dividiendo el patrimonio entre las cuotas en circulación. La rentabilidad mensual oficial se obtiene promediando los primeros 30 días naturales (Art. SUPEN).';

      const diasData = SERIE_DIARIA_VALOR_CUOTA;
      const labels = diasData.map(d => `Día ${d.dia}`);
      const datasets: any[] = OPERADORAS.map(op => ({
        label: op.nombreCorto,
        data: diasData.map(d => d.valores[op.id] ?? null),
        borderColor: op.colorHex,
        backgroundColor: op.colorHex,
        borderWidth: 2,
        pointRadius: 2,
        tension: 0.15
      }));
      datasets.push({
        label: 'Promedio Sistema (Art. SUPEN)',
        data: diasData.map(d => d.promedioSistema),
        borderColor: '#d97706',
        backgroundColor: '#d97706',
        borderWidth: 2,
        borderDash: [5, 4],
        pointRadius: 0,
        tension: 0.15
      });

      chartInstance = new Chart(canvas, {
        type: 'line',
        data: { labels, datasets },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          interaction: { mode: 'index', intersect: false },
          plugins: {
            legend: { position: 'bottom', labels: { usePointStyle: true, pointStyle: 'circle', font: { size: 11, weight: 'bold' } } },
            tooltip: {
              callbacks: {
                label: (ctx) => {
                  const val = ctx.parsed.y;
                  if (val === null || val === undefined) return '';
                  return ` ${ctx.dataset.label}: ₡ ${val.toLocaleString('es-CR', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
                }
              }
            }
          },
          scales: {
            y: {
              ticks: { callback: (val) => `₡ ${Number(val).toLocaleString('es-CR', { maximumFractionDigits: 0 })}`, font: { weight: 'bold' } }
            }
          }
        }
      });

    } else if (modo === 'meses') {
      updateTemporalBadge('meses');
      const mesesData = SERIE_MENSUAL_RENTABILIDAD;
      methodologyNote.textContent = 'Evolución mes a mes de la rentabilidad real neta anualizada a lo largo de los últimos 12 cortes mensuales oficiales de la SUPEN, reflejando el impacto directo del IPC y tasas de mercado.';

      const labels = mesesData.map(m => m.mesLabel);
      const datasets: any[] = OPERADORAS.map(op => ({
        label: op.nombreCorto,
        data: mesesData.map(m => m.valores[op.id] ?? null),
        borderColor: op.colorHex,
        backgroundColor: op.colorHex,
        borderWidth: 2.5,
        pointRadius: 3.5,
        tension: 0.25
      }));
      datasets.push({
        label: 'Promedio Sistema',
        data: mesesData.map(m => m.promedioRealSistema),
        borderColor: '#0f766e',
        backgroundColor: '#0f766e',
        borderWidth: 2,
        borderDash: [4, 4],
        pointRadius: 0,
        tension: 0.25
      });

      chartInstance = new Chart(canvas, {
        type: 'line',
        data: { labels, datasets },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          interaction: { mode: 'index', intersect: false },
          plugins: {
            legend: { position: 'bottom', labels: { usePointStyle: true, pointStyle: 'circle', font: { size: 11, weight: 'bold' } } },
            tooltip: {
              callbacks: {
                label: (ctx) => {
                  const val = ctx.parsed.y;
                  if (val === null || val === undefined) return '';
                  return ` ${ctx.dataset.label}: ${val.toFixed(2)}%`;
                }
              }
            }
          },
          scales: {
            y: { ticks: { callback: (val) => `${Number(val).toFixed(1)}%`, font: { weight: 'bold' } } }
          }
        }
      });

    } else if (modo === 'anios') {
      updateTemporalBadge('anios');
      const aniosData = SERIE_ANUAL_HISTORICA;
      methodologyNote.textContent = 'Perspectiva fiduciaria a 10 años: Demuestra cómo las minusvalías contables temporales de mercado son absorbidas en el largo plazo por la maduración de los fondos.';

      const labels = aniosData.map(a => a.año.toString());
      const datasets: any[] = OPERADORAS.map(op => ({
        label: op.nombreCorto,
        data: aniosData.map(a => a.valores[op.id] ?? null),
        borderColor: op.colorHex,
        backgroundColor: op.colorHex,
        borderWidth: 2.5,
        pointRadius: 3.5,
        tension: 0.2
      }));
      datasets.push({
        label: 'Promedio Sistema',
        data: aniosData.map(a => a.promedioRealSistema),
        borderColor: '#475569',
        backgroundColor: '#475569',
        borderWidth: 2,
        borderDash: [4, 4],
        pointRadius: 0,
        tension: 0.2
      });

      chartInstance = new Chart(canvas, {
        type: 'line',
        data: { labels, datasets },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          interaction: { mode: 'index', intersect: false },
          plugins: {
            legend: { position: 'bottom', labels: { usePointStyle: true, pointStyle: 'circle', font: { size: 11, weight: 'bold' } } },
            tooltip: {
              callbacks: {
                label: (ctx) => {
                  const val = ctx.parsed.y;
                  if (val === null || val === undefined) return '';
                  return ` ${ctx.dataset.label}: ${val.toFixed(2)}%`;
                }
              }
            }
          },
          scales: {
            y: {
              grid: {
                color: (ctx) => (ctx.tick && ctx.tick.value === 0 ? '#475569' : '#e2e8f0'),
                lineWidth: (ctx) => (ctx.tick && ctx.tick.value === 0 ? 2 : 1)
              },
              ticks: { callback: (val) => `${Number(val).toFixed(0)}%`, font: { weight: 'bold' } }
            }
          }
        }
      });

    } else if (modo === 'lineas') {
      methodologyNote.textContent = 'Trayectoria temporal de rentabilidad real anualizada a lo largo de los horizontes 12 meses, 36 meses, 60 meses y 10 años para las 6 operadoras.';
      const labels = ['12 Meses', '36 Meses', '60 Meses', '10 Años'];
      const datasets = RENTABILIDADES.map(r => ({
        label: getOpNombreCorto(r.operadoraId),
        data: [r.rentabilidadReal12m, r.rentabilidadReal36m, r.rentabilidadReal60m, r.rentabilidadReal10a],
        borderColor: getOpColor(r.operadoraId),
        backgroundColor: getOpColor(r.operadoraId),
        borderWidth: 2.5,
        pointRadius: 4,
        tension: 0.2
      }));

      chartInstance = new Chart(canvas, {
        type: 'line',
        data: { labels, datasets },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          interaction: { mode: 'index', intersect: false },
          plugins: {
            legend: { position: 'bottom', labels: { usePointStyle: true, pointStyle: 'circle', font: { size: 11, weight: 'bold' } } },
            tooltip: {
              callbacks: {
                label: (ctx) => ` ${ctx.dataset.label}: ${(ctx.parsed.y ?? 0).toFixed(2)}%`
              }
            }
          },
          scales: {
            y: { ticks: { callback: (val) => `${Number(val).toFixed(1)}%`, font: { weight: 'bold' } } }
          }
        }
      });

    } else if (modo === 'spread') {
      methodologyNote.textContent = 'Spread inflacionario: Tasa Real neta más el efecto inflación (IPC) para componer la rentabilidad nominal total.';
      const labels = RENTABILIDADES.map(r => getOpNombreCorto(r.operadoraId));
      const realData = RENTABILIDADES.map(r => r.rentabilidadReal12m);
      const ipcData = RENTABILIDADES.map(r => Math.max(0, r.rentabilidadNominal12m - r.rentabilidadReal12m));

      chartInstance = new Chart(canvas, {
        type: 'bar',
        data: {
          labels,
          datasets: [
            {
              label: 'Rentabilidad Real Neta',
              data: realData,
              backgroundColor: RENTABILIDADES.map(r => getOpColor(r.operadoraId)),
              borderRadius: 4
            },
            {
              label: 'Efecto Inflación (IPC)',
              data: ipcData,
              backgroundColor: '#cbd5e1',
              borderRadius: 4
            }
          ]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          scales: {
            x: { stacked: true },
            y: {
              stacked: true,
              ticks: { callback: (val) => `${Number(val).toFixed(1)}%`, font: { weight: 'bold' } }
            }
          },
          plugins: {
            legend: { position: 'bottom' },
            tooltip: {
              callbacks: {
                label: (ctx) => ` ${ctx.dataset.label}: ${(ctx.parsed.y ?? 0).toFixed(2)}%`
              }
            }
          }
        }
      });

    } else if (modo === 'cuota') {
      methodologyNote.textContent = 'Proyección de capital acumulado tras 10 años para un depósito único de ₡100.000 invertido a la tasa real 10a de cada operadora: C = ₡100k × (1 + r)^10.';
      const labels = RENTABILIDADES.map(r => getOpNombreCorto(r.operadoraId));
      const saldos = RENTABILIDADES.map(r => Math.round(100000 * Math.pow(1 + r.rentabilidadReal10a / 100, 10)));

      chartInstance = new Chart(canvas, {
        type: 'bar',
        data: {
          labels,
          datasets: [{
            label: 'Patrimonio Final Proyectado (₡)',
            data: saldos,
            backgroundColor: RENTABILIDADES.map(r => getOpColor(r.operadoraId)),
            borderRadius: 6
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          scales: {
            y: { ticks: { callback: (val) => `₡ ${(Number(val) / 1000).toFixed(0)}k`, font: { weight: 'bold' } } }
          },
          plugins: {
            legend: { display: false },
            tooltip: {
              callbacks: {
                label: (ctx) => ` Capital Final: ₡ ${formatNumero(ctx.parsed.y ?? 0)}`
              }
            }
          }
        }
      });

    } else if (modo === 'ranking') {
      methodologyNote.textContent = 'Consistencia fiduciaria: Relación entre la tasa a largo plazo (10 años) y el desempeño de corto plazo (12 meses).';
      const labels = RENTABILIDADES.map(r => getOpNombreCorto(r.operadoraId));

      chartInstance = new Chart(canvas, {
        type: 'bar',
        data: {
          labels,
          datasets: [
            {
              label: 'Tasa Real 10 Años (Largo Plazo)',
              data: RENTABILIDADES.map(r => r.rentabilidadReal10a),
              backgroundColor: RENTABILIDADES.map(r => getOpColor(r.operadoraId)),
              borderRadius: 4
            },
            {
              label: 'Tasa Real 12 Meses (Corto Plazo)',
              data: RENTABILIDADES.map(r => r.rentabilidadReal12m),
              backgroundColor: '#94a3b8',
              borderRadius: 4
            }
          ]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          scales: {
            y: { ticks: { callback: (val) => `${Number(val).toFixed(1)}%`, font: { weight: 'bold' } } }
          },
          plugins: { legend: { position: 'bottom' } }
        }
      });

    } else {
      // Comparativo Real vs Nominal por Horizonte
      methodologyNote.textContent = `Rentabilidad anualizada al horizonte ${horizonte === '10a' ? '10 años' : horizonte.toUpperCase()}.`;
      const labels = RENTABILIDADES.map(r => getOpNombreCorto(r.operadoraId));
      const dataReales = RENTABILIDADES.map(r => {
        if (horizonte === '36m') return r.rentabilidadReal36m;
        if (horizonte === '60m') return r.rentabilidadReal60m;
        if (horizonte === '10a') return r.rentabilidadReal10a;
        return r.rentabilidadReal12m;
      });
      const dataNominales = RENTABILIDADES.map(r => {
        if (horizonte === '36m') return r.rentabilidadNominal36m;
        if (horizonte === '60m') return r.rentabilidadNominal60m;
        if (horizonte === '10a') return r.rentabilidadNominal60m + 0.3;
        return r.rentabilidadNominal12m;
      });

      chartInstance = new Chart(canvas, {
        type: 'bar',
        data: {
          labels,
          datasets: [
            {
              label: `Tasa Real (${horizonte.toUpperCase()})`,
              data: dataReales,
              backgroundColor: RENTABILIDADES.map(r => getOpColor(r.operadoraId)),
              borderRadius: 4
            },
            {
              label: `Tasa Nominal (${horizonte.toUpperCase()})`,
              data: dataNominales,
              backgroundColor: '#94a3b8',
              borderRadius: 4
            }
          ]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          scales: {
            y: { ticks: { callback: (val) => `${Number(val).toFixed(1)}%`, font: { weight: 'bold' } } }
          },
          plugins: { legend: { position: 'bottom' } }
        }
      });
    }

    // KPIs dinámicos para Rendimiento
    const top12m = Math.max(...RENTABILIDADES.map(r => r.rentabilidadReal12m));
    const top10a = Math.max(...RENTABILIDADES.map(r => r.rentabilidadReal10a));
    const avg12m = RENTABILIDADES.reduce((a, b) => a + b.rentabilidadReal12m, 0) / RENTABILIDADES.length;

    kpisGrid.innerHTML = `
      <div class="bg-white border border-slate-200 p-3.5 rounded-2xl shadow-xs">
        <span class="text-[10px] font-bold text-slate-500 uppercase tracking-wider block">Mayor Tasa Real 12m</span>
        <strong class="text-base sm:text-lg font-black text-emerald-700">${top12m.toFixed(2)}%</strong>
        <span class="text-[11px] text-slate-500 block">Líder del mercado</span>
      </div>
      <div class="bg-white border border-slate-200 p-3.5 rounded-2xl shadow-xs">
        <span class="text-[10px] font-bold text-slate-500 uppercase tracking-wider block">Mayor Tasa Real 10a</span>
        <strong class="text-base sm:text-lg font-black text-blue-600">${top10a.toFixed(2)}%</strong>
        <span class="text-[11px] text-slate-500 block">Consistencia decenal</span>
      </div>
      <div class="bg-white border border-slate-200 p-3.5 rounded-2xl shadow-xs">
        <span class="text-[10px] font-bold text-slate-500 uppercase tracking-wider block">Promedio Sistema (12m)</span>
        <strong class="text-base sm:text-lg font-black text-[#0A2540]">${avg12m.toFixed(2)}%</strong>
        <span class="text-[11px] text-slate-500 block">Media aritmética OPCs</span>
      </div>
      <div class="bg-white border border-slate-200 p-3.5 rounded-2xl shadow-xs">
        <span class="text-[10px] font-bold text-slate-500 uppercase tracking-wider block">Tope Comisión</span>
        <strong class="text-base sm:text-lg font-black text-slate-900">0.35%</strong>
        <span class="text-[11px] text-slate-500 block">Regulación CONASSIF</span>
      </div>
    `;

    tableContainer.innerHTML = `
      <table class="w-full text-left font-mono text-[11px]">
        <thead>
          <tr class="border-b border-slate-200 text-slate-600 font-sans font-bold">
            <th class="py-2 px-3">Operadora</th>
            <th class="py-2 px-3">Real 12m</th>
            <th class="py-2 px-3">Real 36m</th>
            <th class="py-2 px-3">Real 60m</th>
            <th class="py-2 px-3">Real 10a</th>
            <th class="py-2 px-3">Nominal 12m</th>
            <th class="py-2 px-3">Comisión</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          ${RENTABILIDADES.map(r => `
            <tr class="hover:bg-slate-50">
              <td class="py-1.5 px-3 font-bold text-slate-900">${r.nombre}</td>
              <td class="py-1.5 px-3 font-bold text-emerald-700">${r.rentabilidadReal12m.toFixed(2)}%</td>
              <td class="py-1.5 px-3 text-slate-700">${r.rentabilidadReal36m.toFixed(2)}%</td>
