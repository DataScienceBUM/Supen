        <span class="text-[11px] text-slate-500 block">Personas jubiladas</span>
      </div>
      <div class="bg-white border border-slate-200 p-3.5 rounded-2xl shadow-xs">
        <span class="text-[10px] font-bold text-slate-500 uppercase tracking-wider block">Monto Mensual Pagado</span>
        <strong class="text-base sm:text-lg font-black text-emerald-700">${formatColones(totalDesembolsado, true)}</strong>
        <span class="text-[11px] text-slate-500 block">Flujo mensual de retiro</span>
      </div>
      <div class="bg-white border border-slate-200 p-3.5 rounded-2xl shadow-xs">
        <span class="text-[10px] font-bold text-slate-500 uppercase tracking-wider block">Modalidad Predominante</span>
        <strong class="text-base sm:text-lg font-black text-blue-900">Renta Permanente</strong>
        <span class="text-[11px] text-slate-500 block">48.5% eligen esta opción</span>
      </div>
      <div class="bg-white border border-slate-200 p-3.5 rounded-2xl shadow-xs">
