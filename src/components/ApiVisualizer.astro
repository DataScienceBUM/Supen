          />
          <text x="${groupX + barGroupW/2}" y="${y - 8}" font-size="11" font-weight="800" fill="${color}" text-anchor="middle">${formatNumero(val)} pers.</text>
          <text x="${groupX + barGroupW/2}" y="${height - paddingY + 20}" font-size="11" font-weight="700" fill="#1e293b" text-anchor="middle">
            ${b.modalidad.split(' ')[0]}
