          />
          <text x="${groupX + barGroupW/2 - barW/2 - 2}" y="${yP - 6}" font-size="10" font-weight="800" fill="#0284c7" text-anchor="middle">${pctPers.toFixed(0)}%</text>
          <text x="${groupX + barGroupW/2 + barW/2 + 2}" y="${yM - 6}" font-size="10" font-weight="800" fill="#047857" text-anchor="middle">${pctMonto.toFixed(0)}%</text>
