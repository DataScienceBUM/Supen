        <div class="flex items-center gap-2"><span class="w-3.5 h-3.5 rounded bg-emerald-500 inline-block"></span><span class="font-medium">Ahorro anual directo de ₡75.000 por cada ₡10M administrados</span></div>
      `;

    } else {
      // Línea Histórica del Tope Legal
      methodologyNote.textContent = 'Evolución del tope legal de comisión anual sobre saldo establecido por CONASSIF mediante reducciones escalonadas.';
      const maxVal = 1.30;
      const years = HISTORICO_COMISIONES.map(h => h.año);
      const minYear = Math.min(...years);
      const maxYear = Math.max(...years);

      for (let v = 0; v <= 1.2; v += 0.3) {
        const y = height - paddingY - (v / maxVal) * chartHeight;
        svgInner += `
          <line x1="${paddingX}" y1="${y}" x2="${width - paddingX}" y2="${y}" stroke="#e2e8f0" stroke-width="1" stroke-dasharray="3,3" />
          <text x="${paddingX - 15}" y="${y + 4}" font-size="11" font-weight="600" fill="#64748b" text-anchor="end">${v.toFixed(2)}%</text>
        `;
      }

      const points = HISTORICO_COMISIONES.map(h => {
        const x = paddingX + ((h.año - minYear) / (maxYear - minYear)) * chartWidth;
        const y = height - paddingY - (h.topeNormativo / maxVal) * chartHeight;
        return { x, y, ...h };
      });

      let pathD = `M ${points[0].x} ${points[0].y}`;
      let areaD = `M ${points[0].x} ${height - paddingY} L ${points[0].x} ${points[0].y}`;
      for (let i = 1; i < points.length; i++) {
        pathD += ` L ${points[i].x} ${points[i].y}`;
        areaD += ` L ${points[i].x} ${points[i].y}`;
      }
      areaD += ` L ${points[points.length - 1].x} ${height - paddingY} Z`;

      svgInner += `
        <defs>
          <linearGradient id="comisionGrad" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#0284c7" stop-opacity="0.25" />
            <stop offset="100%" stop-color="#0284c7" stop-opacity="0.0" />
          </linearGradient>
        </defs>
        <path d="${areaD}" fill="url(#comisionGrad)" />
        <path d="${pathD}" fill="none" stroke="#0284c7" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" />
      `;

      points.forEach(p => {
        svgInner += `
          <line x1="${p.x}" y1="${p.y}" x2="${p.x}" y2="${height - paddingY}" stroke="#cbd5e1" stroke-width="1" stroke-dasharray="2,2" />
          <circle
            class="chart-elem cursor-pointer transition-transform hover:scale-125"
            cx="${p.x}"
            cy="${p.y}"
            r="6"
            fill="#0A2540"
            stroke="#ffffff"
            stroke-width="2.5"
            data-tooltip-title="Año ${p.año}"
            data-tooltip-rows='[{"label":"Tope Normativo","value":"${p.topeNormativo.toFixed(2)}%","color":"#0284c7"},{"label":"Comisión Efectiva","value":"${p.comisionPromedio.toFixed(2)}%"},{"label":"Hito Legal","value":"${p.evento.slice(0, 35)}..."}]'
          />
          <text x="${p.x}" y="${p.y - 12}" font-size="11" font-weight="800" fill="#0A2540" text-anchor="middle">${p.topeNormativo.toFixed(2)}%</text>
          <text x="${p.x}" y="${height - paddingY + 20}" font-size="11" font-weight="700" fill="#475569" text-anchor="middle">${p.año}</text>
        `;
      });

      legendContainer.innerHTML = `<div class="flex items-center gap-2"><span class="w-3.5 h-3.5 rounded bg-[#0284c7] inline-block"></span><span>Tope legal escalonado de comisión anual sobre saldo (CONASSIF)</span></div>`;
    }

    svg.innerHTML = svgInner;

    kpisGrid.innerHTML = `
      <div class="bg-white border border-slate-200 p-3.5 rounded-2xl shadow-xs">
        <span class="text-[10px] font-bold text-slate-500 uppercase tracking-wider block">Tope Vigente</span>
        <strong class="text-base sm:text-lg font-black text-emerald-700">0.35% Anual</strong>
        <span class="text-[11px] text-slate-600 block">Cobro exclusivo sobre saldo</span>
      </div>
      <div class="bg-white border border-slate-200 p-3.5 rounded-2xl shadow-xs">
        <span class="text-[10px] font-bold text-slate-500 uppercase tracking-wider block">Reducción Histórica</span>
        <strong class="text-base sm:text-lg font-black text-[#0A2540]">-68.2%</strong>
        <span class="text-[11px] text-slate-500 block">De 1.10% a 0.35%</span>
      </div>
      <div class="bg-white border border-slate-200 p-3.5 rounded-2xl shadow-xs">
        <span class="text-[10px] font-bold text-slate-500 uppercase tracking-wider block">Ahorro para Afiliado</span>
        <strong class="text-base sm:text-lg font-black text-blue-900">+15.9% de saldo</strong>
        <span class="text-[11px] text-slate-500 block">A 35 años de carrera</span>
      </div>
      <div class="bg-white border border-slate-200 p-3.5 rounded-2xl shadow-xs">
        <span class="text-[10px] font-bold text-slate-500 uppercase tracking-wider block">Base Imponible</span>
        <strong class="text-base sm:text-lg font-black text-slate-800">Saldo Total</strong>
        <span class="text-[11px] text-slate-500 block">Cero cobro sobre aportes</span>
      </div>
    `;

    tableContainer.innerHTML = `
      <table class="w-full text-left font-mono text-[11px]">
        <thead>
          <tr class="border-b border-slate-200 text-slate-600 font-sans font-bold">
            <th class="py-2 px-3">Año</th>
            <th class="py-2 px-3">Tope Normativo</th>
            <th class="py-2 px-3">Comisión Promedio</th>
            <th class="py-2 px-3">Hito Regulatorio</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          ${HISTORICO_COMISIONES.map(h => `
            <tr>
              <td class="py-2 px-3 font-sans font-bold text-slate-900">${h.año}</td>
              <td class="py-2 px-3 text-blue-800 font-bold">${h.topeNormativo.toFixed(2)}%</td>
              <td class="py-2 px-3 text-slate-700">${h.comisionPromedio.toFixed(2)}%</td>
              <td class="py-2 px-3 font-sans text-slate-600">${h.evento}</td>
            </tr>
          `).join('')}
        </tbody>
      </table>
    `;
  }

  // ==========================================
  // RENDERER 2: /portafolio (4 Gráficos)
  // 1. Asignación Sectorial Macro
  // 2. Exposición por Moneda (Colones vs Dólares) por OPC
  // 3. Distribución por Tipo de Instrumento
  // 4. Estructura de Plazos / Maduración
  // ==========================================
  function renderPortafolio() {
    const { vista, unidad } = state.portafolio;

    controlsContainer.innerHTML = `
      <div class="inline-flex rounded-lg border border-slate-200 bg-white p-0.5 text-xs">
        <button type="button" class="ctrl-btn px-2.5 py-1 rounded-md font-bold transition-colors ${vista === 'macro' ? 'bg-[#0A2540] text-white' : 'text-slate-600'}" data-ctrl="portafolioVista" data-val="macro">Sectores Macro</button>
        <button type="button" class="ctrl-btn px-2.5 py-1 rounded-md font-bold transition-colors ${vista === 'moneda' ? 'bg-[#0A2540] text-white' : 'text-slate-600'}" data-ctrl="portafolioVista" data-val="moneda">Moneda (CRC vs USD)</button>
        <button type="button" class="ctrl-btn px-2.5 py-1 rounded-md font-bold transition-colors ${vista === 'instrumento' ? 'bg-[#0A2540] text-white' : 'text-slate-600'}" data-ctrl="portafolioVista" data-val="instrumento">Tipo Instrumento</button>
        <button type="button" class="ctrl-btn px-2.5 py-1 rounded-md font-bold transition-colors ${vista === 'plazos' ? 'bg-[#0A2540] text-white' : 'text-slate-600'}" data-ctrl="portafolioVista" data-val="plazos">Estructura Plazos</button>
      </div>
      ${vista === 'macro' ? `
        <div class="inline-flex rounded-lg border border-slate-200 bg-white p-0.5 text-xs">
          <button type="button" class="ctrl-btn px-2 py-1 rounded-md font-bold transition-colors ${unidad === 'crc' ? 'bg-blue-600 text-white' : 'text-slate-600'}" data-ctrl="unidad" data-val="crc">Colones (₡)</button>
          <button type="button" class="ctrl-btn px-2 py-1 rounded-md font-bold transition-colors ${unidad === 'usd' ? 'bg-blue-600 text-white' : 'text-slate-600'}" data-ctrl="unidad" data-val="usd">USD ($)</button>
          <button type="button" class="ctrl-btn px-2 py-1 rounded-md font-bold transition-colors ${unidad === 'pct' ? 'bg-blue-600 text-white' : 'text-slate-600'}" data-ctrl="unidad" data-val="pct">%</button>
        </div>
      ` : ''}
    `;

    const paddingX = 90;
    const paddingY = 40;
    const width = 860;
    const height = 380;
    const chartWidth = width - paddingX * 2;
    const chartHeight = height - paddingY * 2 - 20;

    let svgInner = '';

    if (vista === 'moneda') {
      methodologyNote.textContent = 'Exposición cambiaria fiduciaria: Asignación entre colones (₡) y moneda extranjera (USD) para cada operadora. La normativa CONASSIF limita la inversión internacional a un 50%.';
      const opcMoneda = [
        { opc: 'Popular', crc: 73.5, usd: 26.5 },
        { opc: 'BN Vital', crc: 71.0, usd: 29.0 },
        { opc: 'BCR', crc: 72.4, usd: 27.6 },
        { opc: 'BAC', crc: 64.8, usd: 35.2 },
        { opc: 'CCSS', crc: 76.5, usd: 23.5 },
        { opc: 'Vida Plena', crc: 70.2, usd: 29.8 }
      ];

      for (let v = 0; v <= 100; v += 20) {
        const y = height - paddingY - (v / 100) * chartHeight;
        svgInner += `
          <line x1="${paddingX}" y1="${y}" x2="${width - paddingX}" y2="${y}" stroke="#e2e8f0" stroke-width="1" stroke-dasharray="3,3" />
          <text x="${paddingX - 15}" y="${y + 4}" font-size="11" font-weight="600" fill="#64748b" text-anchor="end">${v}%</text>
        `;
      }

      const barGroupW = chartWidth / opcMoneda.length;
      opcMoneda.forEach((item, idx) => {
        const groupX = paddingX + idx * barGroupW;
        const barW = Math.min(46, barGroupW * 0.6);

        const hCrc = (item.crc / 100) * chartHeight;
        const yCrc = height - paddingY - hCrc;
        const hUsd = (item.usd / 100) * chartHeight;
        const yUsd = yCrc - hUsd;

        svgInner += `
          <rect
            class="chart-elem cursor-pointer transition-all hover:opacity-85"
            x="${groupX + (barGroupW - barW)/2}"
            y="${yCrc}"
            width="${barW}"
            height="${hCrc}"
            fill="#0284c7"
            rx="2"
            data-tooltip-title="${item.opc} (Colones)"
            data-tooltip-rows='[{"label":"Colones (₡)","value":"${item.crc.toFixed(1)}%","color":"#0284c7"},{"label":"Moneda local","value":"Cobertura pasivos locales"}]'
          />
          <rect
            class="chart-elem cursor-pointer transition-all hover:opacity-85"
            x="${groupX + (barGroupW - barW)/2}"
            y="${yUsd}"
            width="${barW}"
            height="${hUsd}"
            fill="#10b981"
            rx="2"
            data-tooltip-title="${item.opc} (Dólares)"
            data-tooltip-rows='[{"label":"Dólares (USD)","value":"${item.usd.toFixed(1)}%","color":"#10b981"},{"label":"Moneda Extranjera","value":"Diversificación internacional"}]'
          />
          <text x="${groupX + barGroupW/2}" y="${yCrc + hCrc/2 + 4}" font-size="10" font-weight="800" fill="#ffffff" text-anchor="middle">${item.crc.toFixed(0)}%</text>
          <text x="${groupX + barGroupW/2}" y="${yUsd + hUsd/2 + 4}" font-size="10" font-weight="800" fill="#ffffff" text-anchor="middle">${item.usd.toFixed(0)}%</text>
          <text x="${groupX + barGroupW/2}" y="${height - paddingY + 20}" font-size="11" font-weight="700" fill="#1e293b" text-anchor="middle">${item.opc}</text>
        `;
      });

      legendContainer.innerHTML = `
        <div class="flex items-center gap-1.5"><span class="w-3.5 h-3.5 rounded bg-sky-600 inline-block"></span><span class="font-medium">Colones Costarricenses (₡) ~ 71.5% Sistema</span></div>
        <div class="flex items-center gap-1.5"><span class="w-3.5 h-3.5 rounded bg-emerald-500 inline-block"></span><span class="font-medium">Dólares Estadounidenses (USD) ~ 28.5% Sistema</span></div>
      `;

    } else if (vista === 'instrumento') {
      methodologyNote.textContent = 'Distribución del portafolio consolidado del ROP según tipo de instrumento financiero.';
      const instrumentos = [
        { tipo: 'Deuda Soberana Hacienda', pct: 54.2, montoCRC: 14878000000000, color: '#0284c7' },
        { tipo: 'ETFs y Acciones Internacionales', pct: 18.6, montoCRC: 5105000000000, color: '#10b981' },
        { tipo: 'Bonos Financieros Locales', pct: 11.4, montoCRC: 3129000000000, color: '#6366f1' },
        { tipo: 'Deuda BCCR / Sector Público', pct: 6.8, montoCRC: 1866000000000, color: '#f59e0b' },
        { tipo: 'Fondos de Inversión y Titularización', pct: 5.2, montoCRC: 1427000000000, color: '#ec4899' },
        { tipo: 'Depósitos a Plazo Bancarios', pct: 3.8, montoCRC: 1043000000000, color: '#8b5cf6' }
      ];

      const barH = 30;
      const gap = 16;
      const startY = 35;

      svgInner += `<line x1="${paddingX + 210}" y1="${startY - 10}" x2="${paddingX + 210}" y2="${startY + instrumentos.length * (barH + gap)}" stroke="#94a3b8" stroke-width="1.5" />`;

      instrumentos.forEach((inst, idx) => {
        const y = startY + idx * (barH + gap);
        const maxBarW = chartWidth - 230;
        const barW = (inst.pct / 60) * maxBarW;

        svgInner += `
          <text x="${paddingX + 200}" y="${y + barH/2 + 4}" font-size="11" font-weight="700" fill="#1e293b" text-anchor="end">${inst.tipo}</text>
          <rect
            class="chart-elem cursor-pointer transition-all hover:opacity-85"
            x="${paddingX + 210}"
            y="${y}"
            width="${barW}"
            height="${barH}"
            fill="${inst.color}"
            rx="4"
            data-tooltip-title="${inst.tipo}"
            data-tooltip-rows='[{"label":"Porcentaje","value":"${inst.pct.toFixed(1)}%","color":"${inst.color}"},{"label":"Monto","value":"${formatColones(inst.montoCRC, true)}"}]'
          />
          <text x="${paddingX + 220 + barW}" y="${y + barH/2 + 4}" font-size="11" font-weight="800" fill="${inst.color}">${inst.pct.toFixed(1)}% (${formatColones(inst.montoCRC, true)})</text>
        `;
      });

      legendContainer.innerHTML = `<div class="flex items-center gap-2"><span class="w-3.5 h-3.5 rounded bg-sky-600 inline-block"></span><span>Más del 54% concentrado en títulos de deuda pública del Gobierno Central</span></div>`;

    } else if (vista === 'plazos') {
      methodologyNote.textContent = 'Estructura de plazos al vencimiento y duración ponderada de los activos del ROP (Duración media: 6.8 años).';
      const plazos = [
        { plazo: '< 1 Año (Corto)', pct: 4.8, montoCRC: 1317000000000, color: '#94a3b8' },
        { plazo: '1 a 3 Años', pct: 14.5, montoCRC: 3980000000000, color: '#38bdf8' },
        { plazo: '3 a 5 Años', pct: 22.1, montoCRC: 6066000000000, color: '#0284c7' },
        { plazo: '5 a 10 Años', pct: 38.2, montoCRC: 10486000000000, color: '#0369a1' },
        { plazo: '> 10 Años (Largo)', pct: 20.4, montoCRC: 5600000000000, color: '#0c4a6e' }
      ];

      for (let v = 0; v <= 40; v += 10) {
        const y = height - paddingY - (v / 40) * chartHeight;
        svgInner += `
          <line x1="${paddingX}" y1="${y}" x2="${width - paddingX}" y2="${y}" stroke="#e2e8f0" stroke-width="1" stroke-dasharray="3,3" />
          <text x="${paddingX - 15}" y="${y + 4}" font-size="11" font-weight="600" fill="#64748b" text-anchor="end">${v}%</text>
        `;
      }

      const barGroupW = chartWidth / plazos.length;
      plazos.forEach((p, idx) => {
        const groupX = paddingX + idx * barGroupW;
        const barW = Math.min(55, barGroupW * 0.65);
        const h = (p.pct / 40) * chartHeight;
        const y = height - paddingY - h;

        svgInner += `
          <rect
            class="chart-elem cursor-pointer transition-all hover:opacity-85"
            x="${groupX + (barGroupW - barW)/2}"
            y="${y}"
            width="${barW}"
            height="${h}"
            fill="${p.color}"
            rx="5"
            data-tooltip-title="${p.plazo}"
            data-tooltip-rows='[{"label":"Porcentaje","value":"${p.pct.toFixed(1)}%","color":"${p.color}"},{"label":"Monto","value":"${formatColones(p.montoCRC, true)}"}]'
          />
          <text x="${groupX + barGroupW/2}" y="${y - 8}" font-size="11" font-weight="800" fill="${p.color}" text-anchor="middle">${p.pct.toFixed(1)}%</text>
          <text x="${groupX + barGroupW/2}" y="${height - paddingY + 20}" font-size="11" font-weight="700" fill="#1e293b" text-anchor="middle">${p.plazo.split(' ')[0]}</text>
          <text x="${groupX + barGroupW/2}" y="${height - paddingY + 34}" font-size="9" font-weight="500" fill="#64748b" text-anchor="middle">${p.plazo.split(' ').slice(1).join(' ')}</text>
        `;
      });

      legendContainer.innerHTML = `
        <div class="flex items-center gap-1.5"><span class="w-3.5 h-3.5 rounded bg-[#0369a1] inline-block"></span><span class="font-medium">El 58.6% de las inversiones maduran a más de 5 años plazo</span></div>
      `;

    } else {
      // Macro Categorías
      methodologyNote.textContent = 'Asignación agregada por sector institucional. La deuda del Ministerio de Hacienda representa la mayor concentración de cartera del ROP.';
      let maxVal = 70;
      if (unidad === 'crc') maxVal = 10;
      if (unidad === 'usd') maxVal = 18;

      for (let i = 0; i <= 4; i++) {
        const v = (maxVal / 4) * i;
        const y = height - paddingY - (i / 4) * chartHeight;
        let label = `${v.toFixed(0)}%`;
        if (unidad === 'crc') label = `₡ ${v.toFixed(0)} B`;
        if (unidad === 'usd') label = `$ ${v.toFixed(0)} B`;

        svgInner += `
          <line x1="${paddingX}" y1="${y}" x2="${width - paddingX}" y2="${y}" stroke="#e2e8f0" stroke-width="1" stroke-dasharray="3,3" />
          <text x="${paddingX - 15}" y="${y + 4}" font-size="11" font-weight="600" fill="#64748b" text-anchor="end">${label}</text>
        `;
      }

      const barGroupW = chartWidth / PORTAFOLIO_MACRO.length;
      PORTAFOLIO_MACRO.forEach((item, i) => {
        const groupX = paddingX + i * barGroupW;
        const barW = Math.min(65, barGroupW * 0.65);

        let val = item.porcentaje;
        let displayVal = `${item.porcentaje.toFixed(1)}%`;
        if (unidad === 'crc') {
          val = item.montoCRC / 1_000_000_000_000;
          displayVal = `₡ ${(val).toFixed(2)} B`;
        } else if (unidad === 'usd') {
          val = item.montoUSD / 1_000_000_000;
          displayVal = `$ ${(val).toFixed(2)} B`;
        }

        const h = (val / maxVal) * chartHeight;
        const y = height - paddingY - h;

        svgInner += `
          <rect
            class="chart-elem cursor-pointer transition-all duration-300 hover:opacity-85"
            x="${groupX + (barGroupW - barW)/2}"
            y="${y}"
            width="${barW}"
            height="${h}"
            fill="${item.color}"
            rx="6"
            data-tooltip-title="${item.categoria}"
            data-tooltip-rows='[{"label":"Porcentaje","value":"${item.porcentaje.toFixed(1)}%","color":"${item.color}"},{"label":"Monto CRC","value":"${formatColones(item.montoCRC, true)}"},{"label":"Monto USD","value":"${formatDolares(item.montoUSD, true)}"}]'
          />
          <text x="${groupX + barGroupW/2}" y="${y - 8}" font-size="11" font-weight="800" fill="${item.color}" text-anchor="middle">${displayVal}</text>
          <text x="${groupX + barGroupW/2}" y="${height - paddingY + 20}" font-size="11" font-weight="700" fill="#1e293b" text-anchor="middle">
            ${item.categoria.split(' ')[0]}
          </text>
          <text x="${groupX + barGroupW/2}" y="${height - paddingY + 34}" font-size="9" font-weight="500" fill="#64748b" text-anchor="middle">
            ${item.categoria.split(' ').slice(1, 3).join(' ')}
          </text>
        `;
      });

      legendContainer.innerHTML = PORTAFOLIO_MACRO.map(p => `
        <div class="flex items-center gap-1.5">
          <span class="w-3 h-3 rounded" style="background-color: ${p.color}"></span>
          <span class="font-medium">${p.categoria.split('(')[0]} (${p.porcentaje}%)</span>
        </div>
      `).join('');
    }

    svg.innerHTML = svgInner;

    const totalCRC = PORTAFOLIO_MACRO.reduce((acc, p) => acc + p.montoCRC, 0);
    kpisGrid.innerHTML = `
      <div class="bg-white border border-slate-200 p-3.5 rounded-2xl shadow-xs">
        <span class="text-[10px] font-bold text-slate-500 uppercase tracking-wider block">Deuda Soberana (Hacienda)</span>
        <strong class="text-base sm:text-lg font-black text-sky-800">58.4%</strong>
        <span class="text-[11px] text-slate-500 block">Concentración fiscal</span>
      </div>
      <div class="bg-white border border-slate-200 p-3.5 rounded-2xl shadow-xs">
        <span class="text-[10px] font-bold text-slate-500 uppercase tracking-wider block">Inversión Exterior (ETFs)</span>
        <strong class="text-base sm:text-lg font-black text-emerald-700">21.2%</strong>
        <span class="text-[11px] text-slate-500 block">Diversificación global</span>
      </div>
      <div class="bg-white border border-slate-200 p-3.5 rounded-2xl shadow-xs">
        <span class="text-[10px] font-bold text-slate-500 uppercase tracking-wider block">Activos Totales ROP</span>
        <strong class="text-base sm:text-lg font-black text-[#0A2540]">${formatColones(totalCRC, true)}</strong>
        <span class="text-[11px] text-slate-500 block">~ 29.4% del PIB</span>
      </div>
      <div class="bg-white border border-slate-200 p-3.5 rounded-2xl shadow-xs">
        <span class="text-[10px] font-bold text-slate-500 uppercase tracking-wider block">Moneda Extranjera</span>
        <strong class="text-base sm:text-lg font-black text-indigo-900">~ 28.5%</strong>
        <span class="text-[11px] text-slate-500 block">Exposición cambiaria USD</span>
      </div>
    `;

    tableContainer.innerHTML = `
      <table class="w-full text-left font-mono text-[11px]">
        <thead>
          <tr class="border-b border-slate-200 text-slate-600 font-sans font-bold">
            <th class="py-2 px-3">Categoría de Portafolio</th>
            <th class="py-2 px-3">Monto en Colones</th>
            <th class="py-2 px-3">Monto en Dólares</th>
            <th class="py-2 px-3">Porcentaje (%)</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          ${PORTAFOLIO_MACRO.map(p => `
            <tr>
              <td class="py-2 px-3 font-sans font-bold text-slate-900">${p.categoria}</td>
              <td class="py-2 px-3 text-[#0A2540] font-bold">${formatColones(p.montoCRC, true)}</td>
              <td class="py-2 px-3 text-slate-700">${formatDolares(p.montoUSD, true)}</td>
              <td class="py-2 px-3 text-emerald-800 font-bold">${p.porcentaje.toFixed(1)}%</td>
            </tr>
          `).join('')}
        </tbody>
      </table>
    `;
  }

  // ==========================================
  // RENDERER 3: /portafolioISIN (4 Gráficos)
  // 1. Tenencia por Operadora del Título Seleccionado
  // 2. Top 5 Emisiones en Custodia del ROP
  // 3. Comparador Tasa Cupón vs Plazo
  // 4. Participación del ROP en la Emisión Total
  // ==========================================
  function renderPortafolioISIN() {
    const { vista, isinIdx } = state.portafolioISIN;
    const titulo = TITULOS_ISIN_DESTACADOS[isinIdx];

    controlsContainer.innerHTML = `
      <div class="inline-flex rounded-lg border border-slate-200 bg-white p-0.5 text-xs">
        <button type="button" class="ctrl-btn px-2.5 py-1 rounded-md font-bold transition-colors ${vista === 'tenencia' ? 'bg-[#0A2540] text-white' : 'text-slate-600'}" data-ctrl="isinVista" data-val="tenencia">Tenencia por OPC</button>
        <button type="button" class="ctrl-btn px-2.5 py-1 rounded-md font-bold transition-colors ${vista === 'topEmisiones' ? 'bg-[#0A2540] text-white' : 'text-slate-600'}" data-ctrl="isinVista" data-val="topEmisiones">Top 5 Títulos ROP</button>
        <button type="button" class="ctrl-btn px-2.5 py-1 rounded-md font-bold transition-colors ${vista === 'cupones' ? 'bg-[#0A2540] text-white' : 'text-slate-600'}" data-ctrl="isinVista" data-val="cupones">Cupón vs Plazo</button>
        <button type="button" class="ctrl-btn px-2.5 py-1 rounded-md font-bold transition-colors ${vista === 'participacion' ? 'bg-[#0A2540] text-white' : 'text-slate-600'}" data-ctrl="isinVista" data-val="participacion">Cuota Custodia ROP</button>
      </div>
      ${vista === 'tenencia' ? `
        <div class="inline-flex rounded-lg border border-slate-200 bg-white p-0.5 text-xs">
          ${TITULOS_ISIN_DESTACADOS.map((t, idx) => `
            <button type="button" class="ctrl-btn px-2 py-1 rounded-md font-bold transition-colors ${isinIdx === idx ? 'bg-blue-600 text-white' : 'text-slate-600'}" data-ctrl="isinIdx" data-val="${idx}">
              ${t.isin.slice(0, 6)}... (${t.moneda})
            </button>
          `).join('')}
        </div>
      ` : ''}
    `;

    const paddingX = 90;
    const paddingY = 40;
    const width = 860;
    const height = 380;
    const chartWidth = width - paddingX * 2;
    const chartHeight = height - paddingY * 2 - 20;

    let svgInner = '';

    if (vista === 'topEmisiones') {
      methodologyNote.textContent = 'Ranking de los 5 mayores títulos valores custodiados en el régimen obligatorio (ROP) por valor de mercado.';
      const topTítulos = [
        { isin: 'CRG0000B32A9', nombre: 'Hacienda Tasa Fija 2032', montoCRC: 1450000000000, tipo: 'Soberano CRC', color: '#0284c7' },
        { isin: 'CRG0000B40A3', nombre: 'Hacienda Tasa Fija 2040', montoCRC: 1180000000000, tipo: 'Soberano CRC', color: '#0369a1' },
        { isin: 'US78462F1030', nombre: 'SPDR S&P 500 ETF Trust', montoCRC: 980000000000, tipo: 'ETF Exterior USD', color: '#10b981' },
        { isin: 'CRF0000B28A1', nombre: 'Bono BCCR Estabilización 2028', montoCRC: 650000000000, tipo: 'Banco Central CRC', color: '#f59e0b' },
        { isin: 'US4642872000', nombre: 'iShares Core MSCI EAFE ETF', montoCRC: 540000000000, tipo: 'ETF Exterior USD', color: '#6366f1' }
      ];

      const barH = 34;
      const gap = 20;
      const startY = 45;

      svgInner += `<line x1="${paddingX + 220}" y1="${startY - 10}" x2="${paddingX + 220}" y2="${startY + topTítulos.length * (barH + gap)}" stroke="#94a3b8" stroke-width="1.5" />`;

      topTítulos.forEach((t, idx) => {
        const y = startY + idx * (barH + gap);
        const maxBarW = chartWidth - 240;
        const barW = (t.montoCRC / 1600000000000) * maxBarW;

        svgInner += `
          <text x="${paddingX + 210}" y="${y + barH/2 - 2}" font-size="11" font-weight="700" fill="#1e293b" text-anchor="end">${t.nombre}</text>
          <text x="${paddingX + 210}" y="${y + barH/2 + 12}" font-size="9" font-weight="600" fill="#64748b" text-anchor="end font-mono">${t.isin}</text>
          <rect
            class="chart-elem cursor-pointer transition-all hover:opacity-85"
            x="${paddingX + 220}"
            y="${y}"
            width="${barW}"
            height="${barH}"
            fill="${t.color}"
            rx="4"
            data-tooltip-title="${t.nombre}"
            data-tooltip-rows='[{"label":"Monto Custodiado","value":"${formatColones(t.montoCRC, true)}","color":"${t.color}"},{"label":"ISIN","value":"${t.isin}"},{"label":"Tipo","value":"${t.tipo}"}]'
          />
          <text x="${paddingX + 230 + barW}" y="${y + barH/2 + 4}" font-size="11" font-weight="800" fill="${t.color}">${formatColones(t.montoCRC, true)}</text>
        `;
