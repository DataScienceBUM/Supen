  // ==========================================
  // RENDERER 6: /Beneficio (4 Gráficos)
  // 1. Distribución de Beneficiarios por Modalidad
  // 2. Comparativa Dual: Personas vs Dinero Desembolsado
  // 3. Pensión Promedio Mensual Resultante en Colones
  // 4. Maduración Histórica de Beneficiarios (2016-2024)
  // ==========================================
  function renderBeneficio() {
    const { vista } = state.beneficio;

    controlsContainer.innerHTML = `
      <div class="inline-flex rounded-lg border border-slate-200 bg-white p-0.5 text-xs">
        <button type="button" class="ctrl-btn px-2.5 py-1 rounded-md font-bold transition-colors ${vista === 'modalidades' ? 'bg-[#0A2540] text-white' : 'text-slate-600'}" data-ctrl="beneficioVista" data-val="modalidades">Modalidades Retiro</button>
        <button type="button" class="ctrl-btn px-2.5 py-1 rounded-md font-bold transition-colors ${vista === 'dualidad' ? 'bg-[#0A2540] text-white' : 'text-slate-600'}" data-ctrl="beneficioVista" data-val="dualidad">Personas vs Montos (%)</button>
        <button type="button" class="ctrl-btn px-2.5 py-1 rounded-md font-bold transition-colors ${vista === 'pensionMedia' ? 'bg-[#0A2540] text-white' : 'text-slate-600'}" data-ctrl="beneficioVista" data-val="pensionMedia">Pensión Promedio (₡)</button>
        <button type="button" class="ctrl-btn px-2.5 py-1 rounded-md font-bold transition-colors ${vista === 'evolucion' ? 'bg-[#0A2540] text-white' : 'text-slate-600'}" data-ctrl="beneficioVista" data-val="evolucion">Maduración ROP (2016-24)</button>
      </div>
    `;

    const paddingX = 90;
    const paddingY = 40;
    const width = 860;
    const height = 380;
    const chartWidth = width - paddingX * 2;
    const chartHeight = height - paddingY * 2 - 20;

    let svgInner = '';
    const colors = ['#0284c7', '#10b981', '#f59e0b', '#6366f1'];

    if (vista === 'dualidad') {
      methodologyNote.textContent = 'Comparativa de concentración fiduciaria: % de beneficiarios que eligen cada modalidad frente al % del dinero total mensual desembolsado.';
      for (let v = 0; v <= 60; v += 15) {
        const y = height - paddingY - (v / 60) * chartHeight;
        svgInner += `
          <line x1="${paddingX}" y1="${y}" x2="${width - paddingX}" y2="${y}" stroke="#e2e8f0" stroke-width="1" stroke-dasharray="3,3" />
          <text x="${paddingX - 15}" y="${y + 4}" font-size="11" font-weight="600" fill="#64748b" text-anchor="end">${v}%</text>
        `;
      }

      const totalCRC = BENEFICIOS_RETIROS.reduce((a, b) => a + b.montoTotalCRC, 0);
      const totalPers = BENEFICIOS_RETIROS.reduce((a, b) => a + b.cantidadBeneficiarios, 0);

      const barGroupW = chartWidth / BENEFICIOS_RETIROS.length;
      BENEFICIOS_RETIROS.forEach((b, idx) => {
        const groupX = paddingX + idx * barGroupW;
        const barW = Math.min(32, barGroupW * 0.38);

        const pctPers = (b.cantidadBeneficiarios / totalPers) * 100;
        const pctMonto = (b.montoTotalCRC / totalCRC) * 100;

        const hP = (pctPers / 60) * chartHeight;
        const yP = height - paddingY - hP;
        const hM = (pctMonto / 60) * chartHeight;
        const yM = height - paddingY - hM;

        svgInner += `
          <rect
            class="chart-elem cursor-pointer transition-all hover:opacity-85"
            x="${groupX + barGroupW/2 - barW - 2}"
            y="${yP}"
            width="${barW}"
            height="${hP}"
            fill="#0284c7"
            rx="4"
            data-tooltip-title="${b.modalidad} (% Personas)"
            data-tooltip-rows='[{"label":"Porcentaje Beneficiarios","value":"${pctPers.toFixed(1)}%","color":"#0284c7"}]'
          />
          <rect
            class="chart-elem cursor-pointer transition-all hover:opacity-85"
            x="${groupX + barGroupW/2 + 2}"
            y="${yM}"
            width="${barW}"
            height="${hM}"
