            data-tooltip-rows='[{"label":"Pensionados Totales","value":"${formatNumero(p.pensionados)} pers.","color":"#10b981"}]'
          />
          <text x="${p.x}" y="${p.y - 12}" font-size="11" font-weight="800" fill="#0A2540" text-anchor="middle">${(p.pensionados / 1000).toFixed(1)}k</text>
          <text x="${p.x}" y="${height - paddingY + 20}" font-size="11" font-weight="700" fill="#475569" text-anchor="middle">${p.año}</text>
        `;
      });

      legendContainer.innerHTML = `<div class="flex items-center gap-2"><span class="w-3.5 h-3.5 rounded bg-emerald-500 inline-block"></span><span>85.000 personas jubiladas activas en el ROP al cierre 2024</span></div>`;

    } else {
      // Modalidades Clásicas
      methodologyNote.textContent = 'Modalidades legales de pensión bajo Ley 7983 y Ley 9906. Renta Permanente preserva el capital, mientras que Retiro Programado agota el saldo según expectativa de vida.';
      const maxVal = 50000;
      for (let i = 0; i <= 4; i++) {
        const v = (maxVal / 4) * i;
        const y = height - paddingY - (i / 4) * chartHeight;
        svgInner += `
          <line x1="${paddingX}" y1="${y}" x2="${width - paddingX}" y2="${y}" stroke="#e2e8f0" stroke-width="1" stroke-dasharray="3,3" />
          <text x="${paddingX - 15}" y="${y + 4}" font-size="11" font-weight="600" fill="#64748b" text-anchor="end">${(v / 1000).toFixed(0)}k</text>
        `;
      }

      const barGroupW = chartWidth / BENEFICIOS_RETIROS.length;
      BENEFICIOS_RETIROS.forEach((b, idx) => {
        const groupX = paddingX + idx * barGroupW;
        const barW = Math.min(65, barGroupW * 0.65);
        const color = colors[idx % colors.length];
        const val = b.cantidadBeneficiarios;
        const h = (val / maxVal) * chartHeight;
        const y = height - paddingY - h;

        svgInner += `
          <rect
            class="chart-elem cursor-pointer transition-all duration-300 hover:opacity-85"
