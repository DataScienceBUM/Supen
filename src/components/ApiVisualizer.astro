          </text>
        `;
      });

      legendContainer.innerHTML = BENEFICIOS_RETIROS.map((b, idx) => `
        <div class="flex items-center gap-1.5">
          <span class="w-3 h-3 rounded" style="background-color: ${colors[idx % colors.length]}"></span>
          <span class="font-medium">${b.modalidad} (${b.porcentaje}%)</span>
        </div>
      `).join('');
    }

    svg.innerHTML = svgInner;

    const totalBeneficiarios = BENEFICIOS_RETIROS.reduce((acc, b) => acc + b.cantidadBeneficiarios, 0);
    const totalDesembolsado = BENEFICIOS_RETIROS.reduce((acc, b) => acc + b.montoTotalCRC, 0);
    kpisGrid.innerHTML = `
      <div class="bg-white border border-slate-200 p-3.5 rounded-2xl shadow-xs">
