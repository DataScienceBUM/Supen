---
const year = new Date().getFullYear();
---

<footer class="bg-slate-900 border-t border-slate-800 text-slate-300 text-sm mt-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-12 lg:py-16">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 lg:gap-12">
      <!-- Columna 1: Identidad -->
      <div class="md:col-span-1 space-y-4">
        <div class="flex items-center gap-2">
          <div class="w-8 h-8 rounded-lg bg-[#0A2540] border border-blue-400/30 flex items-center justify-center text-white font-bold">
            S
          </div>
          <span class="font-bold text-white text-base">SUPEN Costa Rica</span>
        </div>
        <p class="text-xs text-slate-400 leading-relaxed">
          Plataforma abierta de visualización y transparencia analítica del Sistema Nacional de Pensiones (SNP) de Costa Rica, fundamentada en los datos abiertos oficiales de la Superintendencia de Pensiones.
        </p>
        <div class="pt-2">
          <span class="inline-flex items-center gap-1.5 text-xs text-emerald-400 bg-emerald-950/60 border border-emerald-800/80 px-2.5 py-1 rounded-md">
            <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
            API REST Pública y Abierta
          </span>
        </div>
      </div>

      <!-- Columna 2: Módulos Analíticos -->
      <div>
        <h3 class="text-xs font-bold text-white uppercase tracking-wider mb-3">Módulos del Sistema</h3>
        <ul class="space-y-2 text-xs">
          <li><a href="/" class="hover:text-blue-300 transition-colors">Panorama del Sistema (Dashboard)</a></li>
          <li><a href="/rendimientos" class="hover:text-blue-300 transition-colors">Ranking de Rendimientos Reales</a></li>
          <li><a href="/comisiones" class="hover:text-blue-300 transition-colors">Comisiones y Calculadora Fee Drag</a></li>
          <li><a href="/portafolios" class="hover:text-blue-300 transition-colors">Portafolios e Inversiones</a></li>
          <li><a href="/simulador" class="hover:text-blue-300 transition-colors">Simulador de Pensiones</a></li>
        </ul>
      </div>

      <!-- Columna 3: Educación y Ciudadanía -->
      <div>
        <h3 class="text-xs font-bold text-white uppercase tracking-wider mb-3">Educación y Ciudadanía</h3>
        <ul class="space-y-2 text-xs">
          <li><a href="/blog" class="hover:text-blue-300 font-semibold text-blue-200 transition-colors">Blog Previsional & Guías ↗</a></li>
          <li><a href="/transferencias" class="hover:text-blue-300 transition-colors">Libre Transferencia (Movilidad)</a></li>
          <li><a href="/afiliados-y-retiros" class="hover:text-blue-300 transition-colors">Demografía Laboral y Retiros</a></li>
          <li><a href="/glosario" class="hover:text-blue-300 transition-colors">Glosario Previsional y Leyes</a></li>
          <li><a href="/api" class="hover:text-blue-300 transition-colors">Documentación de la API Abierta</a></li>
        </ul>
      </div>

      <!-- Columna 4: Marco Jurídico y Fuentes -->
      <div>
        <h3 class="text-xs font-bold text-white uppercase tracking-wider mb-3">Marco Jurídico e Institucional</h3>
        <ul class="space-y-2 text-xs text-slate-400">
          <li><strong>Ley N.° 7983:</strong> Ley de Protección al Trabajador (Creación del ROP y FCL).</li>
          <li><strong>Ley N.° 9906:</strong> Retiro flexible y transitorios del ROP.</li>
          <li><strong>Supervisión:</strong> CONASSIF & Superintendencia de Pensiones.</li>
          <li><strong>Custodia y SICERE:</strong> Caja Costarricense de Seguro Social.</li>
          <li class="pt-2">
            <a href="https://github.com/DataScienceBUM/Supen" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-slate-300 hover:text-white">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
              <span>Repositorio en GitHub</span>
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Divisor y Pie -->
    <div class="border-t border-slate-800 mt-12 pt-6 flex flex-col sm:flex-row items-center justify-between text-xs text-slate-400 gap-4">
      <p>© {year} Observatorio de Pensiones SUPEN Costa Rica. Datos abiertos para la toma de decisiones ciudadana.</p>
      <div class="flex items-center gap-4">
        <span>Cifras monetarias en Colones (₡) y Dólares ($)</span>
        <span>•</span>
        <span>Estándar WCAG AAA</span>
      </div>
    </div>
  </div>
</footer>
