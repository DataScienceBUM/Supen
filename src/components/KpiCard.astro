---
interface Props {
  titulo: string;
  valor: string;
  subtitulo?: string;
  badge?: string;
  badgeColor?: 'emerald' | 'blue' | 'amber' | 'slate';
  tooltip?: string;
}

const {
  titulo,
  valor,
  subtitulo,
  badge,
  badgeColor = 'blue',
  tooltip
} = Astro.props;

const badgeClasses = {
  emerald: 'bg-emerald-50 text-emerald-900 border-emerald-200 font-bold',
  blue: 'bg-blue-50 text-[#0A2540] border-blue-200 font-bold',
  amber: 'bg-amber-50 text-amber-950 border-amber-200 font-bold',
  slate: 'bg-slate-100 text-slate-800 border-slate-200 font-medium'
}[badgeColor];
---

<div class="relative group bg-white border border-slate-200/90 rounded-2xl p-5 hover:border-slate-300 hover:shadow-sm transition-all shadow-xs">
  <div class="flex items-start justify-between gap-3">
    <div>
      <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider block mb-1">{titulo}</span>
      <h3 class="text-2xl sm:text-3xl font-black text-[#0A2540] tracking-tight tabular-nums group-hover:text-[#12375C] transition-colors">
        {valor}
      </h3>
    </div>

    {badge && (
      <span class={`text-[11px] px-2.5 py-0.5 rounded-full border ${badgeClasses} tabular-nums`}>
        {badge}
      </span>
    )}
  </div>

  {subtitulo && (
    <p class="text-xs text-slate-600 font-medium mt-2 flex items-center gap-1.5">
      {subtitulo}
    </p>
  )}

  {tooltip && (
    <div class="mt-3 pt-3 border-t border-slate-100 text-[11px] text-slate-600 bg-slate-50/70 p-2.5 rounded-lg leading-snug">
      ℹ️ {tooltip}
    </div>
  )}
</div>
