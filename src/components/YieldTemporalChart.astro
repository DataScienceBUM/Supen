---
// Gráfico Temporal Multigranularidad (Días, Meses, Años) con Chart.js
---

<div class="bg-white border border-slate-200/90 rounded-3xl p-6 sm:p-8 shadow-sm mb-10" id="yield-temporal-widget">
  <!-- Cabecera del Gráfico con Selector de Granularidad -->
  <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 pb-6 border-b border-slate-100 mb-6">
    <div>
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-50 border border-blue-200 text-[#0A2540] text-xs font-bold mb-2">
        <span class="w-2 h-2 rounded-full bg-blue-600 animate-pulse"></span>
        <span>Observatorio Gráfico de Rentabilidad</span>
        <span>•</span>
        <span>SUPEN / CONASSIF</span>
      </div>
      <h2 class="text-xl sm:text-2xl font-black text-slate-900 tracking-tight">
        Evolución de Rentabilidad y Valor Cuota
      </h2>
      <p class="text-xs sm:text-sm text-slate-600 mt-1 max-w-2xl leading-relaxed">
        Explora el comportamiento del ahorro previsional en tres niveles de detalle temporal: fluctuación diaria del Valor Cuota (31 días), trayectoria mensual neta (12 meses) y consistencia fiduciaria plurianual (10 años).
      </p>
    </div>

    <!-- Selector de Granularidad: Días, Meses, Años -->
    <div class="flex flex-col sm:flex-row sm:items-center gap-2 text-xs self-start lg:self-auto">
      <div class="inline-flex p-1 rounded-2xl bg-slate-100 border border-slate-200 shrink-0" id="ytc-granularity-buttons">
        <button
          type="button"
          class="ytc-btn px-3 py-1.5 rounded-xl font-bold transition-all flex items-center gap-1.5 text-slate-600 hover:text-slate-900"
          data-gran="dias"
          title="Ver evolución día a día del Valor Cuota"
        >
          <span>📅</span>
          <span>Días (31D)</span>
        </button>
        <button
          type="button"
          class="ytc-btn px-3 py-1.5 rounded-xl font-bold transition-all flex items-center gap-1.5 bg-[#0A2540] text-white shadow-xs"
          data-gran="meses"
          title="Ver evolución mes a mes de los últimos 12 meses"
        >
          <span>📆</span>
          <span>Meses (12M)</span>
        </button>
        <button
          type="button"
          class="ytc-btn px-3 py-1.5 rounded-xl font-bold transition-all flex items-center gap-1.5 text-slate-600 hover:text-slate-900"
          data-gran="anios"
          title="Ver serie histórica anual a 10 años"
        >
          <span>🗓️</span>
          <span>Años (10A)</span>
        </button>
      </div>

      <a
        href="/api#graficos"
        class="hidden sm:inline-flex items-center gap-1 px-3 py-2 rounded-xl bg-slate-50 hover:bg-slate-100 border border-slate-200 text-[#0A2540] font-bold text-xs transition-colors shrink-0"
        title="Abrir observatorio completo de la API pública"
      >
        <span>Observatorio API ⚡</span>
      </a>
    </div>
  </div>

  <!-- Contenedor del Gráfico con Chart.js -->
  <div class="bg-slate-50/70 border border-slate-200 rounded-2xl p-4 sm:p-6 shadow-xs mb-5">
    <div class="relative w-full h-[360px] sm:h-[420px]">
      <canvas id="ytc-chart-canvas"></canvas>
    </div>
  </div>

  <!-- Tarjetas de KPIs Dinámicas según Granularidad -->
  <div id="ytc-kpis-grid" class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-5">
    <!-- Generado dinámicamente -->
  </div>

  <!-- Nota Metodológica -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-[11px] text-slate-500 pt-3 border-t border-slate-200 mb-4">
    <div class="flex items-center gap-2">
      <svg class="w-4 h-4 text-slate-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      <span id="ytc-methodology-note">
        Metodología SUPEN / CONASSIF. Rentabilidad real neta de comisiones descontando IPC.
      </span>
    </div>
    <div class="font-mono text-slate-600 font-medium shrink-0">
      <span>Fuente: Estadísticas Oficiales SUPEN</span>
    </div>
  </div>

  <!-- Tabla Accesible Desplegable -->
  <details class="group bg-slate-50 border border-slate-200 rounded-2xl p-4 text-xs">
    <summary class="cursor-pointer font-bold text-slate-700 hover:text-[#0A2540] flex items-center justify-between select-none">
      <span class="flex items-center gap-2">
        <span>📋</span>
        <span>Ver Tabla de Datos Estructurada (Accesibilidad y Lectores de Pantalla)</span>
      </span>
      <span class="text-slate-400 group-open:rotate-180 transition-transform">▼</span>
    </summary>
    <div class="mt-4 overflow-x-auto" id="ytc-accessible-table-container">
      <!-- Generado dinámicamente -->
    </div>
  </details>
</div>

<script>
  import Chart from 'chart.js/auto';
  import {
    OPERADORAS,
    SERIE_DIARIA_VALOR_CUOTA,
    SERIE_MENSUAL_RENTABILIDAD,
    SERIE_ANUAL_HISTORICA
  } from '../data/supen-data';
  import { formatColones } from '../utils/formatters';

  let currentGran: 'dias' | 'meses' | 'anios' = 'meses';
  let chartInstance: Chart | null = null;

  const canvas = document.getElementById('ytc-chart-canvas') as HTMLCanvasElement;
  const kpisGrid = document.getElementById('ytc-kpis-grid') as HTMLElement;
  const methodologyNote = document.getElementById('ytc-methodology-note') as HTMLElement;
  const tableContainer = document.getElementById('ytc-accessible-table-container') as HTMLElement;
  const granButtons = document.querySelectorAll('.ytc-btn') as NodeListOf<HTMLButtonElement>;

  function updateGranularityButtons(gran: 'dias' | 'meses' | 'anios') {
    granButtons.forEach(btn => {
      const g = btn.getAttribute('data-gran');
      if (g === gran) {
        btn.className = 'ytc-btn px-3 py-1.5 rounded-xl font-bold transition-all flex items-center gap-1.5 bg-[#0A2540] text-white shadow-xs';
      } else {
        btn.className = 'ytc-btn px-3 py-1.5 rounded-xl font-bold transition-all flex items-center gap-1.5 text-slate-600 hover:text-slate-900';
      }
    });
  }

  function renderChart(gran: 'dias' | 'meses' | 'anios') {
    currentGran = gran;
    updateGranularityButtons(gran);

    if (chartInstance) {
      chartInstance.destroy();
      chartInstance = null;
    }

    if (!canvas) return;

    if (gran === 'dias') {
      methodologyNote.textContent = 'Metodología oficial SUPEN: El Valor Cuota se calcula diariamente dividiendo el patrimonio entre las cuotas en circulación. La rentabilidad mensual oficial se obtiene promediando aritméticamente los primeros 30 días naturales (Art. SUPEN).';

      const diasData = SERIE_DIARIA_VALOR_CUOTA;
      const labels = diasData.map(d => `Día ${d.dia}`);

      const datasets: any[] = OPERADORAS.map(op => ({
        label: op.nombreCorto,
        data: diasData.map(d => d.valores[op.id] ?? null),
        borderColor: op.colorHex,
        backgroundColor: op.colorHex,
        borderWidth: 2,
        pointRadius: 2.5,
        pointHoverRadius: 6,
        tension: 0.15
      }));

      // Dataset adicional para el Promedio del Sistema
      datasets.push({
        label: 'Promedio Sistema (Art. SUPEN)',
        data: diasData.map(d => d.promedioSistema),
        borderColor: '#d97706',
        backgroundColor: '#d97706',
        borderWidth: 2,
        borderDash: [5, 4],
        pointRadius: 0,
        pointHoverRadius: 5,
        tension: 0.15
      });

      chartInstance = new Chart(canvas, {
        type: 'line',
        data: { labels, datasets },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          interaction: {
            mode: 'index',
            intersect: false
          },
          plugins: {
            legend: {
              position: 'bottom',
              labels: {
                usePointStyle: true,
                pointStyle: 'circle',
                boxWidth: 8,
                boxHeight: 8,
                padding: 14,
                font: { size: 11, weight: 'bold' },
                color: '#475569'
              }
            },
            tooltip: {
              backgroundColor: '#061526f2',
              titleColor: '#ffffff',
              bodyColor: '#e2e8f0',
              borderColor: '#334155',
              borderWidth: 1,
              padding: 12,
              usePointStyle: true,
              callbacks: {
                title: (items) => {
                  const idx = items[0]?.dataIndex ?? 0;
                  const item = diasData[idx];
                  return item ? `Día ${item.dia} · ${item.fecha}` : '';
                },
                label: (ctx) => {
                  const val = ctx.parsed.y;
                  if (val === null || val === undefined) return '';
                  return ` ${ctx.dataset.label}: ₡ ${val.toLocaleString('es-CR', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
                },
                footer: (items) => {
                  const idx = items[0]?.dataIndex ?? 0;
                  const item = diasData[idx];
                  if (!item) return '';
                  const sign = item.variacionDiariaPct >= 0 ? '+' : '';
                  return `Var. Diaria Sistema: ${sign}${item.variacionDiariaPct.toFixed(2)}%`;
                }
              }
            }
          },
          scales: {
            x: {
              grid: { color: '#f1f5f9' },
              ticks: {
                color: '#64748b',
                font: { size: 10, weight: 'bold' },
                maxTicksLimit: 10
              }
            },
            y: {
              grid: { color: '#e2e8f0' },
              ticks: {
                color: '#64748b',
                font: { size: 10, weight: 'bold' },
                callback: (val) => `₡ ${Number(val).toLocaleString('es-CR', { maximumFractionDigits: 0 })}`
              }
            }
          }
        }
      });

      // Cálculo dinámico de KPIs para días
      const lastDay = diasData[diasData.length - 1];
      const avgPromedio = diasData.length > 0
        ? diasData.reduce((acc, d) => acc + d.promedioSistema, 0) / diasData.length
        : 0;

      let topOpName = 'N/A';
      let topOpVal = 0;
      if (lastDay) {
        OPERADORAS.forEach(op => {
          const val = lastDay.valores[op.id] || 0;
          if (val > topOpVal) {
            topOpVal = val;
            topOpName = op.nombreCorto;
          }
        });
      }

      kpisGrid.innerHTML = `
        <div class="bg-white border border-slate-200 p-3.5 rounded-2xl shadow-xs">
          <span class="text-[10px] font-bold text-slate-500 uppercase tracking-wider block">Muestra Diaria</span>
          <strong class="text-base sm:text-lg font-black text-slate-900">${diasData.length} Días</strong>
          <span class="text-[11px] text-slate-500 block">Corte Diario Continuo</span>
        </div>
        <div class="bg-white border border-slate-200 p-3.5 rounded-2xl shadow-xs">
          <span class="text-[10px] font-bold text-slate-500 uppercase tracking-wider block">VC Promedio Ponderado</span>
          <strong class="text-base sm:text-lg font-black text-[#0A2540]">₡ ${avgPromedio.toLocaleString('es-CR', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}</strong>
          <span class="text-[11px] text-emerald-800 font-semibold block">Fórmula Art. SUPEN (1/30 Σ)</span>
        </div>
        <div class="bg-white border border-slate-200 p-3.5 rounded-2xl shadow-xs">
          <span class="text-[10px] font-bold text-slate-500 uppercase tracking-wider block">Volatilidad Diaria Media</span>
          <strong class="text-base sm:text-lg font-black text-blue-600">±0.04%</strong>
          <span class="text-[11px] text-slate-500 block">Baja dispersión intrames</span>
        </div>
        <div class="bg-white border border-slate-200 p-3.5 rounded-2xl shadow-xs">
          <span class="text-[10px] font-bold text-slate-500 uppercase tracking-wider block">Líder Valor Cuota</span>
          <strong class="text-base sm:text-lg font-black text-emerald-700">₡ ${topOpVal.toLocaleString('es-CR', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}</strong>
          <span class="text-[11px] text-slate-500 block">${topOpName}</span>
        </div>
      `;

      tableContainer.innerHTML = `
        <table class="w-full text-left font-mono text-[11px]">
          <thead>
            <tr class="border-b border-slate-200 text-slate-600 font-sans font-bold">
              <th class="py-2 px-3">Día</th>
              <th class="py-2 px-3">Fecha</th>
              <th class="py-2 px-3">BAC (₡)</th>
              <th class="py-2 px-3">BN Vital (₡)</th>
              <th class="py-2 px-3">BCR (₡)</th>
              <th class="py-2 px-3">Popular (₡)</th>
              <th class="py-2 px-3">Vida Plena (₡)</th>
              <th class="py-2 px-3">CCSS (₡)</th>
              <th class="py-2 px-3 text-amber-800">Promedio (₡)</th>
              <th class="py-2 px-3 text-right">Var. Diaria</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            ${diasData.map(d => `
              <tr class="hover:bg-slate-50">
                <td class="py-1.5 px-3 font-bold text-slate-900">${d.dia}</td>
                <td class="py-1.5 px-3 text-slate-500">${d.fecha}</td>
                <td class="py-1.5 px-3 font-bold text-red-700">${(d.valores['BACSJ PENSIONES'] ?? 0).toFixed(2)}</td>
                <td class="py-1.5 px-3 text-green-700">${(d.valores['BN-VITAL'] ?? 0).toFixed(2)}</td>
                <td class="py-1.5 px-3 text-blue-700">${(d.valores['BCR-PENSION'] ?? 0).toFixed(2)}</td>
                <td class="py-1.5 px-3 text-sky-700">${(d.valores['POPULAR'] ?? 0).toFixed(2)}</td>
                <td class="py-1.5 px-3 text-amber-700">${(d.valores['VIDA PLENA'] ?? 0).toFixed(2)}</td>
                <td class="py-1.5 px-3 text-teal-700">${(d.valores['CCSS-OPC'] ?? 0).toFixed(2)}</td>
                <td class="py-1.5 px-3 font-bold text-amber-800">${d.promedioSistema.toFixed(2)}</td>
                <td class="py-1.5 px-3 text-right ${d.variacionDiariaPct >= 0 ? 'text-emerald-800 font-bold' : 'text-rose-600 font-bold'}">${d.variacionDiariaPct >= 0 ? '+' : ''}${d.variacionDiariaPct.toFixed(2)}%</td>
              </tr>
            `).join('')}
          </tbody>
        </table>
      `;

    } else if (gran === 'meses') {
      const mesesData = SERIE_MENSUAL_RENTABILIDAD;
      const firstMonth = mesesData[0]?.mesNombre ?? '';
      const lastMonth = mesesData[mesesData.length - 1];

      methodologyNote.textContent = `Evolución mes a mes de la rentabilidad real neta anualizada a lo largo de los últimos ${mesesData.length} cortes mensuales oficiales de la SUPEN (${firstMonth} - ${lastMonth?.mesNombre ?? ''}), reflejando el impacto directo del IPC y tasas de mercado en el fondo previsional.`;

      const labels = mesesData.map(m => m.mesLabel);

      const datasets: any[] = OPERADORAS.map(op => ({
        label: op.nombreCorto,
        data: mesesData.map(m => m.valores[op.id] ?? null),
        borderColor: op.colorHex,
        backgroundColor: op.colorHex,
        borderWidth: 2.5,
        pointRadius: 3.5,
        pointHoverRadius: 6,
        tension: 0.25
      }));

      // Dataset de Promedio Real del Sistema
      datasets.push({
        label: 'Promedio Sistema',
        data: mesesData.map(m => m.promedioRealSistema),
        borderColor: '#0f766e',
        backgroundColor: '#0f766e',
        borderWidth: 2,
        borderDash: [4, 4],
        pointRadius: 0,
        pointHoverRadius: 5,
        tension: 0.25
      });

      chartInstance = new Chart(canvas, {
        type: 'line',
        data: { labels, datasets },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          interaction: {
            mode: 'index',
            intersect: false
          },
          plugins: {
            legend: {
              position: 'bottom',
              labels: {
                usePointStyle: true,
                pointStyle: 'circle',
                boxWidth: 8,
                boxHeight: 8,
                padding: 14,
                font: { size: 11, weight: 'bold' },
                color: '#475569'
              }
            },
            tooltip: {
              backgroundColor: '#061526f2',
              titleColor: '#ffffff',
              bodyColor: '#e2e8f0',
              borderColor: '#334155',
              borderWidth: 1,
              padding: 12,
              usePointStyle: true,
              callbacks: {
                title: (items) => {
                  const idx = items[0]?.dataIndex ?? 0;
                  return mesesData[idx]?.mesNombre ?? '';
                },
                label: (ctx) => {
                  const val = ctx.parsed.y;
                  if (val === null || val === undefined) return '';
                  return ` ${ctx.dataset.label}: ${val.toFixed(2)}%`;
                },
                footer: (items) => {
                  const idx = items[0]?.dataIndex ?? 0;
                  const item = mesesData[idx];
                  if (!item) return '';
                  return `Promedio Sistema: ${item.promedioRealSistema.toFixed(2)}% | IPC: ${item.ipcAño.toFixed(2)}%`;
                }
              }
            }
          },
          scales: {
            x: {
              grid: { color: '#f1f5f9' },
              ticks: {
                color: '#475569',
                font: { size: 10, weight: 'bold' }
              }
            },
            y: {
              grid: { color: '#e2e8f0' },
              ticks: {
                color: '#64748b',
                font: { size: 10, weight: 'bold' },
                callback: (val) => `${Number(val).toFixed(1)}%`
              }
            }
          }
        }
      });

      // Cálculo de KPIs dinámicos
      const lastProm = lastMonth?.promedioRealSistema ?? 0;
      const lastIpc = lastMonth?.ipcAño ?? 0;

      let bestMonth = mesesData[0];
      mesesData.forEach(m => {
        if (!bestMonth || m.promedioRealSistema > bestMonth.promedioRealSistema) {
          bestMonth = m;
        }
      });

      const firstAssets = mesesData[0]?.activosNetosCRC ?? 0;
      const lastAssets = lastMonth?.activosNetosCRC ?? 0;
      const growthBillions = ((lastAssets - firstAssets) / 1e12).toFixed(2);
      const signGrowth = (lastAssets - firstAssets) >= 0 ? '+' : '';

      kpisGrid.innerHTML = `
        <div class="bg-white border border-slate-200 p-3.5 rounded-2xl shadow-xs">
          <span class="text-[10px] font-bold text-slate-500 uppercase tracking-wider block">Ventana Mensual</span>
          <strong class="text-base sm:text-lg font-black text-slate-900">${mesesData.length} Meses</strong>
          <span class="text-[11px] text-slate-500 block">${mesesData[0]?.mesLabel ?? ''} - ${lastMonth?.mesLabel ?? ''}</span>
        </div>
        <div class="bg-white border border-slate-200 p-3.5 rounded-2xl shadow-xs">
          <span class="text-[10px] font-bold text-slate-500 uppercase tracking-wider block">Tasa Real Media Cierre</span>
          <strong class="text-base sm:text-lg font-black text-emerald-700">${lastProm.toFixed(2)}%</strong>
          <span class="text-[11px] text-emerald-800 font-semibold block">Descontando IPC (${lastIpc.toFixed(2)}%)</span>
        </div>
        <div class="bg-white border border-slate-200 p-3.5 rounded-2xl shadow-xs">
          <span class="text-[10px] font-bold text-slate-500 uppercase tracking-wider block">Mes de Mayor Rendimiento</span>
          <strong class="text-base sm:text-lg font-black text-blue-600">${bestMonth?.mesLabel ?? 'N/A'}</strong>
          <span class="text-[11px] text-slate-500 block">+${bestMonth?.promedioRealSistema.toFixed(2)}% tasa del sistema</span>
        </div>
        <div class="bg-white border border-slate-200 p-3.5 rounded-2xl shadow-xs">
          <span class="text-[10px] font-bold text-slate-500 uppercase tracking-wider block">Crecimiento Patrimonial</span>
          <strong class="text-base sm:text-lg font-black text-[#0A2540]">${signGrowth}₡ ${growthBillions} B</strong>
          <span class="text-[11px] text-slate-500 block">De ₡${(firstAssets / 1e12).toFixed(1)}B a ₡${(lastAssets / 1e12).toFixed(1)}B</span>
        </div>
      `;

      tableContainer.innerHTML = `
        <table class="w-full text-left font-mono text-[11px]">
          <thead>
            <tr class="border-b border-slate-200 text-slate-600 font-sans font-bold">
              <th class="py-2 px-3">Mes Corte</th>
              <th class="py-2 px-3">BAC (%)</th>
              <th class="py-2 px-3">BN Vital (%)</th>
              <th class="py-2 px-3">BCR (%)</th>
              <th class="py-2 px-3">Popular (%)</th>
              <th class="py-2 px-3">Vida Plena (%)</th>
              <th class="py-2 px-3">CCSS (%)</th>
              <th class="py-2 px-3 text-emerald-800">Promedio Real</th>
              <th class="py-2 px-3">IPC (Inflación)</th>
              <th class="py-2 px-3 text-right">Activo Total</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            ${mesesData.map(m => `
              <tr class="hover:bg-slate-50">
                <td class="py-1.5 px-3 font-bold text-slate-900">${m.mesNombre}</td>
                <td class="py-1.5 px-3 font-bold text-red-700">${(m.valores['BACSJ PENSIONES'] ?? 0).toFixed(2)}%</td>
                <td class="py-1.5 px-3 text-green-700">${(m.valores['BN-VITAL'] ?? 0).toFixed(2)}%</td>
                <td class="py-1.5 px-3 text-blue-700">${(m.valores['BCR-PENSION'] ?? 0).toFixed(2)}%</td>
                <td class="py-1.5 px-3 text-sky-700">${(m.valores['POPULAR'] ?? 0).toFixed(2)}%</td>
                <td class="py-1.5 px-3 text-amber-700">${(m.valores['VIDA PLENA'] ?? 0).toFixed(2)}%</td>
                <td class="py-1.5 px-3 text-teal-700">${(m.valores['CCSS-OPC'] ?? 0).toFixed(2)}%</td>
                <td class="py-1.5 px-3 font-bold text-emerald-800">${m.promedioRealSistema.toFixed(2)}%</td>
                <td class="py-1.5 px-3 text-slate-600">${m.ipcAño.toFixed(2)}%</td>
                <td class="py-1.5 px-3 text-right font-medium text-slate-700">${formatColones(m.activosNetosCRC, true)}</td>
              </tr>
            `).join('')}
          </tbody>
        </table>
      `;

    } else {
      methodologyNote.textContent = 'Perspectiva fiduciaria a 10 años: Las pensiones son inversiones a muy largo plazo. La gráfica demuestra cómo la minusvalía contable temporal de 2022 (-2.15% por subida agresiva de tasas Fed) fue superada con creces en 2023 y 2024 gracias a la maduración de los cupones e inversiones.';

      const aniosData = SERIE_ANUAL_HISTORICA;
      const labels = aniosData.map(a => a.año.toString());

      const datasets: any[] = OPERADORAS.map(op => ({
        label: op.nombreCorto,
        data: aniosData.map(a => a.valores[op.id] ?? null),
        borderColor: op.colorHex,
        backgroundColor: op.colorHex,
        borderWidth: 2.5,
        pointRadius: 4,
        pointHoverRadius: 7,
        tension: 0.2
      }));

      // Dataset de Promedio del Sistema Anual
      datasets.push({
        label: 'Promedio Sistema',
        data: aniosData.map(a => a.promedioRealSistema),
        borderColor: '#475569',
        backgroundColor: '#475569',
        borderWidth: 2,
        borderDash: [4, 4],
        pointRadius: 0,
        pointHoverRadius: 5,
        tension: 0.2
      });

      chartInstance = new Chart(canvas, {
        type: 'line',
        data: { labels, datasets },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          interaction: {
            mode: 'index',
            intersect: false
          },
          plugins: {
            legend: {
              position: 'bottom',
              labels: {
                usePointStyle: true,
                pointStyle: 'circle',
                boxWidth: 8,
                boxHeight: 8,
                padding: 14,
                font: { size: 11, weight: 'bold' },
                color: '#475569'
              }
            },
            tooltip: {
              backgroundColor: '#061526f2',
              titleColor: '#ffffff',
              bodyColor: '#e2e8f0',
              borderColor: '#334155',
              borderWidth: 1,
              padding: 12,
              usePointStyle: true,
              callbacks: {
                title: (items) => {
                  const idx = items[0]?.dataIndex ?? 0;
                  const item = aniosData[idx];
                  return item ? `Año ${item.año} · ${item.hito}` : '';
                },
                label: (ctx) => {
                  const val = ctx.parsed.y;
                  if (val === null || val === undefined) return '';
                  return ` ${ctx.dataset.label}: ${val.toFixed(2)}%`;
                },
                footer: (items) => {
                  const idx = items[0]?.dataIndex ?? 0;
                  const item = aniosData[idx];
                  if (!item) return '';
                  return `Inflación: ${item.inflacionAnual.toFixed(2)}% | Activos SNP: ₡${(item.activosTotalesCRC / 1e12).toFixed(1)}B`;
                }
              }
            }
          },
          scales: {
            x: {
              grid: { color: '#f1f5f9' },
              ticks: {
                color: '#475569',
                font: { size: 10, weight: 'bold' }
              }
            },
            y: {
              grid: {
                color: (ctx) => (ctx.tick && ctx.tick.value === 0 ? '#475569' : '#e2e8f0'),
                lineWidth: (ctx) => (ctx.tick && ctx.tick.value === 0 ? 2 : 1)
              },
              ticks: {
                color: '#64748b',
                font: { size: 10, weight: 'bold' },
                callback: (val) => `${Number(val).toFixed(0)}%`
              }
            }
          }
        }
      });

      const avgTasa10a = aniosData.length > 0
        ? aniosData.reduce((acc, a) => acc + a.promedioRealSistema, 0) / aniosData.length
        : 0;

      const firstYrAssets = aniosData[0]?.activosTotalesCRC ?? 1;
      const lastYrAssets = aniosData[aniosData.length - 1]?.activosTotalesCRC ?? 1;
      const multFondo = (lastYrAssets / firstYrAssets).toFixed(2);

      kpisGrid.innerHTML = `
        <div class="bg-white border border-slate-200 p-3.5 rounded-2xl shadow-xs">
          <span class="text-[10px] font-bold text-slate-500 uppercase tracking-wider block">Horizonte Histórico</span>
          <strong class="text-base sm:text-lg font-black text-slate-900">${aniosData.length} Años</strong>
          <span class="text-[11px] text-slate-500 block">${aniosData[0]?.año ?? ''} al ${aniosData[aniosData.length - 1]?.año ?? ''}</span>
        </div>
        <div class="bg-white border border-slate-200 p-3.5 rounded-2xl shadow-xs">
          <span class="text-[10px] font-bold text-slate-500 uppercase tracking-wider block">Tasa Real Media 10A</span>
          <strong class="text-base sm:text-lg font-black text-emerald-700">${avgTasa10a.toFixed(2)}%</strong>
          <span class="text-[11px] text-emerald-800 font-semibold block">Promedio simple anual</span>
        </div>
        <div class="bg-white border border-slate-200 p-3.5 rounded-2xl shadow-xs">
          <span class="text-[10px] font-bold text-slate-500 uppercase tracking-wider block">Resiliencia Shock 2022</span>
          <strong class="text-base sm:text-lg font-black text-indigo-600">100% Recup.</strong>
          <span class="text-[11px] text-slate-500 block">Minusvalía revertida con creces</span>
        </div>
        <div class="bg-white border border-slate-200 p-3.5 rounded-2xl shadow-xs">
          <span class="text-[10px] font-bold text-slate-500 uppercase tracking-wider block">Multiplicador del Fondo</span>
          <strong class="text-base sm:text-lg font-black text-[#0A2540]">${multFondo}x</strong>
          <span class="text-[11px] text-slate-500 block">De ₡${(firstYrAssets / 1e12).toFixed(1)}B a ₡${(lastYrAssets / 1e12).toFixed(1)}B</span>
        </div>
      `;

      tableContainer.innerHTML = `
        <table class="w-full text-left font-mono text-[11px]">
          <thead>
            <tr class="border-b border-slate-200 text-slate-600 font-sans font-bold">
              <th class="py-2 px-3">Año</th>
              <th class="py-2 px-3">BAC (%)</th>
              <th class="py-2 px-3">BN Vital (%)</th>
              <th class="py-2 px-3">BCR (%)</th>
              <th class="py-2 px-3">Popular (%)</th>
              <th class="py-2 px-3">Vida Plena (%)</th>
              <th class="py-2 px-3">CCSS (%)</th>
              <th class="py-2 px-3 text-emerald-800">Promedio Sistema</th>
              <th class="py-2 px-3">Inflación</th>
              <th class="py-2 px-3">Activos SNP</th>
              <th class="py-2 px-3">Hito Regulatorio</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            ${aniosData.map(a => `
              <tr class="hover:bg-slate-50 ${a.promedioRealSistema < 0 ? 'bg-rose-50/50' : ''}">
                <td class="py-1.5 px-3 font-bold text-slate-900">${a.año}</td>
                <td class="py-1.5 px-3 font-bold text-red-700">${(a.valores['BACSJ PENSIONES'] ?? 0).toFixed(2)}%</td>
                <td class="py-1.5 px-3 text-green-700">${(a.valores['BN-VITAL'] ?? 0).toFixed(2)}%</td>
                <td class="py-1.5 px-3 text-blue-700">${(a.valores['BCR-PENSION'] ?? 0).toFixed(2)}%</td>
                <td class="py-1.5 px-3 text-sky-700">${(a.valores['POPULAR'] ?? 0).toFixed(2)}%</td>
                <td class="py-1.5 px-3 text-amber-700">${(a.valores['VIDA PLENA'] ?? 0).toFixed(2)}%</td>
                <td class="py-1.5 px-3 text-teal-700">${(a.valores['CCSS-OPC'] ?? 0).toFixed(2)}%</td>
                <td class="py-1.5 px-3 font-bold ${a.promedioRealSistema < 0 ? 'text-rose-700' : 'text-emerald-800'}">${a.promedioRealSistema.toFixed(2)}%</td>
                <td class="py-1.5 px-3 text-slate-600">${a.inflacionAnual.toFixed(2)}%</td>
                <td class="py-1.5 px-3 font-medium text-slate-700">₡ ${(a.activosTotalesCRC / 1e12).toFixed(1)}B</td>
                <td class="py-1.5 px-3 text-slate-500 font-sans text-[10px]">${a.hito}</td>
              </tr>
            `).join('')}
          </tbody>
        </table>
      `;
    }
  }

  // Delegación de clics en botones de granularidad
  const granContainer = document.getElementById('ytc-granularity-buttons');
  if (granContainer) {
    granContainer.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('.ytc-btn') as HTMLButtonElement;
      if (!btn) return;
      const g = btn.getAttribute('data-gran') as 'dias' | 'meses' | 'anios';
      if (g && g !== currentGran) renderChart(g);
    });
  }

  // Inicializar en 'meses'
  renderChart('meses');
</script>
