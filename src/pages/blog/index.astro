---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');

// Ordenar por fecha descendente
const posts = allPosts.sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime());

const featuredPost = posts.find(p => p.data.featured) || posts[0];

const categories = [
  { id: 'todas', label: 'Todas las publicaciones' },
  { id: 'operadoras', label: '🏢 Operadoras (OPCs)' },
  { id: 'indices', label: '📈 Índices & Métricas' },
  { id: 'leyes', label: '⚖️ Leyes & Normativa' },
  { id: 'guias', label: '💡 Guías Prácticas' },
];

function getCategoryColor(cat: string) {
  switch (cat) {
    case 'operadoras':
      return 'bg-sky-50 text-sky-800 border-sky-200';
    case 'indices':
      return 'bg-emerald-50 text-emerald-800 border-emerald-200';
    case 'leyes':
      return 'bg-purple-50 text-purple-800 border-purple-200';
    case 'guias':
      return 'bg-amber-50 text-amber-800 border-amber-200';
    default:
      return 'bg-slate-50 text-slate-800 border-slate-200';
  }
}
---

<BaseLayout
  title="Blog Previsional & Guías Ciudadanas | SUPEN Costa Rica"
  description="Artículos analíticos, guías ciudadanas y explicadores sobre operadoras, índices financieros, leyes y el sistema de pensiones de Costa Rica."
>
  <!-- Cabecera de la sección -->
  <section class="mb-10">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-50 border border-blue-200 text-[#0A2540] text-xs font-bold mb-3">
      <span>📚 Observatorio Ciudadano</span>
      <span>•</span>
      <span>Educación & Análisis Independiente</span>
    </div>
    <h1 class="text-3xl sm:text-4xl font-black text-slate-900 tracking-tight">
      Blog Previsional & Guías Ciudadanas
    </h1>
    <p class="text-slate-600 text-sm sm:text-base mt-2 max-w-3xl leading-relaxed">
      Aprende cómo funciona el Sistema Nacional de Pensiones (SNP) sin jerga incomprensible. Información rigurosa sobre cómo operan las 6 OPCs, cómo se calculan las rentabilidades y cuáles son tus derechos legales.
    </p>
  </section>

  <!-- Artículo Destacado (Hero Card) -->
  {featuredPost && (
    <section class="mb-12">
      <div class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-[#0A2540] via-[#0E355C] to-[#0A2540] p-6 sm:p-10 text-white shadow-lg border border-slate-800">
        <div class="max-w-3xl">
          <div class="flex flex-wrap items-center gap-2.5 mb-4 text-xs font-bold">
            <span class="px-3 py-1 rounded-full bg-amber-400 text-slate-950 uppercase tracking-wider text-[11px] font-black">
              ★ Destacado
            </span>
            <span class="px-3 py-1 rounded-full bg-blue-900/80 border border-blue-400/30 text-blue-200">
              {featuredPost.data.categoryLabel}
            </span>
            <span class="text-slate-300">
              {featuredPost.data.readTimeMinutes} min de lectura
            </span>
          </div>

          <h2 class="text-2xl sm:text-3xl font-black tracking-tight leading-tight">
            <a href={`/blog/${featuredPost.id}`} class="hover:text-blue-200 transition-colors">
              {featuredPost.data.title}
            </a>
          </h2>

          <p class="text-slate-200 text-sm sm:text-base mt-3 leading-relaxed">
            {featuredPost.data.description}
          </p>

          <div class="mt-6 flex flex-wrap items-center gap-4">
            <a
              href={`/blog/${featuredPost.id}`}
              class="px-5 py-2.5 rounded-xl bg-white text-[#0A2540] hover:bg-slate-100 font-extrabold text-xs sm:text-sm transition-all shadow-xs flex items-center gap-2"
            >
              <span>Leer artículo completo</span>
              <span>→</span>
            </a>
            {featuredPost.data.relatedSimulator && (
              <a
                href={featuredPost.data.relatedSimulator}
                class="px-4 py-2.5 rounded-xl bg-blue-950/60 hover:bg-blue-900 border border-blue-400/30 text-blue-200 text-xs font-bold transition-all"
              >
                📊 {featuredPost.data.relatedSimulatorLabel || 'Ver herramienta interactiva'}
              </a>
            )}
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- Barra de Filtros por Categoría y Buscador -->
  <section class="bg-white border border-slate-200/90 rounded-2xl p-4 mb-8 shadow-xs">
    <div class="flex flex-col lg:flex-row items-center justify-between gap-4">
      <!-- Buscador -->
      <div class="relative w-full lg:w-96">
        <input
          id="blog-search"
          type="text"
          placeholder="Buscar artículos (ej. ROP, minusvalía, popular, retiro)..."
          class="w-full bg-slate-50 border border-slate-300 rounded-xl px-4 py-2 pl-9 text-xs text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-[#0A2540] font-medium"
        />
        <svg class="w-4 h-4 text-slate-400 absolute left-3 top-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
        </svg>
      </div>

      <!-- Pestañas de Categoría -->
      <div class="flex items-center gap-1.5 flex-wrap w-full lg:w-auto text-xs">
        {categories.map((cat, i) => (
          <button
            type="button"
            class={`blog-cat-btn px-3 py-1.5 rounded-lg font-semibold transition-all ${
              i === 0
                ? 'bg-[#0A2540] text-white shadow-xs'
                : 'bg-slate-50 text-slate-700 border border-slate-200 hover:bg-slate-100'
            }`}
            data-category={cat.id}
          >
            {cat.label}
          </button>
        ))}
      </div>
    </div>
  </section>

  <!-- Rejilla de Artículos -->
  <section>
    <div id="posts-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {posts.map((post) => (
        <article
          class="post-card bg-white border border-slate-200/90 rounded-2xl p-6 hover:border-slate-300 hover:shadow-md transition-all flex flex-col justify-between shadow-2xs"
          data-category={post.data.category}
          data-search={`${post.data.title} ${post.data.description} ${post.data.tags.join(' ')}`}
        >
          <div>
            <div class="flex items-center justify-between mb-3 text-xs">
              <span class={`px-2.5 py-0.5 rounded-md font-bold text-[11px] border ${getCategoryColor(post.data.category)}`}>
                {post.data.categoryLabel}
              </span>
              <span class="text-slate-400 font-medium">
                {post.data.readTimeMinutes} min
              </span>
            </div>

            <h3 class="text-base font-bold text-slate-900 mb-2 leading-snug group">
              <a href={`/blog/${post.id}`} class="hover:text-[#0A2540] transition-colors">
                {post.data.title}
              </a>
            </h3>

            <p class="text-xs text-slate-600 leading-relaxed mb-4 line-clamp-3">
              {post.data.description}
            </p>
          </div>

          <div class="pt-4 border-t border-slate-100 flex items-center justify-between text-xs">
            <span class="text-slate-400 font-medium">
              {post.data.publishDate.toLocaleDateString('es-CR', { year: 'numeric', month: 'short', day: 'numeric' })}
            </span>
            <a
              href={`/blog/${post.id}`}
              class="font-bold text-[#0A2540] hover:text-blue-700 inline-flex items-center gap-1 group"
            >
              <span>Leer más</span>
              <span class="transition-transform group-hover:translate-x-0.5">→</span>
            </a>
          </div>
        </article>
      ))}
    </div>

    <!-- Mensaje si no hay coincidencias -->
    <div id="no-results" class="hidden text-center py-12 bg-white rounded-2xl border border-slate-200">
      <p class="text-slate-500 text-sm font-medium">No se encontraron artículos con ese criterio de búsqueda.</p>
      <button id="reset-search" type="button" class="mt-3 text-xs font-bold text-[#0A2540] underline">
        Limpiar filtros
      </button>
    </div>
  </section>

  <!-- Banner de Recursos Interactivas -->
  <section class="mt-16 bg-slate-900 rounded-3xl p-6 sm:p-8 text-white border border-slate-800">
    <div class="flex flex-col md:flex-row items-center justify-between gap-6">
      <div>
        <h3 class="text-lg font-black text-white">¿Quieres calcular tu propia pensión?</h3>
        <p class="text-xs text-slate-300 mt-1 max-w-xl">
          Utiliza nuestras herramientas ciudadanas gratuitas con datos oficiales de la SUPEN para proyectar tu ROP y comparar comisiones.
        </p>
      </div>
      <div class="flex flex-wrap items-center gap-3">
        <a href="/simulador" class="px-4 py-2 rounded-xl bg-white text-[#0A2540] hover:bg-slate-100 text-xs font-bold">
          Simulador ROP
        </a>
        <a href="/rendimientos" class="px-4 py-2 rounded-xl bg-blue-900 border border-blue-400/30 text-white hover:bg-blue-800 text-xs font-bold">
          Ranking OPCs
        </a>
        <a href="/glosario" class="px-4 py-2 rounded-xl bg-slate-800 border border-slate-700 text-slate-200 hover:bg-slate-700 text-xs font-bold">
          Glosario
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const searchInput = document.getElementById('blog-search') as HTMLInputElement;
  const cards = document.querySelectorAll('.post-card') as NodeListOf<HTMLElement>;
  const catBtns = document.querySelectorAll('.blog-cat-btn') as NodeListOf<HTMLButtonElement>;
  const noResults = document.getElementById('no-results');
  const resetBtn = document.getElementById('reset-search');

  let currentCategory = 'todas';

  function filterPosts() {
    const q = (searchInput?.value || '').toLowerCase().trim();
    let visibleCount = 0;

    cards.forEach((card) => {
      const cardCat = card.getAttribute('data-category') || '';
      const text = (card.getAttribute('data-search') || '').toLowerCase();

      const matchesCat = currentCategory === 'todas' || cardCat === currentCategory;
      const matchesSearch = !q || text.includes(q);

      if (matchesCat && matchesSearch) {
        card.style.display = '';
        visibleCount++;
      } else {
        card.style.display = 'none';
      }
    });

    if (noResults) {
      noResults.style.display = visibleCount === 0 ? 'block' : 'none';
    }
  }

  searchInput?.addEventListener('input', filterPosts);

  catBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      catBtns.forEach(b => {
        b.classList.remove('bg-[#0A2540]', 'text-white', 'shadow-xs');
        b.classList.add('bg-slate-50', 'text-slate-700', 'border', 'border-slate-200');
      });

      btn.classList.remove('bg-slate-50', 'text-slate-700', 'border', 'border-slate-200');
      btn.classList.add('bg-[#0A2540]', 'text-white', 'shadow-xs');

      currentCategory = btn.getAttribute('data-category') || 'todas';
      filterPosts();
    });
  });

  resetBtn?.addEventListener('click', () => {
    if (searchInput) searchInput.value = '';
    catBtns[0]?.click();
  });
</script>
