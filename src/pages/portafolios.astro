---
import BaseLayout from '../layouts/BaseLayout.astro';
import IsinScreener from '../components/IsinScreener.astro';
import { PORTAFOLIO_MACRO } from '../data/supen-data';
import { formatColones, formatDolares } from '../utils/formatters';
---

<BaseLayout
  title="Portafolios e Inversiones ISIN | SUPEN Costa Rica"
  description="Distribución de inversiones del SNP de Costa Rica: concentración en deuda soberana de Hacienda, activos en el exterior y buscador de títulos ISIN."
>
  <div class="mb-8">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-50 border border-blue-200 text-[#0A2540] text-xs font-bold mb-3">
      <span>🌐 Macro-Estructura de Inversión</span>
      <span>•</span>
      <span>Endpoints /portafolio y /portafolioISIN</span>
    </div>
    <h1 class="text-3xl sm:text-4xl font-black text-slate-900 tracking-tight">
      ¿Dónde está Invertido el Dinero de los Costarricenses?
    </h1>
    <p class="text-slate-600 text-sm mt-2 max-w-3xl leading-relaxed">
      El Sistema Nacional de Pensiones gestiona más de ₡27 billones de colones. Conoce la macro-distribución entre títulos de deuda pública del Gobierno Central, emisiones de bancos locales y vehículos de inversión en el exterior.
    </p>
  </div>

  <!-- Macro Distribución en 4 Categorías -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 mb-10">
    {PORTAFOLIO_MACRO.map((cat) => (
      <div class="bg-white border border-slate-200/90 p-5 rounded-2xl flex flex-col justify-between shadow-xs">
        <div>
          <div class="flex items-center justify-between mb-2">
            <span class="text-xs font-bold text-slate-500 uppercase tracking-wider">Sector</span>
            <span class="text-sm font-black text-[#0A2540] tabular-nums px-2.5 py-0.5 rounded-full bg-blue-50 border border-blue-200">
              {cat.porcentaje}%
            </span>
          </div>
          <h3 class="text-base font-bold text-slate-900 mb-2 leading-snug">
            {cat.categoria}
          </h3>
          <p class="text-xs text-slate-600 leading-relaxed">
            {cat.descripcion}
          </p>
        </div>

        <div class="mt-4 pt-3 border-t border-slate-100 text-xs">
          <span class="text-slate-500 block text-[11px] font-medium">Valor estimado:</span>
          <strong class="text-[#0A2540] font-black tabular-nums block text-sm">
            {formatColones(cat.montoCRC, true)}
          </strong>
          <span class="text-slate-500 text-[11px] tabular-nums font-medium">
            {formatDolares(cat.montoUSD, true)}
          </span>
        </div>
      </div>
    ))}
  </div>

  <!-- Desglose por Moneda & Hito 2029 -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 mb-10">
    <!-- Moneda Dual -->
    <div class="lg:col-span-5 bg-white border border-slate-200/90 p-6 rounded-3xl shadow-sm">
      <span class="text-xs font-bold text-[#0A2540] uppercase tracking-wider block mb-1">Composición Cambiaria</span>
      <h3 class="text-lg font-bold text-slate-900 mb-3">Distribución por Moneda (CRC vs. USD)</h3>

      <div class="space-y-4 text-xs">
        <div>
          <div class="flex justify-between mb-1 font-bold">
            <span class="text-slate-700">Colones Costarricenses (CRC):</span>
            <span class="text-[#0A2540] tabular-nums">~68.5%</span>
          </div>
          <div class="w-full bg-slate-100 h-3 rounded-full overflow-hidden border border-slate-200">
            <div class="bg-blue-600 h-full rounded-full" style="width: 68.5%;"></div>
          </div>
        </div>

        <div>
          <div class="flex justify-between mb-1 font-bold">
            <span class="text-slate-700">Dólares Estadounidenses (USD):</span>
            <span class="text-emerald-800 tabular-nums">~31.5%</span>
          </div>
          <div class="w-full bg-slate-100 h-3 rounded-full overflow-hidden border border-slate-200">
            <div class="bg-emerald-600 h-full rounded-full" style="width: 31.5%;"></div>
          </div>
        </div>

        <p class="text-[11px] text-slate-500 pt-2 border-t border-slate-100 leading-relaxed font-medium">
          Las inversiones en dólares (ETFs globales de EE.UU. y bonos extranjeros) ofrecen cobertura ante devaluaciones del colón, pero generan volatilidad contable transitoria en periodos de apreciación cambiaria.
        </p>
      </div>
    </div>

    <!-- Hito Fondos Generacionales 2029 -->
    <div class="lg:col-span-7 bg-gradient-to-br from-blue-50/70 to-indigo-50/50 border border-blue-200 p-6 rounded-3xl shadow-xs">
      <div class="inline-flex items-center gap-2 px-2.5 py-0.5 rounded-full bg-blue-100 text-[#0A2540] text-[11px] font-bold mb-2">
        <span>🚀 Hito CONASSIF</span>
        <span>•</span>
        <span>Entrada en Vigor: Enero 2029</span>
      </div>
      <h3 class="text-lg font-bold text-slate-900 mb-2">Transición a Fondos Generacionales (Ciclo de Vida)</h3>
      <p class="text-xs text-slate-700 leading-relaxed mb-4">
        Actualmente, un trabajador joven de 22 años y uno a punto de pensionarse a los 64 comparten el mismo fondo único del ROP. En 2029 el fondo se dividirá en 4 portafolios según tu década de nacimiento:
      </p>

      <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 text-xs">
        <div class="bg-white p-3 rounded-xl border border-slate-200 shadow-2xs">
          <strong class="text-blue-900 block font-black">Fondo A</strong>
          <span class="text-slate-500 text-[10px] block font-medium">Nacidos ≤ 1969</span>
          <span class="text-slate-800 text-[11px] mt-1 block font-semibold">Ultraconservador</span>
        </div>
        <div class="bg-white p-3 rounded-xl border border-slate-200 shadow-2xs">
          <strong class="text-sky-900 block font-black">Fondo B</strong>
          <span class="text-slate-500 text-[10px] block font-medium">1970 - 1979</span>
          <span class="text-slate-800 text-[11px] mt-1 block font-semibold">Conservador</span>
        </div>
        <div class="bg-white p-3 rounded-xl border border-slate-200 shadow-2xs">
          <strong class="text-amber-900 block font-black">Fondo C</strong>
          <span class="text-slate-500 text-[10px] block font-medium">1980 - 1989</span>
          <span class="text-slate-800 text-[11px] mt-1 block font-semibold">Crecimiento Moderado</span>
        </div>
        <div class="bg-white p-3 rounded-xl border border-slate-200 shadow-2xs">
          <strong class="text-emerald-900 block font-black">Fondo D</strong>
          <span class="text-slate-500 text-[10px] block font-medium">≥ 1990</span>
          <span class="text-slate-800 text-[11px] mt-1 block font-semibold">Renta Variable Global</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Buscador de Títulos ISIN -->
  <section class="mb-10">
    <IsinScreener />
  </section>
</BaseLayout>
